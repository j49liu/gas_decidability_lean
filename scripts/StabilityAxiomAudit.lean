open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let projectAxioms := env.constants.toList.filterMap fun (name, info) ↦
    if name.toString.startsWith "Stability." || name.toString.startsWith "HGAS." then
      match info with
      | .axiomInfo _ => some name
      | _ => none
    else none
  unless projectAxioms.isEmpty do
    throwError "Project axiom declarations: {projectAxioms}"
  logInfo "Project-namespaced axiom declarations: none"
