import Stability.Computability.RawPolynomialComputability

/-!
# One primitive-recursive grid checker for every dimension

The grid is generated by recursion on the input dimension. Its size may
grow rapidly, but every loop is finite and primitive recursive jointly
in the dimension, the polynomial, and the rational grid resolution.
-/

namespace Stability

open HGAS RawCodePrimrec

attribute [local fun_prop] Primrec Primrec.id Primrec.const Primrec.fst Primrec.snd
attribute [local fun_prop] Primrec.comp Primrec.pair Primrec.list_range
attribute [local fun_prop] natAdd natMul natSub boolAnd boolOr Primrec.not
attribute [local fun_prop] ratAdd ratMul ratPow ratLt listGetD listCons
attribute [local fun_prop] RationalCode.abs_primrec RationalCode.unitFraction_primrec
attribute [local fun_prop] RawPolynomialCode.coefficient_primrec RawPolynomialCode.pderiv_primrec

namespace RawPolynomialCode

@[local fun_prop] theorem evalMonomialCode_primrec :
    Primrec (fun q : ℕ × (RawExponentCode × List RationalCode) ↦
      evalMonomialCode q.1 q.2.1 q.2.2) := by
  unfold evalMonomialCode
  apply listFoldr (h := fun _ t ↦ RationalCode.mul t.1 t.2)
  · apply listMap <;> fun_prop
  · fun_prop
  · fun_prop

@[local fun_prop] theorem evalCode_primrec :
    Primrec (fun q : ℕ × (RawPolynomialCode × List RationalCode) ↦
      evalCode q.1 q.2.1 q.2.2) := by
  unfold evalCode
  apply listFoldr
    (f := fun q : ℕ × (RawPolynomialCode × List RationalCode) ↦ q.2.1)
    (g := fun _ ↦ RationalCode.zero)
    (h := fun (q : ℕ × (RawPolynomialCode × List RationalCode))
      (t : (RawExponentCode × RationalCode) × RationalCode) ↦
        RationalCode.add (RationalCode.mul t.1.2
          (evalMonomialCode q.1 t.1.1 q.2.2)) t.2) <;> fun_prop

@[local fun_prop] theorem cubeAbsBoundCode_primrec : Primrec cubeAbsBoundCode := by
  unfold cubeAbsBoundCode
  apply listFoldr (h := fun _ t ↦ RationalCode.add t.1 t.2)
  · apply listMap
    · apply listDedup.comp
      apply listMap <;> fun_prop
    · fun_prop
  · fun_prop
  · fun_prop

@[local fun_prop] theorem cubeGradientBoundCode_primrec :
    Primrec (fun q : ℕ × RawPolynomialCode ↦ cubeGradientBoundCode q.1 q.2) := by
  unfold cubeGradientBoundCode
  apply listFoldr (h := fun _ t ↦ RationalCode.add t.1 t.2)
  · apply listMap <;> fun_prop
  · fun_prop
  · fun_prop

end RawPolynomialCode

attribute [local fun_prop] RawPolynomialCode.evalCode_primrec
attribute [local fun_prop] RawPolynomialCode.cubeGradientBoundCode_primrec

namespace RawGridCertificate

open ExactGridPositivity

@[local fun_prop] theorem cartesianWords_primrec :
    Primrec (fun q : List ℕ × ℕ ↦ cartesianWords q.1 q.2) := by
  have hstep : Primrec (fun q : List ℕ × (ℕ × List (List ℕ)) ↦
      q.1.flatMap fun a ↦ q.2.2.map fun tail ↦ a :: tail) := by
    apply listFlatMap
    · fun_prop
    · apply listMap <;> fun_prop
  exact (Primrec.nat_rec (Primrec.const [[]]) hstep.to₂).of_eq fun alphabet n ↦ by
    induction n with
    | zero => rfl
    | succ n ih => simp [cartesianWords, ih]

@[local fun_prop] theorem gridIndexPoints_primrec :
    Primrec (fun q : ℕ × ℕ ↦ gridIndexPoints q.1 q.2) := by
  unfold gridIndexPoints
  fun_prop

@[local fun_prop] theorem gridCoordinateCode_primrec :
    Primrec (fun q : ℕ × ℕ ↦ ExactGridPositivity.gridCoordinateCode q.1 q.2) :=
  ExactGridPositivity.gridCoordinateCode_primrec

@[local fun_prop] theorem boundary_primrec :
    Primrec (fun q : ℕ × List ℕ ↦ isBoundaryIndexPoint q.1 q.2) :=
  ExactGridPositivity.isBoundaryIndexPoint_primrec

@[local fun_prop] theorem gridPointCode_primrec :
    Primrec (fun q : ℕ × (ℕ × List ℕ) ↦ gridPointCode q.1 q.2.1 q.2.2) := by
  unfold gridPointCode
  apply listMap <;> fun_prop

@[local fun_prop] theorem marginCode_primrec :
    Primrec (fun q : ℕ × (RawPolynomialCode × ℕ) ↦ marginCode q.1 q.2.1 q.2.2) := by
  unfold marginCode
  fun_prop

@[local fun_prop] theorem checkGridPoint_primrec :
    Primrec (fun q : ℕ × (RawPolynomialCode × (ℕ × List ℕ)) ↦
      checkGridPoint q.1 q.2.1 q.2.2.1 q.2.2.2) := by
  unfold checkGridPoint
  fun_prop

theorem checkStrictPositiveOnSupSphere_primrec :
    Primrec (fun q : ℕ × (RawPolynomialCode × ℕ) ↦
      checkStrictPositiveOnSupSphere q.1 q.2.1 q.2.2) := by
  unfold checkStrictPositiveOnSupSphere
  apply Primrec.and.comp
  · exact (Primrec.nat_lt.comp (Primrec.const 0)
      (Primrec.snd.comp Primrec.snd)).decide
  · apply listAll <;> fun_prop

end RawGridCertificate

end Stability
