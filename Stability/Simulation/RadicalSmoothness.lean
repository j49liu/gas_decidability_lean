import Stability.Simulation.FiniteRadicalFamily
import Stability.Simulation.FormulaSmoothness

/-!
# Smoothness of the generated root graph

Polynomial evaluation preserves smoothness under coordinate substitution,
even when the formal index type is infinite. A root program therefore
depends smoothly on its parameters whenever its radicands stay positive.
For the extracted formula program, the global lower bound one supplies
this positivity without any invariant-region assumption.
-/

namespace Stability.Simulation

noncomputable section

variable {σ : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Coordinatewise smooth substitutions suffice because each polynomial
uses finitely many coordinates. No norm on the full index product is needed. -/
theorem AbsFormula.contDiff_polynomialValue {x : E → σ → ℝ}
    (hx : ∀ i, ContDiff ℝ ⊤ (fun z ↦ x z i)) (p : MvPolynomial σ ℚ) :
    ContDiff ℝ ⊤ (fun z ↦ AbsFormula.polynomialValue (x z) p) := by
  induction p using MvPolynomial.induction_on with
  | C c => simpa [AbsFormula.polynomialValue] using
      (contDiff_const : ContDiff ℝ ⊤ (fun _ : E ↦ (c : ℝ)))
  | add p q hp hq => simpa [AbsFormula.polynomialValue] using hp.add hq
  | mul_X p i hp => simpa [AbsFormula.polynomialValue] using hp.mul (hx i)

/-- Actual sequential evaluation is smooth in every root coordinate. -/
theorem RadicalProgram.contDiff_run (ps : RadicalProgram.Program σ) (start : ℕ)
    (x : E → σ → ℝ) (roots : E → ℕ → ℝ)
    (hx : ∀ i, ContDiff ℝ ⊤ (fun z ↦ x z i))
    (hroots : ∀ i, ContDiff ℝ ⊤ (fun z ↦ roots z i))
    (hpositive : ∀ p ∈ ps, ∀ z r, 0 < RadicalProgram.polynomialValue (x z) r p)
    (i : ℕ) :
    ContDiff ℝ ⊤ (fun z ↦ RadicalProgram.run ps start (x z) (roots z) i) := by
  induction ps generalizing start roots with
  | nil => exact hroots i
  | cons p ps ih =>
      have hvalue : ContDiff ℝ ⊤
          (fun z ↦ RadicalProgram.polynomialValue (x z) (roots z) p) := by
        apply AbsFormula.contDiff_polynomialValue
        intro j
        cases j with
        | inl j => exact hx j
        | inr j => exact hroots j
      have hsqrt := hvalue.sqrt (fun z ↦ ne_of_gt (hpositive p (by simp) z (roots z)))
      have hupdated : ∀ j, ContDiff ℝ ⊤ (fun z ↦ Function.update (roots z) start
          (Real.sqrt (RadicalProgram.polynomialValue (x z) (roots z) p)) j) := by
        intro j
        by_cases hj : j = start
        · subst j
          simpa using hsqrt
        · simpa [Function.update_of_ne hj] using hroots j
      exact ih (start + 1) _ hupdated
        (fun q hq ↦ hpositive q (List.mem_cons_of_mem p hq))

namespace AbsFormula

/-- The finite root graph generated by the compiler is globally smooth. -/
theorem contDiff_finiteRadicalRoots [Fintype σ] (L : MvPolynomial σ ℚ)
    (es : List (AbsFormula σ))
    (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L) :
    ContDiff ℝ ⊤ (finiteRadicalRoots L es) := by
  rw [contDiff_pi]
  intro i
  apply RadicalProgram.contDiff_run
  · intro j
    exact (ContinuousLinearMap.proj j : (σ → ℝ) →L[ℝ] ℝ).contDiff
  · intro j
    exact contDiff_const
  · intro p hp x roots
    exact zero_lt_one.trans_le
      (extractRadicalFamily_radicands_one_le L es 0 x roots (hL x) p hp)

/-- Canonical roots are uniformly separated from zero. -/
theorem one_le_finiteRadicalRoots (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (x : σ → ℝ) (hL : 1 ≤ polynomialValue x L)
    (i : Fin (finiteRadicalFamily L es).rootCount) :
    1 ≤ finiteRadicalRoots L es x i := by
  rw [finiteRadicalRoots_equation L es x i]
  exact Real.one_le_sqrt.mpr
    (finiteRadicalFamily_radicands_one_le L es x (finiteRadicalRoots L es x) hL i)

/-- The fourth-root coordinates used by the polynomial lift. Their squares
are the nonnegative root coordinates from the finite compiler. -/
def finiteLiftRoots (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ)) (x : σ → ℝ) :
    Fin (finiteRadicalFamily L es).rootCount → ℝ :=
  fun i ↦ Real.sqrt (finiteRadicalRoots L es x i)

theorem finiteLiftRoots_sq (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (x : σ → ℝ) (hL : 1 ≤ polynomialValue x L)
    (i : Fin (finiteRadicalFamily L es).rootCount) :
    (finiteLiftRoots L es x i) ^ 2 = finiteRadicalRoots L es x i :=
  Real.sq_sqrt (zero_le_one.trans (one_le_finiteRadicalRoots L es x hL i))

theorem contDiff_finiteLiftRoots [Fintype σ] (L : MvPolynomial σ ℚ)
    (es : List (AbsFormula σ))
    (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L) :
    ContDiff ℝ ⊤ (finiteLiftRoots L es) := by
  rw [contDiff_pi]
  intro i
  apply ((contDiff_pi.mp (contDiff_finiteRadicalRoots L es hL)) i).sqrt
  intro x
  exact ne_of_gt (zero_lt_one.trans_le (one_le_finiteRadicalRoots L es x (hL x) i))

end AbsFormula

end

end Stability.Simulation
