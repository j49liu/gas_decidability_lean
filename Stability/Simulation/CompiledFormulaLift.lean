import Stability.Simulation.TriangularLiftInvariant

/-!
# The rational lift of an actual compiled formula family

Each base coordinate selects a formula from the compiled finite list.
All its radicands, numerators, and denominators are constructed by the
compiler. The resulting rational field is smooth, represents the selected
smoothed formulas on its canonical graph, and preserves exact quartic
constraints along its actual solution segments.
-/

namespace Stability.Simulation.CompiledFormulaLift

noncomputable section

open AbsFormula PolynomialFraction Set

variable {σ : Type*}

/-- The output fraction at a formula's original list position. -/
def outputAt (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ)) (i : Fin es.length) :
    PowerFraction (σ ⊕ Fin (finiteRadicalFamily L es).rootCount) :=
  (finiteRadicalFamily L es).outputs.get
    (i.cast (finiteRadicalFamily_counts L es).2.symm)

theorem outputAt_value (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (x : σ → ℝ) (hL : 0 < polynomialValue x L) (i : Fin es.length) :
    PowerFraction.value (polynomialValue x L) (Sum.elim x (finiteRadicalRoots L es x))
      (outputAt L es i) = smoothEval (polynomialValue x L) x (es.get i) := by
  have hvalues := finiteRadicalFamily_values L es x hL
  have hindex : i.val < (finiteRadicalFamily L es).outputs.length := by
    rw [(finiteRadicalFamily_counts L es).2]
    exact i.isLt
  have hget := congrArg (fun values : List ℝ ↦ values[i.val]?) hvalues
  simpa only [List.getElem?_map, List.getElem?_eq_getElem hindex,
    List.getElem?_eq_getElem i.isLt, Option.map_some, Option.some.injEq] using hget

/-- Replace the selected output's root variables by auxiliary squares. -/
def baseFraction (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ)) (i : Fin es.length) :
    PolynomialFraction (σ ⊕ Fin (finiteRadicalFamily L es).rootCount) :=
  ⟨RadicalProgram.squareRootsPolynomial (outputAt L es i).numerator,
    MvPolynomial.rename Sum.inl L ^ (outputAt L es i).exponent⟩

theorem baseFraction_denominator_one_le (L : MvPolynomial σ ℚ)
    (es : List (AbsFormula σ)) (i : Fin es.length)
    (x : σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ)
    (hL : 1 ≤ polynomialValue (x ∘ Sum.inl) L) :
    1 ≤ polynomialValue x (baseFraction L es i).denominator := by
  change 1 ≤ polynomialValue x (MvPolynomial.rename Sum.inl L ^ _)
  simpa only [polynomialValue, MvPolynomial.eval₂_pow, MvPolynomial.eval₂_rename] using
    one_le_pow₀ hL (n := (outputAt L es i).exponent)

/-- The literal base fraction agrees with its intended smoothed formula
on the graph generated by the actual root evaluator. -/
theorem baseFraction_value_on_graph (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (x : σ → ℝ) (hL : 1 ≤ polynomialValue x L) (i : Fin es.length) :
    value (Sum.elim x (finiteLiftRoots L es x)) (baseFraction L es i) =
      smoothEval (polynomialValue x L) x (es.get i) := by
  have hsquares : (fun j ↦ finiteLiftRoots L es x j ^ 2) = finiteRadicalRoots L es x :=
    funext (finiteLiftRoots_sq L es x hL)
  change polynomialValue (Sum.elim x (finiteLiftRoots L es x))
      (RadicalProgram.squareRootsPolynomial (outputAt L es i).numerator) /
    polynomialValue (Sum.elim x (finiteLiftRoots L es x))
      (MvPolynomial.rename Sum.inl L ^ (outputAt L es i).exponent) = _
  rw [RadicalProgram.squareRootsPolynomial_value, hsquares]
  have hden : polynomialValue (Sum.elim x (finiteLiftRoots L es x))
      (MvPolynomial.rename Sum.inl L ^ (outputAt L es i).exponent) =
        polynomialValue x L ^ (outputAt L es i).exponent := by
    simp [polynomialValue, MvPolynomial.eval₂_rename, Function.comp_def]
  rw [hden]
  exact outputAt_value L es x (zero_lt_one.trans_le hL) i

variable [Fintype σ]

/-- Rational field for the selected base formulas and every generated auxiliary. -/
def field (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) :
    σ ⊕ Fin (finiteRadicalFamily L es).rootCount →
      PolynomialFraction (σ ⊕ Fin (finiteRadicalFamily L es).rootCount) :=
  TriangularLift.field (liftRadicand L es) (fun i ↦ baseFraction L es (component i))

def realize (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) :
    (σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ) →
      σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ :=
  TriangularLift.realize (liftRadicand L es) (fun i ↦ baseFraction L es (component i))

omit [Fintype σ] in
theorem radicand_one_le (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L)
    (y : σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ)
    (j : Fin (finiteRadicalFamily L es).rootCount) :
    1 ≤ polynomialValue y (liftRadicand L es j) := by
  have heq : Sum.elim (y ∘ Sum.inl) (y ∘ Sum.inr) = y := by
    funext i
    cases i <;> rfl
  simpa only [heq] using one_le_liftRadicand L es (y ∘ Sum.inl)
    (hL (y ∘ Sum.inl)) (y ∘ Sum.inr) j

/-- Every denominator bound is discharged from the constructed precision. -/
theorem field_denominator_one_le (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L)
    (y : σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ)
    (i : σ ⊕ Fin (finiteRadicalFamily L es).rootCount) :
    1 ≤ polynomialValue y (field L es component i).denominator :=
  TriangularLift.field_denominator_one_le _ _ y
    (fun j ↦ baseFraction_denominator_one_le L es (component j) y (hL _))
    (radicand_one_le L es hL y) i

theorem contDiff_realize (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L) :
    ContDiff ℝ ⊤ (realize L es component) :=
  TriangularLift.contDiff_realize _ _
    (fun y i ↦ baseFraction_denominator_one_le L es (component i) y (hL _))
    (radicand_one_le L es hL)

/-- Base coordinates of the actual lifted field have the required values. -/
theorem realize_base_on_graph (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) (x : σ → ℝ) (hL : 1 ≤ polynomialValue x L) (i : σ) :
    realize L es component (Sum.elim x (finiteLiftRoots L es x)) (Sum.inl i) =
      smoothEval (polynomialValue x L) x (es.get (component i)) :=
  baseFraction_value_on_graph L es x hL (component i)

/-- Exact constraints persist for the actual compiled field. The only
global coefficient condition is the proved precision lower bound. -/
theorem fourth_eq_of_initial (L : MvPolynomial σ ℚ) (es : List (AbsFormula σ))
    (component : σ → Fin es.length) (hL : ∀ x : σ → ℝ, 1 ≤ polynomialValue x L)
    {a b : ℝ} {x : ℝ → σ ⊕ Fin (finiteRadicalFamily L es).rootCount → ℝ}
    (hx : ContinuousOn x (Icc a b))
    (hcurve : ∀ t ∈ Ioo a b, HasDerivAt x (realize L es component (x t)) t)
    (j : Fin (finiteRadicalFamily L es).rootCount)
    (hinitial : x a (Sum.inr j) ^ 4 = polynomialValue (x a) (liftRadicand L es j))
    {t : ℝ} (ht : t ∈ Icc a b) :
    x t (Sum.inr j) ^ 4 = polynomialValue (x t) (liftRadicand L es j) :=
  TriangularLift.fourth_eq_of_initial _ _ (liftRadicand_dependsBelow L es)
    (fun y i ↦ baseFraction_denominator_one_le L es (component i) y (hL _))
    (radicand_one_le L es hL) hx hcurve j hinitial ht

end

end Stability.Simulation.CompiledFormulaLift
