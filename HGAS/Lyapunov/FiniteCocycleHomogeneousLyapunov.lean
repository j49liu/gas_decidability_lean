import HGAS.Analysis.RadialC1Differential
import HGAS.Dynamics.CocycleLyapunovProfile
import HGAS.Dynamics.C1FlowProfileRegularity
import Mathlib.Tactic

/-!
# A strict homogeneous Lyapunov function from one negative cocycle block

This module assembles the constructive heart of the homogeneous converse
argument.

Let `ϕ` be an ambient flow which, on the unit sphere, is generated by the
angular field

```
Y(x) = F(x) - ⟪x,F(x)⟫ x.
```

Let `a` agree there with the radial reward `⟪x,F(x)⟫`.  For a positive
horizon `T`, define

```
A(t,x) = ∫₀ᵗ a(ϕ(s,x)) ds,
v_T(x) = ∫₀ᵀ exp(2 A(t,x)) dt.
```

The cocycle calculation gives

```
Dv_T(x)[Y(x)] + 2 a(x) v_T(x)
  = exp(2 A(T,x)) - 1.
```

Now extend `v_T` quadratically along rays:

```
V(x) = ‖x‖² v_T(x / ‖x‖).
```

The radial-extension differential contributes exactly
`2 a(x)v_T(x)`, so the two middle terms cancel.  Hence on the sphere

```
DV(x)[F(x)] = exp(2 A(T,x)) - 1.
```

A uniform negative block makes the right-hand side strictly negative.
Positive homogeneity then propagates the inequality along every nonzero
ray.  Positivity of `V` follows directly from positivity of the exponential
integrand.

Regularity of `v_T` is kept as an explicit hypothesis in the assembly
theorem; `Dynamics.C1FlowProfileRegularity` supplies it once smooth
dependence of the angular flow has been established.
-/

namespace HGAS

open Function
open scoped BoundedContinuousFunction RealInnerProductSpace

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E]

/-- A smooth finite-cocycle profile and one uniform negative block produce
a strict degree-two homogeneous `C¹` Lyapunov function. -/
noncomputable def strictHomogeneousC1Lyapunov_of_quadraticCocycleProfile
    (F : E → E) (d : ℕ)
    (hF : ScalesAsDegree ℝ d F)
    (ϕ : Flow ℝ E) (a : E →ᵇ ℝ)
    {T c : ℝ} (hT : 0 < T) (hc : 0 < c)
    (ha :
      ∀ x : E, ‖x‖ = 1 →
        a x = innerRadialReward F x)
    (hflow :
      ∀ x : E, ‖x‖ = 1 →
        HasDerivAt (fun s : ℝ ↦ ϕ s x)
          (innerAngularField F x) 0)
    (hprofile :
      ContDiff ℝ 1
        (Dynamics.quadraticCocycleProfile ϕ a T))
    (hblock :
      ∀ x : E, ‖x‖ = 1 →
        Dynamics.orbitIntegral ϕ a T x ≤ -c) :
    StrictHomogeneousC1Lyapunov F 2 := by
  let v : E → ℝ :=
    Dynamics.quadraticCocycleProfile ϕ a T
  let V : E → ℝ :=
    quadraticRadialExtension v
  have hv : ContDiff ℝ 1 v := by
    simpa only [v] using hprofile
  have hVhomogeneous :
      ∀ (s : ℝ), 0 < s → ∀ x : E,
        V (s • x) = s ^ 2 * V x := by
    intro s hs x
    exact quadraticRadialExtension_twoHomogeneous v s hs x
  have hvSpherePos :
      ∀ u : E, ‖u‖ = 1 → 0 < v u := by
    intro u _hu
    exact Dynamics.quadraticCocycleProfile_pos
      ϕ a hT u
  have hunitDecrease :
      ∀ u : E, ‖u‖ = 1 →
        fderiv ℝ V u (F u) < 0 := by
    intro u hu
    have hgenerator :=
      Dynamics.fderiv_quadraticCocycleProfile_generator
        ϕ a (innerAngularField F) T u
        (hflow u hu)
        (hv.differentiable one_ne_zero u)
    have hradial :=
      fderiv_quadraticRadialExtension_along_field_unit
        v hv F u hu
    have hareward := ha u hu
    rw [hareward] at hgenerator
    have hweightNeg :=
      Dynamics.quadraticCocycleWeight_sub_one_neg_of_negativeBlock
        ϕ a hc u (hblock u hu)
    dsimp only [V]
    dsimp only [v] at hradial hgenerator
    linarith
  refine
    { V := V
      contDiff := contDiff_one_quadraticRadialExtension v hv
      degree_pos := by norm_num
      homogeneous := hVhomogeneous
      positive := ?_
      decreases := ?_ }
  · intro x hx
    exact quadraticRadialExtension_pos_of_unitSphere_pos
      v hvSpherePos hx
  · intro x hx
    let r : ℝ := ‖x‖
    let u : E := normDirection x
    have hr : 0 < r := by
      simpa only [r] using norm_pos_iff.mpr hx
    have hu : ‖u‖ = 1 := by
      simpa only [u] using norm_normDirection hx
    have hxray : r • u = x := by
      simpa only [r, u, normDirection] using
        norm_smul_inv_norm_smul hx
    have hscale :=
      fderiv_along_pos_smul_of_twoHomogeneous
        V hVhomogeneous F d hF r hr u
    rw [hxray] at hscale
    rw [hscale]
    exact mul_neg_of_pos_of_neg
      (pow_pos hr (d + 1))
      (hunitDecrease u hu)

/-- Convenient packaged form: a `C¹` ODE flow whose generator and bounded
observable agree with the angular field and radial reward on the unit sphere
automatically supplies all regularity hypotheses of the preceding
construction. -/
noncomputable def strictHomogeneousC1Lyapunov_of_C1ODEFlow_negativeBlock
    (F : E → E) (d : ℕ)
    (hF : ScalesAsDegree ℝ d F)
    (Φ : Dynamics.C1ODEFlow E)
    (a : E →ᵇ ℝ)
    (haC1 : ContDiff ℝ 1 (a : E → ℝ))
    {T c : ℝ} (hT : 0 < T) (hc : 0 < c)
    (hgenerator :
      ∀ x : E, ‖x‖ = 1 →
        Φ.generator x = innerAngularField F x)
    (hreward :
      ∀ x : E, ‖x‖ = 1 →
        a x = innerRadialReward F x)
    (hblock :
      ∀ x : E, ‖x‖ = 1 →
        Dynamics.orbitIntegral Φ.flow a T x ≤ -c) :
    StrictHomogeneousC1Lyapunov F 2 :=
  strictHomogeneousC1Lyapunov_of_quadraticCocycleProfile
    F d hF Φ.flow a hT hc hreward
    (fun x hx ↦ by
      simpa only [Φ.flow.map_zero_apply, hgenerator x hx] using
        Φ.generatorODE x 0)
    (Φ.contDiff_quadraticCocycleProfile a haC1 T)
    hblock

end

end HGAS
