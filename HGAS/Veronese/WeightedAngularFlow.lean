import HGAS.Dynamics.CompactlySupportedFlow
import HGAS.Veronese.CompactTransverseBounds
import HGAS.Veronese.CubicLiftConjugacy
import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension
import Mathlib.Tactic

/-!
# The flow generated by the weighted angular field

The invariant-measure part of the reduction needs an actual continuous flow
on the compact ellipsoid `Q=1`; pointwise tangency of a formal vector field
is not enough.  This file constructs that flow without assuming a global
growth estimate for the polynomial angular field.

Choose a smooth bump which is one on the norm ball of radius one and
vanishes outside the ball of radius two.  Every point of `Q=1` has norm at
most one, so multiplying the angular field by this bump does not change it
on the ellipsoid.  The cutoff field is compactly supported and `C¹`, hence
has the global continuous flow constructed in
`Dynamics.CompactlySupportedFlow`.

It remains to show that an orbit starting on `Q=1` never leaves it.  Along
the cutoff orbit `γ`, put `z(t)=Q(γ(t))-1`.  Direct differentiation gives

```
z'(t) =
  -2 bump(γ(t)) weightedRadialReward(G,γ(t)) z(t).
```

The scalar uniqueness lemma `eq_zero_of_hasDerivAt_eq_mul_self` therefore
implies `z=0` for all positive and negative times.  We can consequently
restrict the ambient flow to the compact weighted unit sphere, and its
orbits there solve the uncut weighted-angular ODE.
-/

namespace HGAS.Veronese

open Set Filter Function Metric
open scoped Topology NNReal BigOperators

noncomputable section

variable {n k : ℕ}

/-! ## Smoothness and the compact cutoff -/

theorem contDiff_weightedRadialReward
    {G : RealVeroneseSpace n k → RealVeroneseSpace n k}
    (hG : ContDiff ℝ 1 G) :
    ContDiff ℝ 1 (weightedRadialReward G) := by
  unfold weightedRadialReward weightedInner
  fun_prop

theorem contDiff_weightedAngularField
    {G : RealVeroneseSpace n k → RealVeroneseSpace n k}
    (hG : ContDiff ℝ 1 G) :
    ContDiff ℝ 1 (weightedAngularField G) := by
  unfold weightedAngularField
  exact hG.sub
    ((contDiff_weightedRadialReward hG).smul contDiff_id)

/-- A smooth bump equal to one on the ball containing `Q=1`. -/
noncomputable def weightedAngularBump :
    ContDiffBump (0 : RealVeroneseSpace n k) where
  rIn := 1
  rOut := 2
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

/-- The compactly supported extension of the weighted angular field. -/
def cutoffWeightedAngularField
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k) :
    RealVeroneseSpace n k → RealVeroneseSpace n k :=
  fun y ↦
    weightedAngularBump (n := n) (k := k) y •
      weightedAngularField G y

theorem contDiff_cutoffWeightedAngularField
    {G : RealVeroneseSpace n k → RealVeroneseSpace n k}
    (hG : ContDiff ℝ 1 G) :
    ContDiff ℝ 1 (cutoffWeightedAngularField G) := by
  unfold cutoffWeightedAngularField
  exact (weightedAngularBump (n := n) (k := k)).contDiff.smul
    (contDiff_weightedAngularField hG)

theorem hasCompactSupport_cutoffWeightedAngularField
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k) :
    HasCompactSupport (cutoffWeightedAngularField G) := by
  unfold cutoffWeightedAngularField
  exact
    (weightedAngularBump (n := n) (k := k)).hasCompactSupport.smul_right

/-- The cutoff is invisible on the weighted unit sphere. -/
theorem weightedAngularBump_eq_one_of_Q_eq_one
    (y : RealVeroneseSpace n k) (hQ : Q y = 1) :
    weightedAngularBump (n := n) (k := k) y = 1 := by
  apply (weightedAngularBump (n := n) (k := k)).one_of_mem_closedBall
  simpa [Metric.mem_closedBall, dist_zero_right] using
    norm_le_one_of_Q_eq_one y hQ

/-! ## Ambient flow and invariance of `Q=1` -/

/-- The global ambient flow of the cutoff weighted-angular field. -/
noncomputable def weightedAngularFlow
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G) :
    Flow ℝ (RealVeroneseSpace n k) :=
  HGAS.compactlySupportedContDiffFlow
    (cutoffWeightedAngularField G)
    (contDiff_cutoffWeightedAngularField hG)
    (hasCompactSupport_cutoffWeightedAngularField G)

theorem weightedAngularFlow_isIntegralCurve_cutoff
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G)
    (y : RealVeroneseSpace n k) :
    IsIntegralCurve
      (fun t ↦ weightedAngularFlow G hG t y)
      (fun _ ↦ cutoffWeightedAngularField G) :=
  HGAS.compactlySupportedContDiffFlow_isIntegralCurve
    (cutoffWeightedAngularField G)
    (contDiff_cutoffWeightedAngularField hG)
    (hasCompactSupport_cutoffWeightedAngularField G) y

/-- Off the sphere, the failure of the angular field to be tangent is
exactly proportional to `1-Q`. -/
theorem weightedInner_weightedAngularField
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (y : RealVeroneseSpace n k) :
    weightedInner y (weightedAngularField G y) =
      weightedRadialReward G y * (1 - Q y) := by
  rw [weightedAngularField, weightedInner_sub_right,
    weightedInner_smul_right, weightedInner_self,
    weightedRadialReward]
  ring

theorem weightedInner_cutoffWeightedAngularField
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (y : RealVeroneseSpace n k) :
    weightedInner y (cutoffWeightedAngularField G y) =
      weightedAngularBump (n := n) (k := k) y *
        weightedRadialReward G y * (1 - Q y) := by
  rw [cutoffWeightedAngularField, weightedInner_smul_right,
    weightedInner_weightedAngularField]
  ring

/-- The global cutoff flow preserves `Q=1` in both time directions. -/
theorem weightedAngularFlow_preserves_Q
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G)
    (y : RealVeroneseSpace n k) (hy : Q y = 1) :
    ∀ t, Q (weightedAngularFlow G hG t y) = 1 := by
  let γ : ℝ → RealVeroneseSpace n k :=
    fun t ↦ weightedAngularFlow G hG t y
  let z : ℝ → ℝ := fun t ↦ Q (γ t) - 1
  let b : ℝ → ℝ := fun t ↦
    -2 * weightedAngularBump (n := n) (k := k) (γ t) *
      weightedRadialReward G (γ t)
  have hγ :
      IsIntegralCurve γ (fun _ ↦ cutoffWeightedAngularField G) := by
    simpa [γ] using
      weightedAngularFlow_isIntegralCurve_cutoff G hG y
  have hz : ∀ t, HasDerivAt z (b t * z t) t := by
    intro t
    have hQcurve :=
      HasDerivAt.Q_veroneseSpace (hγ t)
    have hsub := hQcurve.sub_const (1 : ℝ)
    convert hsub using 1
    rw [weightedInner_cutoffWeightedAngularField]
    simp only [z, b, γ]
    ring
  have hγcont : Continuous γ :=
    hγ.continuous
  have hb : Continuous b := by
    have hbump :
        Continuous
          (fun t ↦ weightedAngularBump (n := n) (k := k) (γ t)) :=
      (weightedAngularBump (n := n) (k := k)).continuous.comp hγcont
    have hreward :
        Continuous (fun t ↦ weightedRadialReward G (γ t)) :=
      (continuous_weightedRadialReward hG.continuous).comp hγcont
    dsimp [b]
    fun_prop
  have hzzero : z 0 = 0 := by
    simp [z, γ, Flow.map_zero_apply, hy]
  have hall :=
    HGAS.eq_zero_of_hasDerivAt_eq_mul_self z b hz hb hzzero
  intro t
  have := hall t
  dsimp [z, γ] at this
  linarith

theorem isInvariant_weightedUnitSphere_weightedAngularFlow
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G) :
    IsInvariant (weightedAngularFlow G hG) (weightedUnitSphere n k) := by
  intro t y hy
  exact weightedAngularFlow_preserves_Q G hG y hy t

/-- The continuous flow on the compact state space `Q=1`. -/
noncomputable def weightedUnitSphereFlow
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G) :
    Flow ℝ (weightedUnitSphere n k) :=
  (weightedAngularFlow G hG).restrict
    (isInvariant_weightedUnitSphere_weightedAngularFlow G hG)

/-- On an orbit starting at `Q=1`, the cutoff orbit solves the original,
uncut weighted-angular ODE. -/
theorem weightedAngularFlow_isIntegralCurve
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (hG : ContDiff ℝ 1 G)
    (y : RealVeroneseSpace n k) (hy : Q y = 1) :
    IsIntegralCurve
      (fun t ↦ weightedAngularFlow G hG t y)
      (fun _ ↦ weightedAngularField G) := by
  intro t
  have hcut :=
    weightedAngularFlow_isIntegralCurve_cutoff G hG y t
  have hQt := weightedAngularFlow_preserves_Q G hG y hy t
  have hbump :=
    weightedAngularBump_eq_one_of_Q_eq_one
      (weightedAngularFlow G hG t y) hQt
  simpa [cutoffWeightedAngularField, hbump] using hcut

end

end HGAS.Veronese
