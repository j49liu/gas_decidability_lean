import HGAS.Veronese.CompactTransverseBounds
import Mathlib.Data.Nat.Dist
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Topology.Algebra.MvPolynomial
import Mathlib.Tactic

/-!
# Toric-ideal factorization for the canonical cubic lift

The Lie derivative of a quadratic relation along a cubic field is
quartic.  To prove the first-order tangency estimate `|Y_G W| ≤ C W`
without invoking Morse--Bott geometry, it suffices to prove that each
such quartic belongs to the ideal generated by the complete balanced
quadrics.

The combinatorial core is a degree-four fiber theorem.  Four degree-`k`
rows form a `2 × 2` block.  If two blocks have the same total source
exponent, repeatedly exchange one source token between the left and
right pair until their left-pair sums agree.  Each exchange is one
balanced quadratic move.  Two final within-pair moves finish the
reduction.
-/

namespace HGAS.Veronese

open scoped BigOperators

noncomputable section

variable {n k : ℕ}

/-- The ideal generated by the complete family of balanced quadrics. -/
def balancedQuadraticIdeal (n k : ℕ) :
    Ideal (MvPolynomial (MultiIndex n k) ℚ) :=
  Ideal.span (Set.range (toricBinomial :
    ToricRelationIndex n k →
      MvPolynomial (MultiIndex n k) ℚ))

theorem toricBinomial_mem_balancedQuadraticIdeal
    (r : ToricRelationIndex n k) :
    toricBinomial r ∈ balancedQuadraticIdeal n k :=
  Ideal.subset_span (Set.mem_range_self r)

/-- Four degree-`k` rows, grouped as two pairs. -/
structure QuarticRows (n k : ℕ) where
  left : Fin 2 → MultiIndex n k
  right : Fin 2 → MultiIndex n k

/-- Product of the four target variables represented by the rows. -/
def quarticRowsMonomial (A : QuarticRows n k) :
    MvPolynomial (MultiIndex n k) ℚ :=
  (∏ r : Fin 2, MvPolynomial.X (A.left r)) *
    ∏ r : Fin 2, MvPolynomial.X (A.right r)

/-- Source-exponent sum of the left pair. -/
def leftPairSum (A : QuarticRows n k) (j : Fin n) : ℕ :=
  ∑ r : Fin 2, (A.left r).1 j

/-- Source-exponent sum of the right pair. -/
def rightPairSum (A : QuarticRows n k) (j : Fin n) : ℕ :=
  ∑ r : Fin 2, (A.right r).1 j

/-- Total source exponent represented by all four rows. -/
def quarticSourceSum (A : QuarticRows n k) (j : Fin n) : ℕ :=
  leftPairSum A j + rightPairSum A j

/-- Discrepancy between two left-pair source sums. -/
def leftPairDiscrepancy (A B : QuarticRows n k) : ℕ :=
  ∑ j, Nat.dist (leftPairSum A j) (leftPairSum B j)

/-- A balanced relation built directly from an equality of pair sums. -/
def relationOfPairSumEq
    (a b c d : MultiIndex n k)
    (h : ∀ j, a.1 j + b.1 j = c.1 j + d.1 j) :
    ToricRelationIndex n k where
  alpha := a
  beta := b
  gamma := c
  delta := d
  balanced := h

@[simp]
theorem toricBinomial_relationOfPairSumEq
    (a b c d : MultiIndex n k)
    (h : ∀ j, a.1 j + b.1 j = c.1 j + d.1 j) :
    toricBinomial (relationOfPairSumEq a b c d h) =
      MvPolynomial.X a * MvPolynomial.X b -
        MvPolynomial.X c * MvPolynomial.X d :=
  rfl

def leftPairMonomial (A : QuarticRows n k) :
    MvPolynomial (MultiIndex n k) ℚ :=
  ∏ r : Fin 2, MvPolynomial.X (A.left r)

def rightPairMonomial (A : QuarticRows n k) :
    MvPolynomial (MultiIndex n k) ℚ :=
  ∏ r : Fin 2, MvPolynomial.X (A.right r)

theorem quarticRowsMonomial_eq_pairs (A : QuarticRows n k) :
    quarticRowsMonomial A =
      leftPairMonomial A * rightPairMonomial A :=
  rfl

/-- Once the two left-pair sums agree, two direct balanced quadratic
moves connect the quartic monomials. -/
theorem quarticRowsMonomial_sub_mem_of_pairSum_eq
    (A B : QuarticRows n k)
    (hleft : ∀ j, leftPairSum A j = leftPairSum B j)
    (htotal : ∀ j, quarticSourceSum A j = quarticSourceSum B j) :
    quarticRowsMonomial A - quarticRowsMonomial B ∈
      balancedQuadraticIdeal n k := by
  have hleftBal :
      ∀ j,
        (A.left 0).1 j + (A.left 1).1 j =
          (B.left 0).1 j + (B.left 1).1 j := by
    intro j
    simpa only [leftPairSum, Fin.sum_univ_two] using hleft j
  have hright :
      ∀ j, rightPairSum A j = rightPairSum B j := by
    intro j
    have htot := htotal j
    simp only [quarticSourceSum, hleft j] at htot
    omega
  have hrightBal :
      ∀ j,
        (A.right 0).1 j + (A.right 1).1 j =
          (B.right 0).1 j + (B.right 1).1 j := by
    intro j
    simpa only [rightPairSum, Fin.sum_univ_two] using hright j
  let rLeft :=
    relationOfPairSumEq
      (A.left 0) (A.left 1)
      (B.left 0) (B.left 1) hleftBal
  let rRight :=
    relationOfPairSumEq
      (A.right 0) (A.right 1)
      (B.right 0) (B.right 1) hrightBal
  have hqLeft :
      toricBinomial rLeft ∈ balancedQuadraticIdeal n k :=
    toricBinomial_mem_balancedQuadraticIdeal rLeft
  have hqRight :
      toricBinomial rRight ∈ balancedQuadraticIdeal n k :=
    toricBinomial_mem_balancedQuadraticIdeal rRight
  have htermLeft :
      (leftPairMonomial A - leftPairMonomial B) *
          rightPairMonomial A ∈
        balancedQuadraticIdeal n k := by
    have hm :=
      (balancedQuadraticIdeal n k).mul_mem_left
        (rightPairMonomial A) hqLeft
    simpa only [rLeft, toricBinomial_relationOfPairSumEq,
      leftPairMonomial, Fin.prod_univ_two, mul_comm] using hm
  have htermRight :
      leftPairMonomial B *
          (rightPairMonomial A - rightPairMonomial B) ∈
        balancedQuadraticIdeal n k := by
    have hm :=
      (balancedQuadraticIdeal n k).mul_mem_left
        (leftPairMonomial B) hqRight
    simpa only [rRight, toricBinomial_relationOfPairSumEq,
      rightPairMonomial, Fin.prod_univ_two] using hm
  have hadd :=
    (balancedQuadraticIdeal n k).add_mem
      htermLeft htermRight
  convert hadd using 1
  simp only [quarticRowsMonomial_eq_pairs]
  ring

/-! ## The cross-pair exchange step -/

/-- Equal-sum distinct natural vectors have both a surplus and a
deficit coordinate. -/
theorem exists_surplus_deficit_of_sum_eq_of_ne
    (f g : Fin n → ℕ)
    (hsum : ∑ j, f j = ∑ j, g j)
    (hne : f ≠ g) :
    ∃ p q : Fin n, g p < f p ∧ f q < g q := by
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
  rcases lt_or_gt_of_ne hi with hlt | hgt
  · have hsurplus : ∃ p, g p < f p := by
      by_contra hnone
      have hnone' : ∀ p, ¬ g p < f p := not_exists.mp hnone
      have hle : ∀ p, f p ≤ g p := fun p ↦ Nat.le_of_not_gt (hnone' p)
      have hdiff :
          (∑ j, (g j - f j)) + ∑ j, f j = ∑ j, g j := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j _
        have hj := hle j
        omega
      have hpos : 0 < ∑ j, (g j - f j) := by
        exact Finset.sum_pos'
          (fun _ _ ↦ Nat.zero_le _)
          ⟨i, Finset.mem_univ i, by omega⟩
      rw [hsum] at hdiff
      omega
    obtain ⟨p, hp⟩ := hsurplus
    exact ⟨p, i, hp, hlt⟩
  · have hdeficit : ∃ q, f q < g q := by
      by_contra hnone
      have hnone' : ∀ q, ¬ f q < g q := not_exists.mp hnone
      have hle : ∀ q, g q ≤ f q := fun q ↦ Nat.le_of_not_gt (hnone' q)
      have hdiff :
          (∑ j, (f j - g j)) + ∑ j, g j = ∑ j, f j := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j _
        have hj := hle j
        omega
      have hpos : 0 < ∑ j, (f j - g j) := by
        exact Finset.sum_pos'
          (fun _ _ ↦ Nat.zero_le _)
          ⟨i, Finset.mem_univ i, by omega⟩
      rw [hsum] at hdiff
      omega
    obtain ⟨q, hq⟩ := hdeficit
    exact ⟨i, q, hgt, hq⟩

/-- `L¹` discrepancy of two natural vectors. -/
def functionDiscrepancy (f g : Fin n → ℕ) : ℕ :=
  ∑ j, Nat.dist (f j) (g j)

/-- Moving one token from a surplus coordinate to a deficit coordinate
strictly decreases `L¹` discrepancy. -/
theorem functionDiscrepancy_transfer_lt
    (f g : Fin n → ℕ) (p q : Fin n)
    (hp : g p < f p) (hq : f q < g q) :
    functionDiscrepancy (transferFunction f q p) g <
      functionDiscrepancy f g := by
  classical
  have hpq : p ≠ q := by
    intro hpq
    subst q
    omega
  let D : Fin n → ℕ := fun j ↦ Nat.dist (f j) (g j)
  have hpoint :
      (fun j ↦ Nat.dist (transferFunction f q p j) (g j)) =
        Function.update
          (Function.update D p (Nat.dist (f p - 1) (g p)))
          q (Nat.dist (f q + 1) (g q)) := by
    funext j
    by_cases hjq : j = q
    · subst j
      simp [transferFunction, D]
    by_cases hjp : j = p
    · subst j
      simp [transferFunction, D, hpq]
    simp [transferFunction, D, hjq, hjp]
  unfold functionDiscrepancy
  rw [hpoint]
  rw [Finset.sum_update_of_mem (Finset.mem_univ q)]
  have hpmem :
      p ∈ (Finset.univ : Finset (Fin n)) \ {q} := by
    simp [hpq]
  rw [Finset.sum_update_of_mem hpmem]
  have hqDecomp :=
    Finset.sum_eq_add_sum_diff_singleton
      (s := (Finset.univ : Finset (Fin n))) q D (by simp)
  have hpDecomp :=
    Finset.sum_eq_add_sum_diff_singleton
      (s := (Finset.univ : Finset (Fin n)) \ {q})
      p D (by simp [hpq])
  rw [hqDecomp, hpDecomp]
  unfold D Nat.dist
  omega

/-! ## A balanced exchange between the two row pairs -/

/-- Move a source token `p → q` in one left row and simultaneously
move `q → p` in one right row.  The total exponent of the four rows is
unchanged, while the left-pair exponent moves one unit from `p` to
`q`. -/
def crossPairExchange
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q) :
    QuarticRows n k where
  left :=
    Function.update A.left r
      (transferMultiIndex (A.left r) q p hpq.symm hp)
  right :=
    Function.update A.right s
      (transferMultiIndex (A.right s) p q hpq hq)

/-- The balanced quadratic relation implementing `crossPairExchange`. -/
def crossPairExchangeRelation
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q) :
    ToricRelationIndex n k where
  alpha := A.left r
  beta := A.right s
  gamma := transferMultiIndex (A.left r) q p hpq.symm hp
  delta := transferMultiIndex (A.right s) p q hpq hq
  balanced := by
    intro j
    by_cases hjp : j = p
    · subst j
      simp
      omega
    by_cases hjq : j = q
    · subst j
      simp
      omega
    simp [transferMultiIndex_apply_of_ne, hjp, hjq]

@[simp]
theorem toricBinomial_crossPairExchangeRelation
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q) :
    toricBinomial (crossPairExchangeRelation A r s p q hpq hp hq) =
      MvPolynomial.X (A.left r) * MvPolynomial.X (A.right s) -
        MvPolynomial.X
            (transferMultiIndex (A.left r) q p hpq.symm hp) *
          MvPolynomial.X
            (transferMultiIndex (A.right s) p q hpq hq) :=
  rfl

/-- The left-pair sum after a cross exchange is exactly the elementary
transfer of its old sum. -/
theorem leftPairSum_crossPairExchange
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q)
    (j : Fin n) :
    leftPairSum (crossPairExchange A r s p q hpq hp hq) j =
      transferFunction (leftPairSum A) q p j := by
  fin_cases r
  all_goals
    simp only [Fin.zero_eta, Fin.mk_one] at hp
    by_cases hjp : j = p
    · subst j
      simp [crossPairExchange, leftPairSum, Fin.sum_univ_two,
        transferMultiIndex, transferFunction, hpq]
      omega
    by_cases hjq : j = q
    · subst j
      simp [crossPairExchange, leftPairSum, Fin.sum_univ_two,
        transferMultiIndex, transferFunction]
      omega
    simp [crossPairExchange, leftPairSum, Fin.sum_univ_two,
      transferMultiIndex, transferFunction, hjp, hjq]

/-- The right-pair sum changes by the opposite elementary transfer. -/
theorem rightPairSum_crossPairExchange
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q)
    (j : Fin n) :
    rightPairSum (crossPairExchange A r s p q hpq hp hq) j =
      transferFunction (rightPairSum A) p q j := by
  fin_cases s
  all_goals
    simp only [Fin.zero_eta, Fin.mk_one] at hq
    by_cases hjq : j = q
    · subst j
      simp [crossPairExchange, rightPairSum, Fin.sum_univ_two,
        transferMultiIndex, transferFunction, hpq.symm]
      omega
    by_cases hjp : j = p
    · subst j
      simp [crossPairExchange, rightPairSum, Fin.sum_univ_two,
        transferMultiIndex, transferFunction]
      omega
    simp [crossPairExchange, rightPairSum, Fin.sum_univ_two,
      transferMultiIndex, transferFunction, hjp, hjq]

/-- A cross exchange preserves the total source exponent represented
by the four rows. -/
theorem quarticSourceSum_crossPairExchange
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q)
    (j : Fin n) :
    quarticSourceSum (crossPairExchange A r s p q hpq hp hq) j =
      quarticSourceSum A j := by
  have hleft : 0 < leftPairSum A p := by
    exact lt_of_lt_of_le hp
      (Finset.single_le_sum
        (f := fun t : Fin 2 ↦ (A.left t).1 p)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ r))
  have hright : 0 < rightPairSum A q := by
    exact lt_of_lt_of_le hq
      (Finset.single_le_sum
        (f := fun t : Fin 2 ↦ (A.right t).1 q)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s))
  rw [quarticSourceSum, quarticSourceSum,
    leftPairSum_crossPairExchange, rightPairSum_crossPairExchange]
  unfold transferFunction
  by_cases hjp : j = p
  · subst j
    simp [hpq]
    omega
  by_cases hjq : j = q
  · subst j
    simp [hpq.symm]
    omega
  simp [hjp, hjq]

/-- One cross exchange changes the quartic monomial by a generator
times the two untouched variables. -/
theorem quarticRowsMonomial_sub_crossPairExchange_mem
    (A : QuarticRows n k) (r s : Fin 2) (p q : Fin n)
    (hpq : p ≠ q)
    (hp : 0 < (A.left r).1 p)
    (hq : 0 < (A.right s).1 q) :
    quarticRowsMonomial A -
        quarticRowsMonomial
          (crossPairExchange A r s p q hpq hp hq) ∈
      balancedQuadraticIdeal n k := by
  let rel := crossPairExchangeRelation A r s p q hpq hp hq
  have hrel :
      toricBinomial rel ∈ balancedQuadraticIdeal n k :=
    toricBinomial_mem_balancedQuadraticIdeal rel
  let Lrest : MvPolynomial (MultiIndex n k) ℚ :=
    ∏ i ∈ (Finset.univ : Finset (Fin 2)) \ {r},
      MvPolynomial.X (A.left i)
  let Rrest : MvPolynomial (MultiIndex n k) ℚ :=
    ∏ i ∈ (Finset.univ : Finset (Fin 2)) \ {s},
      MvPolynomial.X (A.right i)
  have hleftOld :
      (∏ i : Fin 2, MvPolynomial.X (A.left i)) =
        MvPolynomial.X (A.left r) * Lrest := by
    change
      (∏ i ∈ (Finset.univ : Finset (Fin 2)),
          MvPolynomial.X (R := ℚ) (A.left i)) = _
    rw [Finset.prod_eq_mul_prod_diff_singleton_of_mem
      (Finset.mem_univ r)]
  have hrightOld :
      (∏ i : Fin 2, MvPolynomial.X (A.right i)) =
        MvPolynomial.X (A.right s) * Rrest := by
    change
      (∏ i ∈ (Finset.univ : Finset (Fin 2)),
          MvPolynomial.X (R := ℚ) (A.right i)) = _
    rw [Finset.prod_eq_mul_prod_diff_singleton_of_mem
      (Finset.mem_univ s)]
  have hleftNew :
      (∏ i : Fin 2,
          MvPolynomial.X
            ((crossPairExchange A r s p q hpq hp hq).left i)) =
          MvPolynomial.X
            (transferMultiIndex (A.left r) q p hpq.symm hp) *
          Lrest := by
    simp only [crossPairExchange]
    have hx :
        (fun i : Fin 2 ↦
          MvPolynomial.X (R := ℚ)
            (Function.update A.left r
              (transferMultiIndex (A.left r) q p hpq.symm hp) i)) =
          Function.update
            (fun i ↦ MvPolynomial.X (R := ℚ) (A.left i)) r
            (MvPolynomial.X (R := ℚ)
              (transferMultiIndex (A.left r) q p hpq.symm hp)) := by
      simpa [Function.comp_def] using
        (Function.comp_update
          (MvPolynomial.X (R := ℚ)) A.left r
          (transferMultiIndex (A.left r) q p hpq.symm hp))
    rw [hx]
    change
      (∏ i ∈ (Finset.univ : Finset (Fin 2)),
          Function.update
            (fun i ↦ MvPolynomial.X (R := ℚ) (A.left i)) r
            (MvPolynomial.X (R := ℚ)
              (transferMultiIndex (A.left r) q p hpq.symm hp)) i) = _
    rw [Finset.prod_update_of_mem (Finset.mem_univ r)]
  have hrightNew :
      (∏ i : Fin 2,
          MvPolynomial.X
            ((crossPairExchange A r s p q hpq hp hq).right i)) =
          MvPolynomial.X
            (transferMultiIndex (A.right s) p q hpq hq) *
          Rrest := by
    simp only [crossPairExchange]
    have hx :
        (fun i : Fin 2 ↦
          MvPolynomial.X (R := ℚ)
            (Function.update A.right s
              (transferMultiIndex (A.right s) p q hpq hq) i)) =
          Function.update
            (fun i ↦ MvPolynomial.X (R := ℚ) (A.right i)) s
            (MvPolynomial.X (R := ℚ)
              (transferMultiIndex (A.right s) p q hpq hq)) := by
      simpa [Function.comp_def] using
        (Function.comp_update
          (MvPolynomial.X (R := ℚ)) A.right s
          (transferMultiIndex (A.right s) p q hpq hq))
    rw [hx]
    change
      (∏ i ∈ (Finset.univ : Finset (Fin 2)),
          Function.update
            (fun i ↦ MvPolynomial.X (R := ℚ) (A.right i)) s
            (MvPolynomial.X (R := ℚ)
              (transferMultiIndex (A.right s) p q hpq hq)) i) = _
    rw [Finset.prod_update_of_mem (Finset.mem_univ s)]
  have hfactor :
      quarticRowsMonomial A -
          quarticRowsMonomial
            (crossPairExchange A r s p q hpq hp hq) =
        (Lrest * Rrest) * toricBinomial rel := by
    simp only [quarticRowsMonomial, hleftOld, hrightOld,
      hleftNew, hrightNew, rel,
      toricBinomial_crossPairExchangeRelation]
    ring
  rw [hfactor]
  exact (balancedQuadraticIdeal n k).mul_mem_left (Lrest * Rrest) hrel

/-! ## Connectivity of every quartic Veronese fiber -/

/-- Every left pair represents total source degree `2k`. -/
theorem sum_leftPairSum (A : QuarticRows n k) :
    ∑ j, leftPairSum A j = 2 * k := by
  unfold leftPairSum
  rw [Finset.sum_comm]
  simp only [multiIndex_degree, Fin.sum_univ_two]
  omega

/-- Every right pair represents total source degree `2k`. -/
theorem sum_rightPairSum (A : QuarticRows n k) :
    ∑ j, rightPairSum A j = 2 * k := by
  unfold rightPairSum
  rw [Finset.sum_comm]
  simp only [multiIndex_degree, Fin.sum_univ_two]
  omega

/-- A positive left-pair coordinate occurs in at least one of its two
rows. -/
theorem exists_left_row_apply_pos
    (A : QuarticRows n k) (p : Fin n)
    (h : 0 < leftPairSum A p) :
    ∃ r : Fin 2, 0 < (A.left r).1 p := by
  simp only [leftPairSum, Fin.sum_univ_two] at h
  by_cases hzero : 0 < (A.left 0).1 p
  · exact ⟨0, hzero⟩
  · refine ⟨1, ?_⟩
    omega

/-- A positive right-pair coordinate occurs in at least one of its two
rows. -/
theorem exists_right_row_apply_pos
    (A : QuarticRows n k) (q : Fin n)
    (h : 0 < rightPairSum A q) :
    ∃ s : Fin 2, 0 < (A.right s).1 q := by
  simp only [rightPairSum, Fin.sum_univ_two] at h
  by_cases hzero : 0 < (A.right 0).1 q
  · exact ⟨0, hzero⟩
  · refine ⟨1, ?_⟩
    omega

/-- **Constructive degree-four fiber theorem.**  Any two products of
four degree-`k` Veronese coordinates with the same total source
exponent differ by an element of the ideal generated by the complete
balanced quadrics.

The proof repeatedly moves one token from a surplus coordinate of the
left pair to a deficit coordinate.  The opposite move is made in the
right pair, so the total exponent stays fixed.  The `L¹` discrepancy
strictly decreases.  When it reaches zero, two direct pair relations
finish the reduction. -/
theorem quarticRowsMonomial_sub_mem_of_sourceSum_eq
    (A B : QuarticRows n k)
    (htotal : ∀ j, quarticSourceSum A j = quarticSourceSum B j) :
    quarticRowsMonomial A - quarticRowsMonomial B ∈
      balancedQuadraticIdeal n k := by
  generalize hd : leftPairDiscrepancy A B = d
  induction d using Nat.strong_induction_on generalizing A with
  | h d ih =>
      by_cases hleft :
          ∀ j, leftPairSum A j = leftPairSum B j
      · exact quarticRowsMonomial_sub_mem_of_pairSum_eq
          A B hleft htotal
      · have hne : leftPairSum A ≠ leftPairSum B := by
          intro heq
          apply hleft
          intro j
          exact congrFun heq j
        have hsum :
            ∑ j, leftPairSum A j =
              ∑ j, leftPairSum B j := by
          rw [sum_leftPairSum A, sum_leftPairSum B]
        obtain ⟨p, q, hpSurplus, hqDeficit⟩ :=
          exists_surplus_deficit_of_sum_eq_of_ne
            (leftPairSum A) (leftPairSum B) hsum hne
        have hpPair : 0 < leftPairSum A p := by
          omega
        obtain ⟨r, hpRow⟩ :=
          exists_left_row_apply_pos A p hpPair
        have hqRightSurplus :
            rightPairSum B q < rightPairSum A q := by
          have ht := htotal q
          simp only [quarticSourceSum] at ht
          omega
        have hqPair : 0 < rightPairSum A q := by
          omega
        obtain ⟨s, hqRow⟩ :=
          exists_right_row_apply_pos A q hqPair
        have hpq : p ≠ q := by
          intro hpqEq
          subst q
          omega
        let A' :=
          crossPairExchange A r s p q hpq hpRow hqRow
        have htotal' :
            ∀ j, quarticSourceSum A' j =
              quarticSourceSum B j := by
          intro j
          rw [quarticSourceSum_crossPairExchange]
          exact htotal j
        have hdisc :
            leftPairDiscrepancy A' B <
              leftPairDiscrepancy A B := by
          have hmove :=
            functionDiscrepancy_transfer_lt
              (leftPairSum A) (leftPairSum B)
              p q hpSurplus hqDeficit
          simpa only [leftPairDiscrepancy, functionDiscrepancy,
            A', leftPairSum_crossPairExchange] using hmove
        have hdiscD : leftPairDiscrepancy A' B < d := by
          rw [← hd]
          exact hdisc
        have hrec :
            quarticRowsMonomial A' - quarticRowsMonomial B ∈
              balancedQuadraticIdeal n k :=
          ih (leftPairDiscrepancy A' B) hdiscD A' htotal' rfl
        have hstep :
            quarticRowsMonomial A - quarticRowsMonomial A' ∈
              balancedQuadraticIdeal n k := by
          exact quarticRowsMonomial_sub_crossPairExchange_mem
            A r s p q hpq hpRow hqRow
        have hadd :=
          (balancedQuadraticIdeal n k).add_mem hstep hrec
        convert hadd using 1
        ring

/-! ## A canonical linear quartic lift of source polynomials

The cubic lift was defined coefficientwise in `CubicLiftAlgebra`.  For
the ideal-membership argument it is useful to have the analogous
coefficientwise degree-four lift.  Its only purpose is to provide one
canonical target monomial in each source-exponent fiber. -/

/-- Four degree-`k` blocks whose sum is a prescribed source exponent. -/
structure QuarticFactorization
    {n : ℕ} (k : ℕ) (e : Fin n →₀ ℕ) where
  first : MultiIndex n k
  second : MultiIndex n k
  third : MultiIndex n k
  fourth : MultiIndex n k
  sum_eq :
    ∀ i,
      first.1 i + second.1 i + third.1 i + fourth.1 i = e i

/-- Split the sorted exponent list into four consecutive blocks of
length `k`. -/
noncomputable def quarticFactorization
    (e : Fin n →₀ ℕ)
    (hdegree : Finsupp.degree e = 4 * k) :
    QuarticFactorization k e := by
  let L := exponentList e
  let L₁ := L.drop k
  let L₂ := L₁.drop k
  have hL : L.length = 4 * k := by
    rw [show L.length = Finsupp.degree e by
      exact exponentList_length e]
    exact hdegree
  have hL₁ : L₁.length = 3 * k := by
    simp only [L₁, List.length_drop, hL]
    omega
  have hL₂ : L₂.length = 2 * k := by
    simp only [L₂, List.length_drop, hL₁]
    omega
  have hfirst : (L.take k).length = k := by
    simp only [List.length_take, hL]
    omega
  have hsecond : (L₁.take k).length = k := by
    simp only [List.length_take, hL₁]
    omega
  have hthird : (L₂.take k).length = k := by
    simp only [List.length_take, hL₂]
    omega
  have hfourth : (L₂.drop k).length = k := by
    simp only [List.length_drop, hL₂]
    omega
  refine
    ⟨multiIndexOfList (L.take k) hfirst,
      multiIndexOfList (L₁.take k) hsecond,
      multiIndexOfList (L₂.take k) hthird,
      multiIndexOfList (L₂.drop k) hfourth, ?_⟩
  intro i
  simp only [multiIndexOfList_apply]
  have hdecomp :
      L.take k ++ L₁.take k ++ L₂.take k ++ L₂.drop k = L := by
    calc
      L.take k ++ L₁.take k ++ L₂.take k ++ L₂.drop k =
          L.take k ++
            (L₁.take k ++ (L₂.take k ++ L₂.drop k)) := by
              simp only [List.append_assoc]
      _ = L.take k ++ (L₁.take k ++ L₂) := by
            rw [List.take_append_drop]
      _ = L.take k ++ L₁ := by
            rw [show L₁.take k ++ L₂ = L₁ by
              exact List.take_append_drop k L₁]
      _ = L := by
            exact List.take_append_drop k L
  have hcounts := congrArg (List.count i) hdecomp
  simp only [List.count_append] at hcounts
  rw [hcounts]
  have hsort :
      (↑L : Multiset (Fin n)) = Finsupp.toMultiset e :=
    Multiset.sort_eq (Finsupp.toMultiset e) (· ≤ ·)
  have hcount :=
    congrArg (fun s : Multiset (Fin n) ↦ s.count i) hsort
  change
    Multiset.count i (↑L : Multiset (Fin n)) =
      Multiset.count i (Finsupp.toMultiset e) at hcount
  rw [Multiset.coe_count, Finsupp.count_toMultiset] at hcount
  exact hcount

/-- Regard a four-block factorization as two pairs of rows. -/
def quarticFactorizationRows
    {e : Fin n →₀ ℕ} (f : QuarticFactorization k e) :
    QuarticRows n k where
  left := ![f.first, f.second]
  right := ![f.third, f.fourth]

@[simp]
theorem quarticSourceSum_quarticFactorizationRows
    {e : Fin n →₀ ℕ} (f : QuarticFactorization k e)
    (j : Fin n) :
    quarticSourceSum (quarticFactorizationRows f) j = e j := by
  change
    f.first.1 j + f.second.1 j +
        (f.third.1 j + f.fourth.1 j) = e j
  have h := f.sum_eq j
  omega

/-- The canonical quartic target monomial for a source exponent of
degree `4k`, and zero for exponents of every other degree. -/
noncomputable def quarticLiftMonomial
    (k : ℕ) (e : Fin n →₀ ℕ) :
    MvPolynomial (MultiIndex n k) ℚ :=
  if hdegree : Finsupp.degree e = 4 * k then
    quarticRowsMonomial
      (quarticFactorizationRows (quarticFactorization e hdegree))
  else
    0

/-- The coefficientwise quartic lift, bundled as a rational linear map. -/
noncomputable def quarticLiftLinear (n k : ℕ) :
    MvPolynomial (Fin n) ℚ →ₗ[ℚ]
      MvPolynomial (MultiIndex n k) ℚ :=
  Finsupp.lsum ℚ
    (fun e ↦ LinearMap.toSpanSingleton ℚ
      (MvPolynomial (MultiIndex n k) ℚ)
      (quarticLiftMonomial k e))

@[simp]
theorem quarticLiftLinear_monomial
    (e : Fin n →₀ ℕ) (c : ℚ) :
    quarticLiftLinear n k (MvPolynomial.monomial e c) =
      MvPolynomial.C c * quarticLiftMonomial k e := by
  rw [← MvPolynomial.single_eq_monomial]
  calc
    _ = c • quarticLiftMonomial k e := by
      exact Finsupp.lsum_single ℚ
        (fun e ↦ LinearMap.toSpanSingleton ℚ
          (MvPolynomial (MultiIndex n k) ℚ)
          (quarticLiftMonomial k e)) e c
    _ = _ := MvPolynomial.smul_eq_C_mul _ _

/-- Put one prescribed row in front of a cubic factorization. -/
def prependCubicRows
    {e : Fin n →₀ ℕ}
    (a : MultiIndex n k) (f : CubicFactorization k e) :
    QuarticRows n k where
  left := ![a, f.first]
  right := ![f.second, f.third]

theorem quarticRowsMonomial_prependCubicRows
    {e : Fin n →₀ ℕ}
    (a : MultiIndex n k) (f : CubicFactorization k e) :
    quarticRowsMonomial (prependCubicRows a f) =
      MvPolynomial.X a * cubicCoordinateMonomial f := by
  simp [quarticRowsMonomial, prependCubicRows,
    cubicCoordinateMonomial, Fin.prod_univ_two]
  ring

theorem quarticSourceSum_prependCubicRows
    {e : Fin n →₀ ℕ}
    (a : MultiIndex n k) (f : CubicFactorization k e)
    (j : Fin n) :
    quarticSourceSum (prependCubicRows a f) j =
      (multiIndexFinsupp a + e) j := by
  simp only [quarticSourceSum, leftPairSum, rightPairSum,
    prependCubicRows, Fin.sum_univ_two]
  change
    a.1 j + f.first.1 j + (f.second.1 j + f.third.1 j) =
      (multiIndexFinsupp a + e) j
  simp only [Finsupp.add_apply, multiIndexFinsupp_apply]
  rw [← f.sum_eq j]
  omega

/-- A prescribed row followed by the canonical cubic factorization and
the canonical four-block factorization of the combined source exponent
lie in the same quartic fiber. -/
theorem X_mul_cubicLiftMonomial_sub_quarticLiftMonomial_mem
    (a : MultiIndex n k) (e : Fin n →₀ ℕ)
    (he : Finsupp.degree e = 3 * k) :
    MvPolynomial.X a * cubicLiftMonomial k e -
        quarticLiftMonomial k (multiIndexFinsupp a + e) ∈
      balancedQuadraticIdeal n k := by
  have htotalDegree :
      Finsupp.degree (multiIndexFinsupp a + e) = 4 * k := by
    rw [map_add, multiIndexFinsupp_degree, he]
    omega
  let f₃ := cubicFactorization e he
  let f₄ :=
    quarticFactorization (multiIndexFinsupp a + e) htotalDegree
  have hfiber :
      ∀ j,
        quarticSourceSum (prependCubicRows a f₃) j =
          quarticSourceSum (quarticFactorizationRows f₄) j := by
    intro j
    rw [quarticSourceSum_prependCubicRows,
      quarticSourceSum_quarticFactorizationRows]
  have hmem :=
    quarticRowsMonomial_sub_mem_of_sourceSum_eq
      (prependCubicRows a f₃)
      (quarticFactorizationRows f₄) hfiber
  simpa only [quarticRowsMonomial_prependCubicRows,
    cubicLiftMonomial, dif_pos he,
    quarticLiftMonomial, dif_pos htotalDegree, f₃, f₄] using hmem

/-- Multiplication by a source Veronese monomial shifts every source
exponent in the support expansion by the corresponding multiindex. -/
theorem sourceVeronesePolynomial_mul_eq_sum
    (a : MultiIndex n k) (p : MvPolynomial (Fin n) ℚ) :
    sourceVeronesePolynomial a * p =
      ∑ e ∈ p.support,
        MvPolynomial.monomial (multiIndexFinsupp a + e)
          (p.coeff e) := by
  conv_lhs =>
    rw [← p.support_sum_monomial_coeff]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e _
  simp only [sourceVeronesePolynomial,
    MvPolynomial.monomial_mul, one_mul]

/-- Multiplying the coefficientwise cubic lift by one target variable
agrees modulo the balanced-quadratic ideal with applying the canonical
linear quartic lift after multiplying by the corresponding source
monomial. -/
theorem X_mul_cubicLiftPolynomial_sub_quarticLiftLinear_mem
    (a : MultiIndex n k) (p : MvPolynomial (Fin n) ℚ)
    (hp : p.IsHomogeneous (3 * k)) :
    MvPolynomial.X a * cubicLiftPolynomial k p -
        quarticLiftLinear n k (sourceVeronesePolynomial a * p) ∈
      balancedQuadraticIdeal n k := by
  have hsumMem :
      (∑ e ∈ p.support,
        MvPolynomial.C (p.coeff e) *
          (MvPolynomial.X a * cubicLiftMonomial k e -
            quarticLiftMonomial k (multiIndexFinsupp a + e))) ∈
        balancedQuadraticIdeal n k := by
    apply (balancedQuadraticIdeal n k).sum_mem
    intro e he
    have hdegree :
        Finsupp.degree e = 3 * k :=
      finsuppDegree_eq_of_isHomogeneous hp he
    exact
      (balancedQuadraticIdeal n k).mul_mem_left
        (MvPolynomial.C (p.coeff e))
        (X_mul_cubicLiftMonomial_sub_quarticLiftMonomial_mem
          a e hdegree)
  convert hsumMem using 1
  rw [cubicLiftPolynomial,
    sourceVeronesePolynomial_mul_eq_sum, map_sum]
  simp only [quarticLiftLinear_monomial]
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro e _
  ring

/-! ## The cubic lift preserves the toric ideal to first order -/

/-- Formal Lie derivative of one balanced quadratic along a rational
coordinate field. -/
noncomputable def toricRelationLiePolynomial
    (r : ToricRelationIndex n k)
    (G : RationalCoordinateField (MultiIndex n k)) :
    MvPolynomial (MultiIndex n k) ℚ :=
  G r.alpha * MvPolynomial.X r.beta +
      MvPolynomial.X r.alpha * G r.beta -
    (G r.gamma * MvPolynomial.X r.delta +
      MvPolynomial.X r.gamma * G r.delta)

/-- Evaluation of the formal Lie polynomial is the algebraic
directional differential used in the analytic modules. -/
theorem eval₂Hom_toricRelationLiePolynomial
    {S : Type*} [CommRing S] [Algebra ℚ S]
    (r : ToricRelationIndex n k)
    (G : RationalCoordinateField (MultiIndex n k))
    (y : MultiIndex n k → S) :
    MvPolynomial.eval₂Hom (algebraMap ℚ S) y
        (toricRelationLiePolynomial r G) =
      toricRelationDifferential r y (evalCoordinateField G y) := by
  simp only [toricRelationLiePolynomial, map_sub, map_add, map_mul,
    MvPolynomial.eval₂Hom_X', toricRelationDifferential,
    evalCoordinateField_apply]

/-- Product rule written with the transported source coordinate. -/
theorem sourceVeronese_mul_transported_add
    (F : HGAS.PolynomialField n)
    (a b : MultiIndex n k) :
    sourceVeronesePolynomial b *
          transportedSourcePolynomial F a +
        sourceVeronesePolynomial a *
          transportedSourcePolynomial F b =
      ∑ i,
        MvPolynomial.pderiv i
            (sourceVeronesePolynomial a *
              sourceVeronesePolynomial b) *
          F i := by
  unfold transportedSourcePolynomial
  rw [Finset.mul_sum, Finset.mul_sum,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  rw [MvPolynomial.pderiv_mul]
  ring

/-- Differentiating the exact balanced source-binomial identity gives
the four-term source identity underlying toric tangency. -/
theorem toricSourceTransportedIdentity
    (F : HGAS.PolynomialField n)
    (r : ToricRelationIndex n k) :
    sourceVeronesePolynomial r.beta *
          transportedSourcePolynomial F r.alpha +
        sourceVeronesePolynomial r.alpha *
          transportedSourcePolynomial F r.beta -
      (sourceVeronesePolynomial r.delta *
            transportedSourcePolynomial F r.gamma +
        sourceVeronesePolynomial r.gamma *
            transportedSourcePolynomial F r.delta) = 0 := by
  apply sub_eq_zero.mpr
  rw [sourceVeronese_mul_transported_add,
    sourceVeronese_mul_transported_add,
    sourceVeronesePolynomial_relation r]

/-- The formal Lie derivative of every balanced quadratic along the
canonical cubic lift belongs to the ideal generated by all balanced
quadrics.  This is the exact algebraic strengthening of tangency needed
for the first-order `O(W)` estimate. -/
theorem toricRelationLiePolynomial_cubicLiftField_mem
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k)
    (r : ToricRelationIndex n k) :
    toricRelationLiePolynomial r (cubicLiftField (k := k) F) ∈
      balancedQuadraticIdeal n k := by
  let L := quarticLiftLinear n k
  let T : MultiIndex n k → MvPolynomial (Fin n) ℚ :=
    transportedSourcePolynomial F
  let S : MultiIndex n k → MvPolynomial (Fin n) ℚ :=
    sourceVeronesePolynomial
  have hAlpha :
      MvPolynomial.X r.beta *
            cubicLiftField (k := k) F r.alpha -
          L (S r.beta * T r.alpha) ∈
        balancedQuadraticIdeal n k := by
    exact X_mul_cubicLiftPolynomial_sub_quarticLiftLinear_mem
      r.beta (T r.alpha)
      (transportedSourcePolynomial_isHomogeneous
        F hF hk r.alpha)
  have hBeta :
      MvPolynomial.X r.alpha *
            cubicLiftField (k := k) F r.beta -
          L (S r.alpha * T r.beta) ∈
        balancedQuadraticIdeal n k := by
    exact X_mul_cubicLiftPolynomial_sub_quarticLiftLinear_mem
      r.alpha (T r.beta)
      (transportedSourcePolynomial_isHomogeneous
        F hF hk r.beta)
  have hGamma :
      MvPolynomial.X r.delta *
            cubicLiftField (k := k) F r.gamma -
          L (S r.delta * T r.gamma) ∈
        balancedQuadraticIdeal n k := by
    exact X_mul_cubicLiftPolynomial_sub_quarticLiftLinear_mem
      r.delta (T r.gamma)
      (transportedSourcePolynomial_isHomogeneous
        F hF hk r.gamma)
  have hDelta :
      MvPolynomial.X r.gamma *
            cubicLiftField (k := k) F r.delta -
          L (S r.gamma * T r.delta) ∈
        balancedQuadraticIdeal n k := by
    exact X_mul_cubicLiftPolynomial_sub_quarticLiftLinear_mem
      r.gamma (T r.delta)
      (transportedSourcePolynomial_isHomogeneous
        F hF hk r.delta)
  have hall :=
    (balancedQuadraticIdeal n k).sub_mem
      ((balancedQuadraticIdeal n k).add_mem hAlpha hBeta)
      ((balancedQuadraticIdeal n k).add_mem hGamma hDelta)
  have hsource :
      S r.beta * T r.alpha + S r.alpha * T r.beta -
          (S r.delta * T r.gamma + S r.gamma * T r.delta) = 0 := by
    exact toricSourceTransportedIdentity F r
  have hlinear :
      L (S r.beta * T r.alpha) +
            L (S r.alpha * T r.beta) -
          (L (S r.delta * T r.gamma) +
            L (S r.gamma * T r.delta)) = 0 := by
    rw [← map_add, ← map_add, ← map_sub, hsource, map_zero]
  have heq :
      ((MvPolynomial.X r.beta *
              cubicLiftField (k := k) F r.alpha -
            L (S r.beta * T r.alpha)) +
          (MvPolynomial.X r.alpha *
              cubicLiftField (k := k) F r.beta -
            L (S r.alpha * T r.beta))) -
        ((MvPolynomial.X r.delta *
              cubicLiftField (k := k) F r.gamma -
            L (S r.delta * T r.gamma)) +
          (MvPolynomial.X r.gamma *
              cubicLiftField (k := k) F r.delta -
            L (S r.gamma * T r.delta))) =
        toricRelationLiePolynomial r
          (cubicLiftField (k := k) F) := by
    unfold toricRelationLiePolynomial
    linear_combination -hlinear
  rw [← heq]
  exact hall

/-! ## Explicit finite coefficients and the `O(W)` estimate -/

/-- Ideal membership gives a finite polynomial coefficient family,
because the complete relation type is finite. -/
theorem exists_cubicLift_relationFactorizationPolynomial
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k) :
    ∃ coeff :
        ToricRelationIndex n k → ToricRelationIndex n k →
          MvPolynomial (MultiIndex n k) ℚ,
      ∀ r,
        toricRelationLiePolynomial r
            (cubicLiftField (k := k) F) =
          ∑ s, coeff r s * toricBinomial s := by
  classical
  have hex :
      ∀ r : ToricRelationIndex n k,
        ∃ c : ToricRelationIndex n k →
            MvPolynomial (MultiIndex n k) ℚ,
          ∑ s, c s * toricBinomial s =
            toricRelationLiePolynomial r
              (cubicLiftField (k := k) F) := by
    intro r
    have hmem :=
      toricRelationLiePolynomial_cubicLiftField_mem F hF hk r
    rw [balancedQuadraticIdeal] at hmem
    exact
      Ideal.mem_span_range_iff_exists_fun.mp hmem
  choose coeff hcoeff using hex
  exact ⟨coeff, fun r ↦ (hcoeff r).symm⟩

/-- Evaluation of a rational target polynomial on real coordinates is
continuous. -/
theorem continuous_eval₂Hom_rational_real
    (p : MvPolynomial (MultiIndex n k) ℚ) :
    Continuous
      (fun y : RealVeroneseSpace n k ↦
        MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) y p) := by
  have h :=
    MvPolynomial.continuous_eval
      ((MvPolynomial.map (algebraMap ℚ ℝ)) p)
  simpa only [MvPolynomial.eval_map] using h

/-- Evaluation of a rational coordinate field gives a continuous real
field. -/
theorem continuous_evalCoordinateField_real
    (G : RationalCoordinateField (MultiIndex n k)) :
    Continuous
      (fun y : RealVeroneseSpace n k ↦
        evalCoordinateField G y) := by
  apply continuous_pi
  intro a
  exact continuous_eval₂Hom_rational_real (G a)

/-- Evaluating the polynomial coefficients gives the exact pointwise
factorization required by the compact transverse-bound theorem. -/
theorem exists_cubicLift_relationFactorizationReal
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k) :
    ∃ coeff :
        ToricRelationIndex n k → ToricRelationIndex n k →
          RealVeroneseSpace n k → ℝ,
      (∀ r s, Continuous (coeff r s)) ∧
      ∀ r y,
        toricRelationDifferential r y
            (evalCoordinateField
              (cubicLiftField (k := k) F) y) =
          ∑ s, coeff r s y * toricRelation s y := by
  obtain ⟨coeffPoly, hpoly⟩ :=
    exists_cubicLift_relationFactorizationPolynomial F hF hk
  let coeff :
      ToricRelationIndex n k → ToricRelationIndex n k →
        RealVeroneseSpace n k → ℝ :=
    fun r s y ↦
      MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) y
        (coeffPoly r s)
  refine ⟨coeff, ?_, ?_⟩
  · intro r s
    exact continuous_eval₂Hom_rational_real (coeffPoly r s)
  · intro r y
    have heval :=
      congrArg
        (MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) y)
        (hpoly r)
    simpa only [eval₂Hom_toricRelationLiePolynomial,
      map_sum, map_mul, eval₂Hom_toricBinomial, coeff] using heval

/-- The canonical cubic lift has a uniform first-order tangency bound
on the weighted unit sphere. -/
theorem exists_cubicLift_penaltyLieDerivative_linear_bound
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ y : RealVeroneseSpace n k,
        Q y = 1 →
          |penaltyLieDerivative
              (fun z ↦ evalCoordinateField
                (cubicLiftField (k := k) F) z) y| ≤
            C * completeToricEnergy y := by
  obtain ⟨coeff, hcoeff, hfactor⟩ :=
    exists_cubicLift_relationFactorizationReal F hF hk
  exact
    exists_penaltyLieDerivative_linear_bound_of_factorization
      coeff hcoeff hfactor

/-! The sphere dynamics uses the weighted angular field rather than the
raw ambient cubic field.  Removing the radial component only subtracts
`2 a(y) q_r(y)` from the derivative of the quadratic relation `q_r`.
Thus the exact factorization survives after modifying one diagonal
coefficient. -/

theorem toricRelationDifferential_weightedAngularField
    (r : ToricRelationIndex n k)
    (G : RealVeroneseSpace n k → RealVeroneseSpace n k)
    (y : RealVeroneseSpace n k) :
    toricRelationDifferential r y (weightedAngularField G y) =
      toricRelationDifferential r y (G y) -
        2 * weightedRadialReward G y * toricRelation r y := by
  simp only [weightedAngularField, toricRelationDifferential,
    toricRelation, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- Exact finite relation factorization for the angular part of the
canonical cubic lift. -/
theorem exists_cubicLift_angularRelationFactorizationReal
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k) :
    let G : RealVeroneseSpace n k → RealVeroneseSpace n k :=
      fun y ↦ evalCoordinateField
        (cubicLiftField (k := k) F) y
    ∃ coeff :
        ToricRelationIndex n k → ToricRelationIndex n k →
          RealVeroneseSpace n k → ℝ,
      (∀ r s, Continuous (coeff r s)) ∧
      ∀ r y,
        toricRelationDifferential r y
            (weightedAngularField G y) =
          ∑ s, coeff r s y * toricRelation s y := by
  dsimp only
  let G : RealVeroneseSpace n k → RealVeroneseSpace n k :=
    fun y ↦ evalCoordinateField
      (cubicLiftField (k := k) F) y
  obtain ⟨rawCoeff, hrawContinuous, hrawFactor⟩ :=
    exists_cubicLift_relationFactorizationReal F hF hk
  let coeff :
      ToricRelationIndex n k → ToricRelationIndex n k →
        RealVeroneseSpace n k → ℝ :=
    fun r s y ↦
      rawCoeff r s y -
        if s = r then 2 * weightedRadialReward G y else 0
  have hG : Continuous G :=
    continuous_evalCoordinateField_real
      (cubicLiftField (k := k) F)
  refine ⟨coeff, ?_, ?_⟩
  · intro r s
    by_cases hsr : s = r
    · subst s
      simp only [coeff, if_pos]
      exact (hrawContinuous r r).sub
        (continuous_const.mul
          (continuous_weightedRadialReward hG))
    · simp only [coeff, if_neg hsr, sub_zero]
      exact hrawContinuous r s
  · intro r y
    rw [toricRelationDifferential_weightedAngularField,
      hrawFactor]
    calc
      (∑ s, rawCoeff r s y * toricRelation s y) -
          2 * weightedRadialReward G y * toricRelation r y =
        (∑ s, rawCoeff r s y * toricRelation s y) -
          ∑ s,
            (if s = r then
              2 * weightedRadialReward G y else 0) *
              toricRelation s y := by
                simp
      _ =
        ∑ s,
          (rawCoeff r s y -
              if s = r then
                2 * weightedRadialReward G y else 0) *
            toricRelation s y := by
              rw [← Finset.sum_sub_distrib]
              apply Finset.sum_congr rfl
              intro s _
              ring
      _ = ∑ s, coeff r s y * toricRelation s y := rfl

/-- Consequently the angular cubic lift satisfies the uniform
first-order estimate used by transverse stabilization. -/
theorem exists_cubicLift_angularPenaltyLieDerivative_linear_bound
    (F : HGAS.PolynomialField n)
    (hF : HGAS.IsHomogeneousOfDegree (2 * k + 1) F)
    (hk : 1 ≤ k) :
    let G : RealVeroneseSpace n k → RealVeroneseSpace n k :=
      fun y ↦ evalCoordinateField
        (cubicLiftField (k := k) F) y
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ y : RealVeroneseSpace n k,
        Q y = 1 →
          |penaltyLieDerivative (weightedAngularField G) y| ≤
            C * completeToricEnergy y := by
  dsimp only
  obtain ⟨coeff, hcoeff, hfactor⟩ :=
    exists_cubicLift_angularRelationFactorizationReal F hF hk
  exact
    exists_penaltyLieDerivative_linear_bound_of_factorization
      coeff hcoeff hfactor

end

end HGAS.Veronese
