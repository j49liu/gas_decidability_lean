import HGAS.Dynamics.BoundedLipschitzFlow
import Mathlib.Analysis.Calculus.ContDiff.RCLike
import Mathlib.Analysis.Calculus.Deriv.MeanValue
import Mathlib.Tactic

/-!
# Flows of compactly supported `C¹` vector fields

A compactly supported continuously differentiable vector field on a
finite-dimensional real normed space is globally Lipschitz and bounded.
This module packages those two standard consequences, and then applies
`boundedLipschitzFlow` to obtain its global continuous flow.

Keeping the quantitative witnesses in a small structure avoids repeating
the same classical-choice plumbing in every cutoff construction.
-/

namespace HGAS

open Set
open scoped NNReal Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [CompleteSpace E]

/-- Explicit Lipschitz and boundedness witnesses for a vector field. -/
structure BoundedLipschitzData (f : E → E) where
  lipschitzConstant : ℝ≥0
  normBound : ℝ≥0
  lipschitz : LipschitzWith lipschitzConstant f
  norm_le : ∀ x, ‖f x‖ ≤ normBound

/-- A compactly supported `C¹` field has bounded-Lipschitz data.

The real bound supplied by compactness is replaced by its maximum with
zero so that it can be stored as an `NNReal`. -/
noncomputable def boundedLipschitzDataOfCompactSupport
    (f : E → E) (hf : ContDiff ℝ 1 f)
    (hsupport : HasCompactSupport f) :
    BoundedLipschitzData f := by
  let hexK :=
    ContDiff.lipschitzWith_of_hasCompactSupport
      hsupport hf one_ne_zero
  let K : ℝ≥0 := Classical.choose hexK
  have hK : LipschitzWith K f :=
    Classical.choose_spec hexK
  let hexB : ∃ B : ℝ, ∀ x, ‖f x‖ ≤ B :=
    HasCompactSupport.exists_bound_of_continuous
      hsupport hf.continuous
  let B : ℝ := Classical.choose hexB
  have hB : ∀ x, ‖f x‖ ≤ B :=
    Classical.choose_spec hexB
  let L : ℝ≥0 := ⟨max B 0, le_max_right B 0⟩
  refine
    { lipschitzConstant := K
      normBound := L
      lipschitz := hK
      norm_le := ?_ }
  intro x
  exact (hB x).trans (by
    change B ≤ max B 0
    exact le_max_left _ _)

/-- The global flow generated by a compactly supported `C¹` vector field. -/
noncomputable def compactlySupportedContDiffFlow
    (f : E → E) (hf : ContDiff ℝ 1 f)
    (hsupport : HasCompactSupport f) :
    Flow ℝ E :=
  let data :=
    boundedLipschitzDataOfCompactSupport f hf hsupport
  boundedLipschitzFlow f data.lipschitz data.norm_le

omit [FiniteDimensional ℝ E] in
@[simp]
theorem compactlySupportedContDiffFlow_apply
    (f : E → E) (hf : ContDiff ℝ 1 f)
    (hsupport : HasCompactSupport f) (t : ℝ) (x : E) :
    compactlySupportedContDiffFlow f hf hsupport t x =
      globalCurve f
        (boundedLipschitzDataOfCompactSupport f hf hsupport).lipschitz
        (boundedLipschitzDataOfCompactSupport f hf hsupport).norm_le
        x t :=
  rfl

omit [FiniteDimensional ℝ E] in
/-- Every orbit of `compactlySupportedContDiffFlow` solves the original
autonomous ODE. -/
theorem compactlySupportedContDiffFlow_isIntegralCurve
    (f : E → E) (hf : ContDiff ℝ 1 f)
    (hsupport : HasCompactSupport f) (x : E) :
    IsIntegralCurve
      (fun t ↦ compactlySupportedContDiffFlow f hf hsupport t x)
      (fun _ ↦ f) :=
  boundedLipschitzFlow_isIntegralCurve f
    (boundedLipschitzDataOfCompactSupport f hf hsupport).lipschitz
    (boundedLipschitzDataOfCompactSupport f hf hsupport).norm_le x

end

end HGAS
