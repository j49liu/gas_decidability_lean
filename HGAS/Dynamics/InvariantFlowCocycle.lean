import HGAS.Dynamics.InvariantSkewDrift
import Mathlib.MeasureTheory.Integral.Prod
import Mathlib.MeasureTheory.Integral.DominatedConvergence
import Mathlib.Tactic

/-!
# Time-integrated cocycles over invariant flows

Let `ϕ` be a continuous real flow and let `g` be a bounded continuous
observable.  Its time-one cocycle is

```
                  Δg(x) = ∫ t in 0..1, g(ϕ t x).
```

This file packages `Δg` as a bounded continuous function and proves that an
invariant probability gives `Δg` exactly the same mean as `g`.  Combining
that identity with `InvariantSkewDrift` gives the elementary, non-ergodic
form of the affine-accumulator obstruction:

```
        z(ϕ 1 x) - z(x) = Δg(x)   implies   ∫ g dμ = 0.
```

Thus a stationary finite affine lift cannot exist over a base with nonzero
mean drift.  No pointwise ergodic theorem, recurrence theorem, or
integrability assumption on `z` is needed.
-/

noncomputable section

open Filter Function MeasureTheory Set Topology
open scoped BoundedContinuousFunction Interval

namespace HGAS.Dynamics

variable {X : Type*} [TopologicalSpace X]

/-- The time-one integral of a bounded continuous observable along a
continuous real flow, again packaged as a bounded continuous observable. -/
def oneStepFlowIntegral
    (ϕ : Flow ℝ X) (g : X →ᵇ ℝ) :
    X →ᵇ ℝ := by
  let integrand : X → ℝ → ℝ :=
    fun x t ↦ g (ϕ t x)
  have hintegrand :
      Continuous (Function.uncurry integrand) := by
    exact g.continuous.comp
      (ϕ.continuous continuous_snd continuous_fst)
  let f : C(X, ℝ) :=
    ⟨fun x ↦ ∫ t in (0 : ℝ)..1, integrand x t,
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        hintegrand
        0 1⟩
  have hnorm : ∀ x : X, ‖f x‖ ≤ ‖g‖ := by
    intro x
    apply (intervalIntegral.norm_integral_le_of_norm_le_const
      (fun t _ ↦ g.norm_coe_le_norm (ϕ t x))).trans_eq
    norm_num
  exact BoundedContinuousFunction.mkOfBound f (2 * ‖g‖) (by
    intro x y
    rw [Real.dist_eq]
    exact (abs_sub (f x) (f y)).trans
      ((add_le_add (hnorm x) (hnorm y)).trans_eq (by ring)))

@[simp]
theorem oneStepFlowIntegral_apply
    (ϕ : Flow ℝ X) (g : X →ᵇ ℝ) (x : X) :
    oneStepFlowIntegral ϕ g x =
      ∫ t in (0 : ℝ)..1, g (ϕ t x) :=
  rfl

/-- The time-one cocycle and its generating observable have the same mean
under every invariant probability. -/
theorem InvariantProbabilityMeasure.integral_oneStepFlowIntegral
    [MeasurableSpace X] [BorelSpace X]
    {ϕ : Flow ℝ X}
    (μ : InvariantProbabilityMeasure ϕ)
    (g : X →ᵇ ℝ) :
    (∫ x, oneStepFlowIntegral ϕ g x
        ∂(μ.measure : Measure X)) =
      ∫ x, g x ∂(μ.measure : Measure X) := by
  let G : (ℝ × X) →ᵇ ℝ :=
    g.compContinuous
      ⟨fun p ↦ ϕ p.1 p.2, ϕ.continuous continuous_fst continuous_snd⟩
  letI :
      IsFiniteMeasure
        (volume.restrict (Set.uIoc (0 : ℝ) 1)) :=
    ⟨by simp [Set.uIoc_of_le]⟩
  have hG :
      Integrable
        (Function.uncurry (fun t x ↦ g (ϕ t x)))
        ((volume.restrict (Set.uIoc (0 : ℝ) 1)).prod
          (μ.measure : Measure X)) := by
    simpa only [G, BoundedContinuousFunction.compContinuous_apply,
      ContinuousMap.coe_mk, Function.uncurry_apply_pair] using
        G.integrable
          ((volume.restrict (Set.uIoc (0 : ℝ) 1)).prod
            (μ.measure : Measure X))
  rw [show
    (∫ x, oneStepFlowIntegral ϕ g x
        ∂(μ.measure : Measure X)) =
      ∫ x, (∫ t in (0 : ℝ)..1, g (ϕ t x))
        ∂(μ.measure : Measure X) by rfl]
  rw [← intervalIntegral_integral_swap hG]
  simp_rw [μ.integral_comp_time]
  simp

/-- **Stationary affine-cocycle obstruction.**

If a continuous real coordinate has derivative cocycle generated by `g`,
then every invariant probability has zero mean `g`.  The coordinate may be
unbounded and need not be integrable. -/
theorem InvariantProbabilityMeasure.integral_eq_zero_of_flowIntegral_increment
    [MeasurableSpace X] [BorelSpace X]
    {ϕ : Flow ℝ X}
    (μ : InvariantProbabilityMeasure ϕ)
    (z : X → ℝ) (hz : Continuous z)
    (g : X →ᵇ ℝ)
    (hincrement :
      ∀ x, z (ϕ 1 x) - z x = oneStepFlowIntegral ϕ g x) :
    (∫ x, g x ∂(μ.measure : Measure X)) = 0 := by
  rw [← μ.integral_oneStepFlowIntegral g]
  exact μ.observableAverage_increment_eq_zero
    z hz (oneStepFlowIntegral ϕ g) hincrement

/-- Coordinatewise finite-dimensional version of the stationary
affine-cocycle obstruction.  This is the form needed for the paper's
one-sphere vector accumulator. -/
theorem InvariantProbabilityMeasure.coordinateIntegral_eq_zero_of_flowIntegral_increment
    [MeasurableSpace X] [BorelSpace X]
    {m : ℕ} {ϕ : Flow ℝ X}
    (μ : InvariantProbabilityMeasure ϕ)
    (z : X → (Fin m → ℝ)) (hz : Continuous z)
    (g : X →ᵇ (Fin m → ℝ))
    (hincrement :
      ∀ x i,
        z (ϕ 1 x) i - z x i =
          ∫ t in (0 : ℝ)..1, g (ϕ t x) i) :
    ∀ i : Fin m,
      (∫ x, g x i ∂(μ.measure : Measure X)) = 0 := by
  intro i
  let gi : X →ᵇ ℝ :=
    (ContinuousLinearMap.proj i :
      (Fin m → ℝ) →L[ℝ] ℝ).compLeftContinuousBounded X g
  apply μ.integral_eq_zero_of_flowIntegral_increment
    (fun x ↦ z x i) ((continuous_apply i).comp hz) gi
  intro x
  simpa only [oneStepFlowIntegral_apply,
    ContinuousLinearMap.compLeftContinuousBounded_apply,
    ContinuousLinearMap.proj_apply] using hincrement x i

end HGAS.Dynamics

end
