import HGAS.Dynamics.TimeAverages
import Mathlib.Analysis.SpecialFunctions.Complex.Circle
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
import Mathlib.Tactic

/-!
# Continuous circle skew products generated by orbit integrals

Let `ϕ` be a continuous real flow on a space `K`, and let
`a i : K → ℝ` be a finite or infinite family of bounded continuous angular
velocities.  The accumulated angle

```text
                    Aᵢ(t,x) = ∫₀ᵗ aᵢ(ϕₛx) ds
```

is an additive cocycle.  Consequently

```text
       (x,z) ↦ (ϕₜx, (exp(i Aᵢ(t,x)) zᵢ)ᵢ)
```

is a continuous flow on `K × (d → Circle)`.

The construction is reusable: the controller clocks are one application,
but any continuous compact-base angular skew product can use the same
module.  We also record joint continuity of the orbit integral and the
literal differential equation followed by each physical circle
coordinate.
-/

noncomputable section

open Complex Function
open scoped BoundedContinuousFunction Interval

namespace HGAS.Dynamics.ContinuousPhaseSkewFlow

variable {K d : Type*} [TopologicalSpace K]

/-- The orbit integral is jointly continuous in terminal time and initial
state.  `TimeAverages.continuous_orbitIntegral` is the fixed-time version;
the moving-endpoint form here is what is needed to build a skew-product
flow. -/
theorem continuous_orbitIntegral_joint
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ) :
    Continuous
      (fun q : ℝ × K ↦
        orbitIntegral ϕ a q.1 q.2) := by
  unfold orbitIntegral
  apply
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
      (a₀ := (0 : ℝ))
  · exact a.continuous.comp
      (ϕ.continuous continuous_snd
        (continuous_snd.comp continuous_fst))
  · exact continuous_fst

/-- Continuous physical-circle skew flow generated by the family of angular
velocities `a`. -/
def phaseSkewFlow
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ) :
    Flow ℝ (K × (d → Circle)) where
  toFun t z :=
    (ϕ t z.1,
      fun i ↦
        Circle.exp (orbitIntegral ϕ (a i) t z.1) * z.2 i)
  cont' := by
    apply Continuous.prodMk
    · exact ϕ.continuous continuous_fst
        (continuous_fst.comp continuous_snd)
    · apply continuous_pi
      intro i
      apply Continuous.mul
      · exact Circle.exp.continuous.comp
          ((continuous_orbitIntegral_joint ϕ (a i)).comp
            (continuous_fst.prodMk
              (continuous_fst.comp continuous_snd)))
      · exact (continuous_apply i).comp
          (continuous_snd.comp continuous_snd)
  map_add' := by
    intro t u z
    apply Prod.ext
    · exact ϕ.map_add t u z.1
    · funext i
      simp only
      rw [add_comm t u, orbitIntegral_add, Circle.exp_add]
      simp only [mul_assoc]
      ac_rfl
  map_zero' := by
    intro z
    apply Prod.ext
    · exact ϕ.map_zero_apply z.1
    · funext i
      simp [orbitIntegral_zero]

@[simp]
theorem phaseSkewFlow_base
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ)
    (t : ℝ) (z : K × (d → Circle)) :
    (phaseSkewFlow ϕ a t z).1 = ϕ t z.1 :=
  rfl

@[simp]
theorem phaseSkewFlow_phase
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ)
    (t : ℝ) (z : K × (d → Circle)) (i : d) :
    (phaseSkewFlow ϕ a t z).2 i =
      Circle.exp (orbitIntegral ϕ (a i) t z.1) * z.2 i :=
  rfl

/-! ## Restriction to a fixed base point -/

/-- At a fixed point of the base flow, an orbit integral is simply time
times the value of its generator. -/
theorem orbitIntegral_of_fixed
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    {x : K}
    (hx : InvariantProbabilityMeasure.IsFlowFixedPoint ϕ x)
    (t : ℝ) :
    orbitIntegral ϕ a t x = t * a x := by
  unfold orbitIntegral
  have hintegrand :
      (fun u : ℝ ↦ a (ϕ u x)) =
        fun _ : ℝ ↦ a x := by
    funext u
    rw [hx u]
  rw [hintegrand]
  simp

/-- On a fixed base fiber the skew phase has constant angular velocity. -/
theorem phaseSkewFlow_phase_of_fixed
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ)
    {x : K}
    (hx : InvariantProbabilityMeasure.IsFlowFixedPoint ϕ x)
    (t : ℝ) (z : d → Circle) (i : d) :
    (phaseSkewFlow ϕ a t (x, z)).2 i =
      Circle.exp (t * a i x) * z i := by
  rw [phaseSkewFlow_phase, orbitIntegral_of_fixed ϕ (a i) hx]

@[simp]
theorem phaseSkewFlow_base_of_fixed
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ)
    {x : K}
    (hx : InvariantProbabilityMeasure.IsFlowFixedPoint ϕ x)
    (t : ℝ) (z : d → Circle) :
    (phaseSkewFlow ϕ a t (x, z)).1 = x :=
  hx t

/-! ## The literal differential equation -/

/-- Complex derivative of one physical phase coordinate.  Its angular
velocity at time `t` is the current base value `a i (ϕ t x)`. -/
theorem hasDerivAt_phaseSkewFlow_coe
    (ϕ : Flow ℝ K) (a : d → K →ᵇ ℝ)
    (z : K × (d → Circle)) (i : d) (t : ℝ) :
    HasDerivAt
      (fun u : ℝ ↦
        ((phaseSkewFlow ϕ a u z).2 i : ℂ))
      ((((a i (ϕ t z.1) : ℝ) : ℂ) * Complex.I) *
        ((phaseSkewFlow ϕ a t z).2 i : ℂ)) t := by
  have hangle :
      HasDerivAt
        (fun u : ℝ ↦ orbitIntegral ϕ (a i) u z.1)
        (a i (ϕ t z.1)) t :=
    hasDerivAt_orbitIntegral ϕ (a i) z.1 t
  have hlinear :
      HasDerivAt
        (fun u : ℝ ↦
          ((orbitIntegral ϕ (a i) u z.1 : ℝ) : ℂ) *
            Complex.I)
        (((a i (ϕ t z.1) : ℝ) : ℂ) * Complex.I) t :=
    hangle.ofReal_comp.mul_const Complex.I
  have hexp :
      HasDerivAt
        (fun u : ℝ ↦
          Complex.exp
            (((orbitIntegral ϕ (a i) u z.1 : ℝ) : ℂ) *
              Complex.I))
        (Complex.exp
            (((orbitIntegral ϕ (a i) t z.1 : ℝ) : ℂ) *
              Complex.I) *
          (((a i (ϕ t z.1) : ℝ) : ℂ) * Complex.I)) t :=
    (Complex.hasDerivAt_exp _).comp t hlinear
  have hproduct := hexp.mul_const (z.2 i : ℂ)
  convert hproduct using 1
  simp only [phaseSkewFlow_phase, Circle.coe_mul, Circle.coe_exp]
  ring

end HGAS.Dynamics.ContinuousPhaseSkewFlow
