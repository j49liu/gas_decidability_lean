import HGAS.Dynamics.TimeAverages
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Prod
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
import Mathlib.Tactic

/-!
# A finite-time Lyapunov profile for an additive cocycle

Let `ϕ` be a continuous flow and let

`A(t,x) = ∫₀ᵗ a(ϕ(s,x)) ds`

be the additive cocycle generated by a bounded continuous observable `a`.
For a positive horizon `T`, define

`v_T(x) = ∫₀ᵀ exp(2 A(t,x)) dt`.

The profile is strictly positive.  More importantly, its derivative along
the flow is given by the exact identity

`D_ϕ v_T(x) + 2 a(x) v_T(x) = exp(2 A(T,x)) - 1`.

Thus a uniform block estimate `A(T,x) ≤ -c < 0` gives a uniform strict
negative right-hand side.  This is the finite-time version of the usual
Massera integral and avoids every improper-integral issue.

The proof below is purely cocycle calculus.  It needs only continuity of
the flow and the observable; differentiability of an ODE flow enters later,
when this orbit derivative is identified with a Fréchet directional
derivative.
-/

noncomputable section

open Function MeasureTheory Set
open scoped BoundedContinuousFunction Interval

namespace HGAS.Dynamics

variable {K : Type*} [TopologicalSpace K]

/-- Exponential weight associated with twice the finite-time additive
cocycle. -/
def quadraticCocycleWeight
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (t : ℝ) (x : K) : ℝ :=
  Real.exp (2 * orbitIntegral ϕ a t x)

/-- Finite-horizon quadratic cocycle profile. -/
def quadraticCocycleProfile
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (T : ℝ) (x : K) : ℝ :=
  ∫ t in (0 : ℝ)..T, quadraticCocycleWeight ϕ a t x

@[simp]
theorem quadraticCocycleWeight_zero
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ) (x : K) :
    quadraticCocycleWeight ϕ a 0 x = 1 := by
  simp [quadraticCocycleWeight]

/-- For a fixed orbit, the exponential cocycle weight is continuous in
time. -/
theorem continuous_quadraticCocycleWeight_time
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ) (x : K) :
    Continuous (fun t : ℝ ↦ quadraticCocycleWeight ϕ a t x) := by
  have hobservable :
      Continuous (fun t : ℝ ↦ a (ϕ t x)) :=
    continuous_orbitObservable ϕ a x
  have hintegral :
      Differentiable ℝ
        (fun t : ℝ ↦ orbitIntegral ϕ a t x) := by
    simpa only [orbitIntegral] using
      intervalIntegral.differentiable_integral_of_continuous
        hobservable
  exact
    Real.continuous_exp.comp
      (continuous_const.mul hintegral.continuous)

/-- The finite-horizon profile is strictly positive for a positive
horizon. -/
theorem quadraticCocycleProfile_pos
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    {T : ℝ} (hT : 0 < T) (x : K) :
    0 < quadraticCocycleProfile ϕ a T x := by
  have hcontinuous :=
    continuous_quadraticCocycleWeight_time ϕ a x
  unfold quadraticCocycleProfile
  exact intervalIntegral.intervalIntegral_pos_of_pos
    (hcontinuous.intervalIntegrable 0 T)
    (fun t ↦ Real.exp_pos _) hT

/-- Additivity of the cocycle becomes a multiplicative shift identity for
the exponential weight. -/
theorem quadraticCocycleWeight_flow
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (s t : ℝ) (x : K) :
    quadraticCocycleWeight ϕ a t (ϕ s x) =
      Real.exp (-2 * orbitIntegral ϕ a s x) *
        quadraticCocycleWeight ϕ a (s + t) x := by
  rw [quadraticCocycleWeight, quadraticCocycleWeight,
    ← Real.exp_add]
  congr 1
  rw [orbitIntegral_add]
  ring

/-- Moving the initial state by time `s` shifts the integration window and
introduces the inverse cocycle factor. -/
theorem quadraticCocycleProfile_flow
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (T s : ℝ) (x : K) :
    quadraticCocycleProfile ϕ a T (ϕ s x) =
      Real.exp (-2 * orbitIntegral ϕ a s x) *
        ∫ u in s..s + T, quadraticCocycleWeight ϕ a u x := by
  unfold quadraticCocycleProfile
  calc
    (∫ t in (0 : ℝ)..T,
          quadraticCocycleWeight ϕ a t (ϕ s x)) =
        ∫ t in (0 : ℝ)..T,
          Real.exp (-2 * orbitIntegral ϕ a s x) *
            quadraticCocycleWeight ϕ a (s + t) x := by
      apply intervalIntegral.integral_congr
      intro t _ht
      change quadraticCocycleWeight ϕ a t (ϕ s x) =
        Real.exp (-2 * orbitIntegral ϕ a s x) *
          quadraticCocycleWeight ϕ a (s + t) x
      rw [quadraticCocycleWeight_flow]
    _ = Real.exp (-2 * orbitIntegral ϕ a s x) *
        ∫ t in (0 : ℝ)..T,
          quadraticCocycleWeight ϕ a (s + t) x := by
      rw [intervalIntegral.integral_const_mul]
    _ = Real.exp (-2 * orbitIntegral ϕ a s x) *
        ∫ u in s + (0 : ℝ)..s + T,
          quadraticCocycleWeight ϕ a u x := by
      congr 1
      simpa using
        (intervalIntegral.integral_comp_add_left
          (f := fun u : ℝ ↦
            quadraticCocycleWeight ϕ a u x) s
          (a := (0 : ℝ)) (b := T))
    _ = _ := by
      rw [add_zero]

/-- The additive cocycle has derivative `a(x)` at time zero. -/
theorem hasDerivAt_orbitIntegral_zero
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ) (x : K) :
    HasDerivAt (fun t : ℝ ↦ orbitIntegral ϕ a t x)
      (a x) 0 := by
  have hcontinuous :=
    continuous_orbitObservable ϕ a x
  unfold orbitIntegral
  simpa only [ϕ.map_zero_apply] using
    intervalIntegral.integral_hasDerivAt_right
      (hcontinuous.intervalIntegrable 0 0)
      hcontinuous.aestronglyMeasurable.stronglyMeasurableAtFilter
      hcontinuous.continuousAt

/-- Differentiating a sliding window gives the value entering at the right
endpoint minus the value leaving at the left endpoint. -/
theorem hasDerivAt_quadraticCocycleWeight_window
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (T : ℝ) (x : K) :
    HasDerivAt
      (fun s : ℝ ↦
        ∫ u in s..s + T, quadraticCocycleWeight ϕ a u x)
      (quadraticCocycleWeight ϕ a T x - 1) 0 := by
  let B : ℝ → ℝ :=
    fun u ↦ quadraticCocycleWeight ϕ a u x
  have hB : Continuous B := by
    simpa only [B] using
      continuous_quadraticCocycleWeight_time ϕ a x
  have hintegral :
      HasFDerivAt
        (fun p : ℝ × ℝ ↦ ∫ u in p.1..p.2, B u)
        ((ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (B T) -
          (ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (B 0))
        (0, T) :=
    intervalIntegral.integral_hasFDerivAt
      (hB.intervalIntegrable 0 T)
      hB.aestronglyMeasurable.stronglyMeasurableAtFilter
      hB.aestronglyMeasurable.stronglyMeasurableAtFilter
      hB.continuousAt hB.continuousAt
  have hcurve :
      HasDerivAt (fun s : ℝ ↦ (s, s + T))
        ((1 : ℝ), (1 : ℝ)) 0 := by
    have hsecond :
        HasDerivAt (fun s : ℝ ↦ s + T) 1 0 := by
      convert
        (hasDerivAt_id (𝕜 := ℝ) 0).add
          (hasDerivAt_const (x := 0) T) using 1
      all_goals simp
    exact (hasDerivAt_id (𝕜 := ℝ) 0).prodMk hsecond
  have hintegral' :
      HasFDerivAt
        (fun p : ℝ × ℝ ↦ ∫ u in p.1..p.2, B u)
        ((ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (B T) -
          (ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (B 0))
        (0, 0 + T) := by
    simpa using hintegral
  have hcomp :=
    hintegral'.comp_hasDerivAt 0 hcurve
  simpa [B, Function.comp_def] using hcomp

/-- **Exact cocycle-profile derivative identity.**

This is the central calculation:

`d/ds|₀ v_T(ϕ_s x) =
  exp(2 A(T,x)) - 1 - 2 a(x) v_T(x)`.
-/
theorem hasDerivAt_quadraticCocycleProfile_flow_zero
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    (T : ℝ) (x : K) :
    HasDerivAt
      (fun s : ℝ ↦ quadraticCocycleProfile ϕ a T (ϕ s x))
      (quadraticCocycleWeight ϕ a T x - 1 -
        2 * a x * quadraticCocycleProfile ϕ a T x) 0 := by
  have hA :=
    hasDerivAt_orbitIntegral_zero ϕ a x
  have hexp :
      HasDerivAt
        (fun s : ℝ ↦
          Real.exp (-2 * orbitIntegral ϕ a s x))
        (-2 * a x) 0 := by
    convert (hA.const_mul (-2)).exp using 1
    all_goals simp [orbitIntegral_zero]
  have hwindow :=
    hasDerivAt_quadraticCocycleWeight_window
      ϕ a T x
  have hproduct := hexp.mul hwindow
  have hshift :
      (fun s : ℝ ↦
        quadraticCocycleProfile ϕ a T (ϕ s x)) =
      (fun s : ℝ ↦
        Real.exp (-2 * orbitIntegral ϕ a s x) *
          ∫ u in s..s + T,
            quadraticCocycleWeight ϕ a u x) := by
    funext s
    exact quadraticCocycleProfile_flow ϕ a T s x
  rw [hshift]
  convert hproduct using 1
  all_goals simp [quadraticCocycleProfile, orbitIntegral_zero]
  all_goals ring

/-- If the profile is Fréchet differentiable and `ϕ` is generated by the
vector field `Y`, the orbit derivative is its directional derivative in
the direction `Y x`. -/
theorem fderiv_quadraticCocycleProfile_generator
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ϕ : Flow ℝ E) (a : E →ᵇ ℝ)
    (Y : E → E) (T : ℝ) (x : E)
    (hflow :
      HasDerivAt (fun s : ℝ ↦ ϕ s x) (Y x) 0)
    (hprofile :
      DifferentiableAt ℝ
        (quadraticCocycleProfile ϕ a T) x) :
    fderiv ℝ (quadraticCocycleProfile ϕ a T) x (Y x) =
      quadraticCocycleWeight ϕ a T x - 1 -
        2 * a x * quadraticCocycleProfile ϕ a T x := by
  have hchain :
      HasDerivAt
        (fun s : ℝ ↦
          quadraticCocycleProfile ϕ a T (ϕ s x))
        (fderiv ℝ (quadraticCocycleProfile ϕ a T) x (Y x)) 0 := by
    have hprofile0 :
        HasFDerivAt
          (quadraticCocycleProfile ϕ a T)
          (fderiv ℝ (quadraticCocycleProfile ϕ a T) x)
          (ϕ 0 x) := by
      rw [ϕ.map_zero_apply]
      exact hprofile.hasFDerivAt
    simpa only [Function.comp_def] using
      hprofile0.comp_hasDerivAt 0 hflow
  exact hchain.unique
    (hasDerivAt_quadraticCocycleProfile_flow_zero
      ϕ a T x)

/-- A uniform negative block makes the compensated profile derivative
uniformly strictly negative. -/
theorem quadraticCocycleWeight_sub_one_neg_of_negativeBlock
    (ϕ : Flow ℝ K) (a : K →ᵇ ℝ)
    {T c : ℝ} (hc : 0 < c) (x : K)
    (hblock : orbitIntegral ϕ a T x ≤ -c) :
    quadraticCocycleWeight ϕ a T x - 1 < 0 := by
  have hexp :
      quadraticCocycleWeight ϕ a T x ≤
        Real.exp (-2 * c) := by
    rw [quadraticCocycleWeight, Real.exp_le_exp]
    nlinarith
  have hstrict : Real.exp (-2 * c) < 1 := by
    rw [← Real.exp_zero, Real.exp_lt_exp]
    linarith
  linarith

end HGAS.Dynamics
