import HGAS.Compiler.CompactAccumulatorPipelineComponentGraph
import Mathlib.Tactic

/-!
# The two remaining measure-theoretic obligations of the compact pipeline

After the source-specific global tangency premise `BaseCompactTangency`
has been supplied, all remaining algebraic, topological, and ODE data
required by the abstract compact-sign theorem are generated by the
concrete pipeline compiler.  This file packages the remaining
measure-theoretic residue as two statements:

1. in a solvable instance, every positive-mass finite-interior
   conditional of an ergodic invariant probability has a nonzero mean
   drift coordinate;
2. in an unsolvable instance, a finite invariant graph has uniformly
   positive reward.

Supplying these two dynamical facts, together with the separately visible
base-tangency premise, produces the final
`CompactSignSourceCertificate`.  No chart invariance, semiconjugacy,
degree bound, or accumulator equation remains hidden in the semantic
interface.

The first field is deliberately stated only for ergodic invariant
probabilities of the complete source.  This matches the compact-sign
proof: an ergodic maximizing probability exists, and the invariant finite
interior has mass zero or one.  In the full-mass case the accumulator
obstruction contradicts `nonzero_mean`.  Thus no
ergodic-decomposition/no-cancellation theorem for arbitrary invariant
mixtures is part of the semantic interface.
-/

namespace HGAS

open Function MeasureTheory Set
open scoped BoundedContinuousFunction

noncomputable section

namespace CompactAccumulatorPipelineCode

variable {n k l m eqs vars : ℕ}

/-- Reusable name for tangency of the denominator-cleared source
velocity in those source blocks which were compact before applying the
mixed-central compiler. -/
def BaseCompactTangency
    (layout : Fin n → Fin k ⊕ Fin l)
    (M : ℕ) (P : PolynomialFieldCode n) : Prop :=
  ∀ y : BaseSpace layout,
    let x : Fin n → ℝ :=
      fun j ↦
        y.1 (MixedCentralPolynomialCode.xIndex
          (k := k) j)
    ∀ c, MixedCentralPolynomialCode.compactBlockDot layout x
      (MixedCentralPolynomialCode.clearedSourceVelocity
        layout M P y.1) c = 0

/-- Base invariant probability obtained by conditioning a complete
invariant probability on the positive-mass finite interior and then
pushing it through the canonical factor map. -/
def conditionalBaseProbability
    (layout : Fin n → Fin k ⊕ Fin l)
    (E M : ℕ) (κ : RationalCode)
    (P : PolynomialFieldCode n)
    (hP : ∀ j, PolynomialCode.TermsDegreeLE E (P j))
    (h : Fin m → PolynomialCode n)
    (hh : ∀ i, PolynomialCode.TermsDegreeLE E (h i))
    (ε : RationalCode)
    (hcompactBase : BaseCompactTangency layout M P)
    (μ :
      Dynamics.InvariantProbabilityMeasure
        (sourceFlow layout E M κ P h ε))
    (hpos :
      (μ.measure :
        Measure
          (UnitSpherePolynomialWrapper.SourceProductSphere
            (sourceBlock (m := m) layout)))
          (sourceFiniteInteriorSet (m := m) layout) ≠ 0) :
    Dynamics.InvariantProbabilityMeasure
      (baseFlow layout E M P) :=
  let ν :=
    μ.restrictToPositiveInvariant
      (measurableSet_sourceFiniteInteriorSet
        (m := m) layout)
      hpos
      (canonicalFiniteInteriorInvariant
        layout E M κ P hP h hh ε hcompactBase)
  ν.mapEquivariant
    (restrictedBaseProjection layout)
    (continuous_restrictedBaseProjection
      (m := m) layout)
    (canonicalRestrictedBaseProjection_semiconj
      layout E M κ P hP h hh ε hcompactBase)

/-- The exact semantic residue after the finite compiler, compactification,
factor, and accumulator calculations have been discharged. -/
structure CanonicalCompactAccumulatorGap
    (I : DQLSystem eqs vars)
    (layout : Fin n → Fin k ⊕ Fin l)
    (E M : ℕ) (κ : RationalCode)
    (P : PolynomialFieldCode n)
    (hP : ∀ j, PolynomialCode.TermsDegreeLE E (P j))
    (h : Fin m → PolynomialCode n)
    (hh : ∀ i, PolynomialCode.TermsDegreeLE E (h i))
    (ε : RationalCode)
    [Nonempty
      (UnitSpherePolynomialWrapper.SourceProductSphere
        (sourceBlock (m := m) layout))]
    (hcompactBase : BaseCompactTangency layout M P) where
  /-- Strict negative margin on the boundary reward. -/
  epsilon_pos : 0 < (ε.decode : ℝ)
  /-- Uniform positive reward margin of the designated finite graph. -/
  delta : ℝ
  delta_pos : 0 < delta
  /-- Yes-instances force a nonzero drift coordinate on every
  positive-mass finite conditional of an ergodic invariant probability.
  The compact-sign theorem applies this field to an ergodic maximizer,
  so no mixture-level no-cancellation hypothesis is needed. -/
  nonzero_mean :
    I.Solvable →
      ∀ μ :
          Dynamics.InvariantProbabilityMeasure
            (sourceFlow layout E M κ P h ε),
        Dynamics.IsErgodicInvariantProbability
            (sourceFlow layout E M κ P h ε) μ.measure →
          ∀ hpos :
            (μ.measure :
              Measure
                (UnitSpherePolynomialWrapper.SourceProductSphere
                  (sourceBlock (m := m) layout)))
                (sourceFiniteInteriorSet (m := m) layout) ≠ 0,
          ∃ i : Fin m,
            (∫ b, baseDriftBCF layout M κ h b i
              ∂((conditionalBaseProbability
                layout E M κ P hP h hh ε hcompactBase
                μ hpos).measure :
                  Measure (BaseSpace layout))) ≠ 0
  /-- Measure-level consequence of the no-instance finite invariant
  graph: an invariant probability has a uniform positive reward
  margin.  Constructing the graph and its invariant measure is upstream. -/
  finite_graph :
    ¬I.Solvable →
      ∃ μ :
          Dynamics.InvariantProbabilityMeasure
            (sourceFlow layout E M κ P h ε),
        delta ≤
          Dynamics.observableAverage
            (UnitSpherePolynomialWrapper.sourceRewardBCF
              (sourceBlock (m := m) layout)
              (rewardCode
                (n := n) (k := k) (m := m) ε))
            μ.measure

namespace CanonicalCompactAccumulatorGap

/-- Convert the upstream no-instance component graph directly into the
`finite_graph` field of `CanonicalCompactAccumulatorGap`.

Only the almost-everywhere bounds stored in the selected component
certificate are used.  In particular, this bridge assumes no positive
central-weight bound on the ambient `BaseSpace`.  The extra inequality
allows the semantic gap margin `delta` to be any positive rationally
convenient lower bound for the component certificate's natural reward
margin. -/
theorem finite_graph_of_componentFiniteGraphCertificate
    (I : DQLSystem eqs vars)
    (layout : Fin n → Fin k ⊕ Fin l)
    (E M : ℕ) (κ : RationalCode)
    (P : PolynomialFieldCode n)
    (hP : ∀ j, PolynomialCode.TermsDegreeLE E (P j))
    (h : Fin m → PolynomialCode n)
    (hh : ∀ i, PolynomialCode.TermsDegreeLE E (h i))
    (ε : RationalCode)
    (hcompactBase : BaseCompactTangency layout M P)
    (delta : ℝ)
    (componentGraph :
      ¬I.Solvable →
        ComponentFiniteGraphCertificate layout E M κ P h)
    (hdelta :
      ∀ hnot : ¬I.Solvable,
        delta ≤
          3 * (componentGraph hnot).wStar / 2 -
            (ε.decode : ℝ)) :
    ¬I.Solvable →
      ∃ μ :
          Dynamics.InvariantProbabilityMeasure
            (sourceFlow layout E M κ P h ε),
        delta ≤
          Dynamics.observableAverage
            (UnitSpherePolynomialWrapper.sourceRewardBCF
              (sourceBlock (m := m) layout)
              (rewardCode
                (n := n) (k := k) (m := m) ε))
            μ.measure := by
  intro hnot
  obtain ⟨μ, hμ⟩ :=
    (componentGraph hnot).exists_sourceProbability_reward_lower
      hP hh ε hcompactBase
  exact ⟨μ, (hdelta hnot).trans hμ⟩

/-- Once `hcompactBase` has been supplied, all other structural hypotheses
of the faithful compact-sign certificate are automatic; a
`CanonicalCompactAccumulatorGap` supplies its two source-specific
measure-theoretic fields. -/
def toCompactSignSourceCertificate
    (I : DQLSystem eqs vars)
    (layout : Fin n → Fin k ⊕ Fin l)
    (E M : ℕ) (κ : RationalCode)
    (P : PolynomialFieldCode n)
    (hP : ∀ j, PolynomialCode.TermsDegreeLE E (P j))
    (h : Fin m → PolynomialCode n)
    (hh : ∀ i, PolynomialCode.TermsDegreeLE E (h i))
    (ε : RationalCode)
    [Nonempty
      (UnitSpherePolynomialWrapper.SourceProductSphere
        (sourceBlock (m := m) layout))]
    (hcompactBase : BaseCompactTangency layout M P)
    (G :
      CanonicalCompactAccumulatorGap
        I layout E M κ P hP h hh ε hcompactBase) :
    Compiler.CompactSignSourceCertificate
      (sourceBlock (m := m) layout) I := by
  let hcompact :=
    fullCompactTangencyHypothesis_of_base
      (m := m) layout M P hcompactBase
  let hcurve :=
    sourceFlow_integralCurve
      layout E M κ P hP h hh ε hcompact
  let hinv :=
    canonicalFiniteInteriorInvariant
      layout E M κ P hP h hh ε hcompactBase
  apply
    Compiler.CompactSignSourceCertificate.ofCompactAccumulatorGap
        I
        (wrapperDegree E k M)
        (wrapperDegree_ge_three E k M)
        (wrapperDegree_odd E k M)
        (fieldCode layout M κ P h)
        (fieldCode_termsDegreeLE_wrapperDegree
          layout E M κ P hP h hh)
        (rewardCode (n := n) (k := k) (m := m) ε)
        (rewardCode_termsDegreeLE_wrapperDegree_sub_one
          (n := n) (m := m) E M ε)
        (AccumulatorPolynomialCode.accumulatorSphereIndex (k + l))
        (fun y ↦
          fieldCode_sourceTangentAt
            layout M κ P h y.1 y.2 (hcompact y))
        (sourceFlow layout E M κ P h ε)
        hcurve
        (measurableSet_sourceFiniteInteriorSet
          (m := m) layout)
        hinv
        (restrictedBaseProjection layout)
        (continuous_restrictedBaseProjection
          (m := m) layout)
        (canonicalRestrictedBaseProjection_semiconj
          layout E M κ P hP h hh ε hcompactBase)
        (finiteAccumulatorProjection layout)
        (continuous_finiteAccumulatorProjection
          (m := m) layout)
        (baseDriftBCF layout M κ h)
        (canonicalFiniteAccumulator_u_hasDerivAt
          layout E M κ P hP h hh ε hcompactBase)
        (canonicalFiniteAccumulator_w_hasDerivAt
          layout E M κ P hP h hh ε hcompactBase)
        G.epsilon_pos
        G.delta_pos
  · exact
      sourceRewardBCF_le_neg_epsilon_of_not_mem_finiteInterior
        layout ε
  · intro hsolv μ hμergodic hpos
    simpa only [conditionalBaseProbability] using
      G.nonzero_mean hsolv μ hμergodic hpos
  · exact G.finite_graph

/-- End-to-end GAS equivalence obtained from the two-field semantic gap
certificate. -/
theorem finalField_gas_iff_solvable
    (I : DQLSystem eqs vars)
    (layout : Fin n → Fin k ⊕ Fin l)
    (E M : ℕ) (κ : RationalCode)
    (P : PolynomialFieldCode n)
    (hP : ∀ j, PolynomialCode.TermsDegreeLE E (P j))
    (h : Fin m → PolynomialCode n)
    (hh : ∀ i, PolynomialCode.TermsDegreeLE E (h i))
    (ε : RationalCode)
    [Nonempty
      (UnitSpherePolynomialWrapper.SourceProductSphere
        (sourceBlock (m := m) layout))]
    (hcompactBase : BaseCompactTangency layout M P)
    (G :
      CanonicalCompactAccumulatorGap
        I layout E M κ P hP h hh ε hcompactBase) :
    GloballyAsymptoticallyStable
        (PolynomialFieldCode.realize
          (Compiler.CompactSignSourceCertificate.finalFieldCode
            (G.toCompactSignSourceCertificate
              I layout E M κ P hP h hh ε hcompactBase))) 0 ↔
      I.Solvable :=
  Compiler.CompactSignSourceCertificate.finalField_gas_iff_solvable
    (G.toCompactSignSourceCertificate
      I layout E M κ P hP h hh ε hcompactBase)

end CanonicalCompactAccumulatorGap

end CompactAccumulatorPipelineCode

end

end HGAS
