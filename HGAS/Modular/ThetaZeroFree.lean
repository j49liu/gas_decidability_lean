import HGAS.Modular.CanonicalUnaryRootsSolution
import HGAS.Modular.LevelOneLowWeightVanishing
import Mathlib.NumberTheory.ModularForms.Discriminant

/-!
# Pointwise nonvanishing of the even theta constants

The differential reconstruction eventually divides by

```
                         B = θ₃⁴.
```

Nontriviality as a holomorphic function is not enough for that purpose; we
need pointwise nonvanishing throughout the upper half-plane.

We prove all three even theta fourth powers are zero-free by a short
level-one modular-form argument.  Put

```
                      P = H₂ H₃ H₄.
```

Each generator `S,T` sends `P` to `-P`.  Hence `P²` is a level-one
weight-twelve cusp form.  Mathlib proves that this cusp-form space is
one-dimensional, generated by the modular discriminant `Δ`, and that
`Δ` has no zeros in the upper half-plane.  The scalar multiplying `Δ` is
nonzero because the holomorphic functions `H₂,H₃,H₄` are each
nontrivial and the upper half-plane is connected.  It follows that
`P²`, then `P`, and finally every factor of `P`, is pointwise nonzero.

This avoids importing a separate Jacobi triple-product theorem while
making every use of the discriminant explicit.
-/

namespace HGAS.Modular

open UpperHalfPlane hiding I
open Complex Filter Topology
open ModularForm ModularGroup SlashAction
open scoped Manifold MatrixGroups ModularForm

noncomputable section

/-- `H₂=θ₂⁴` is not identically zero. -/
theorem H₂_ne_zero_function :
    H₂ ≠ 0 := by
  intro hzero
  apply theta₂_ne_zero_function
  ext z
  have hz := congrFun hzero z
  simp only [H₂, Pi.zero_apply] at hz
  exact (pow_eq_zero_iff (by norm_num : 4 ≠ 0)).mp hz

/-- `H₃=θ₃⁴` is not identically zero. -/
theorem H₃_ne_zero_function :
    H₃ ≠ 0 :=
  HGAS.Analysis.function_ne_zero_of_tendsto
    H₃_tendsto_atImInfty
    (one_ne_zero : (1 : ℂ) ≠ 0)

/-- Product of the three even theta fourth powers. -/
def thetaEvenProduct : ℍ → ℂ :=
  (H₂ * H₃) * H₄

/-- The theta product changes sign under inversion. -/
theorem thetaEvenProduct_S_action :
    (thetaEvenProduct ∣[(6 : ℤ)] S) =
      -thetaEvenProduct := by
  change
    (((H₂ * H₃) * H₄) ∣[(6 : ℤ)] S) =
      -((H₂ * H₃) * H₄)
  rw [show (6 : ℤ) = 4 + 2 by norm_num,
    ModularForm.mul_slash_SL2,
    show (4 : ℤ) = 2 + 2 by norm_num,
    ModularForm.mul_slash_SL2,
    H₂_S_action, H₃_S_action, H₄_S_action]
  ext z
  simp only [Pi.mul_apply, Pi.neg_apply]
  ring

/-- The theta product changes sign under translation. -/
theorem thetaEvenProduct_T_action :
    (thetaEvenProduct ∣[(6 : ℤ)] T) =
      -thetaEvenProduct := by
  change
    (((H₂ * H₃) * H₄) ∣[(6 : ℤ)] T) =
      -((H₂ * H₃) * H₄)
  rw [show (6 : ℤ) = 4 + 2 by norm_num,
    ModularForm.mul_slash_SL2,
    show (4 : ℤ) = 2 + 2 by norm_num,
    ModularForm.mul_slash_SL2,
    H₂_T_action, H₃_T_action, H₄_T_action]
  ext z
  simp only [Pi.mul_apply, Pi.neg_apply]
  ring

/-- Holomorphy of the theta product. -/
theorem thetaEvenProduct_mdifferentiable :
    MDiff thetaEvenProduct := by
  intro z
  exact
    ((H₂_mdifferentiable z).mul
      (H₃_mdifferentiable z)).mul
        (H₄_mdifferentiable z)

/-- The theta product is not the zero holomorphic function. -/
theorem thetaEvenProduct_ne_zero_function :
    thetaEvenProduct ≠ 0 := by
  intro hzero
  have hsplit :
      H₂ * H₃ = 0 ∨ H₄ = 0 :=
    (UpperHalfPlane.mul_eq_zero_iff
      (fun z ↦ (H₂_mdifferentiable z).mul
        (H₃_mdifferentiable z))
      H₄_mdifferentiable).mp hzero
  rcases hsplit with hleft | hH₄
  · have hsplit' :
        H₂ = 0 ∨ H₃ = 0 :=
      (UpperHalfPlane.mul_eq_zero_iff
        H₂_mdifferentiable
        H₃_mdifferentiable).mp hleft
    exact hsplit'.elim
      H₂_ne_zero_function
      H₃_ne_zero_function
  · exact H₄_ne_zero_function hH₄

/-- The theta product tends to zero at the infinite cusp. -/
theorem thetaEvenProduct_tendsto_zero :
    Tendsto thetaEvenProduct atImInfty (𝓝 0) := by
  change Tendsto
    (fun z ↦ (H₂ z * H₃ z) * H₄ z)
    atImInfty (𝓝 0)
  simpa using
    (H₂_tendsto_atImInfty.mul
      H₃_tendsto_atImInfty).mul
        H₄_tendsto_atImInfty

/-- Square of the theta product. -/
def thetaEvenProductSq : ℍ → ℂ :=
  thetaEvenProduct * thetaEvenProduct

/-- The squared product is invariant under `S` at weight twelve. -/
theorem thetaEvenProductSq_S_action :
    (thetaEvenProductSq ∣[(12 : ℤ)] S) =
      thetaEvenProductSq := by
  change
    ((thetaEvenProduct * thetaEvenProduct) ∣[(12 : ℤ)] S) =
      thetaEvenProduct * thetaEvenProduct
  rw [show (12 : ℤ) = 6 + 6 by norm_num,
    ModularForm.mul_slash_SL2,
    thetaEvenProduct_S_action]
  exact neg_mul_neg _ _

/-- The squared product is invariant under `T` at weight twelve. -/
theorem thetaEvenProductSq_T_action :
    (thetaEvenProductSq ∣[(12 : ℤ)] T) =
      thetaEvenProductSq := by
  change
    ((thetaEvenProduct * thetaEvenProduct) ∣[(12 : ℤ)] T) =
      thetaEvenProduct * thetaEvenProduct
  rw [show (12 : ℤ) = 6 + 6 by norm_num,
    ModularForm.mul_slash_SL2,
    thetaEvenProduct_T_action]
  exact neg_mul_neg _ _

/-- Holomorphy of the squared product. -/
theorem thetaEvenProductSq_mdifferentiable :
    MDiff thetaEvenProductSq := by
  intro z
  exact
    (thetaEvenProduct_mdifferentiable z).mul
      (thetaEvenProduct_mdifferentiable z)

/-- The squared product tends to zero at the cusp. -/
theorem thetaEvenProductSq_tendsto_zero :
    Tendsto thetaEvenProductSq atImInfty (𝓝 0) := by
  change Tendsto
    (fun z ↦ thetaEvenProduct z * thetaEvenProduct z)
    atImInfty (𝓝 0)
  simpa using
    thetaEvenProduct_tendsto_zero.mul
      thetaEvenProduct_tendsto_zero

/-- The squared product is not identically zero. -/
theorem thetaEvenProductSq_ne_zero_function :
    thetaEvenProductSq ≠ 0 := by
  intro hzero
  apply thetaEvenProduct_ne_zero_function
  ext z
  have hz := congrFun hzero z
  simp only [thetaEvenProductSq, Pi.mul_apply,
    Pi.zero_apply] at hz
  exact mul_self_eq_zero.mp hz

/-- The weight-twelve theta product is a nonzero scalar multiple of the
modular discriminant.  The scalar is left abstract because only
nonvanishing is needed downstream. -/
theorem thetaEvenProductSq_eq_nonzero_smul_discriminant :
    ∃ c : ℂ, c ≠ 0 ∧
      c • CuspForm.discriminant =
        cuspFormOfSTTendstoZero
          thetaEvenProductSq
          thetaEvenProductSq_S_action
          thetaEvenProductSq_T_action
          thetaEvenProductSq_mdifferentiable
          thetaEvenProductSq_tendsto_zero := by
  let F : CuspForm 𝒮ℒ 12 :=
    cuspFormOfSTTendstoZero
      thetaEvenProductSq
      thetaEvenProductSq_S_action
      thetaEvenProductSq_T_action
      thetaEvenProductSq_mdifferentiable
      thetaEvenProductSq_tendsto_zero
  obtain ⟨c, hc⟩ :=
    CuspForm.exists_smul_discriminant_of_weight_eq_twelve F
  have hcne : c ≠ 0 := by
    intro hc0
    apply thetaEvenProductSq_ne_zero_function
    ext z
    have hz :=
      congrArg (fun G : CuspForm 𝒮ℒ 12 ↦ G z) hc
    simpa [F, hc0] using hz.symm
  exact ⟨c, hcne, hc⟩

/-- The product `H₂H₃H₄` is nonzero at every point of the upper
half-plane. -/
theorem thetaEvenProduct_ne_zero (z : ℍ) :
    thetaEvenProduct z ≠ 0 := by
  obtain ⟨c, hc, hform⟩ :=
    thetaEvenProductSq_eq_nonzero_smul_discriminant
  have hvalue :=
    congrArg (fun G : CuspForm 𝒮ℒ 12 ↦ G z) hform
  have hDelta :
      ModularForm.discriminant z ≠ 0 :=
    ModularForm.discriminant_ne_zero z
  have hsquare : thetaEvenProductSq z ≠ 0 := by
    intro hzero
    have hvalue' :
        c * ModularForm.discriminant z =
          thetaEvenProductSq z := by
      simpa using hvalue
    have hproduct :
        c * ModularForm.discriminant z = 0 := by
      exact hvalue'.trans hzero
    exact (mul_ne_zero hc hDelta) hproduct
  intro hzero
  apply hsquare
  simp [thetaEvenProductSq, hzero]

/-- Pointwise zero-freeness of `H₂`. -/
theorem H₂_ne_zero (z : ℍ) :
    H₂ z ≠ 0 := by
  intro hzero
  apply thetaEvenProduct_ne_zero z
  simp [thetaEvenProduct, hzero]

/-- Pointwise zero-freeness of `H₃`. -/
theorem H₃_ne_zero (z : ℍ) :
    H₃ z ≠ 0 := by
  intro hzero
  apply thetaEvenProduct_ne_zero z
  simp [thetaEvenProduct, hzero]

/-- Pointwise zero-freeness of `H₄`. -/
theorem H₄_ne_zero (z : ℍ) :
    H₄ z ≠ 0 := by
  intro hzero
  apply thetaEvenProduct_ne_zero z
  simp [thetaEvenProduct, hzero]

/-- The canonical unary denominator `B=A+C=H₃` is pointwise nonzero. -/
theorem canonicalUnaryTheta_B_ne_zero (z : ℍ) :
    UnaryModularState.B (canonicalUnaryTheta z) ≠ 0 := by
  have hJacobi : H₂ z + H₄ z = H₃ z := by
    simpa only [Pi.add_apply] using
      congrFun jacobi_quartic_identity z
  rw [UnaryModularState.B,
    canonicalUnaryTheta_A,
    canonicalUnaryTheta_C,
    hJacobi]
  exact H₃_ne_zero z

end

end HGAS.Modular
