import HGAS.Modular.CanonicalLambdaImaginaryAxis

/-!
# The absolute six-fold invariant of canonical lambda

The rational function

```
               J₀(x) = (1 - x + x²)³ / (x²(1-x)²)
```

is invariant under the six cross-ratio transformations generated by
`x ↦ 1-x` and `x ↦ x/(x-1)`.  Up to the conventional factor `256`, this is
the usual expression of the absolute modular invariant in terms of lambda.

The key reusable result in this file is the converse: away from `0` and
`1`, equality of `J₀` values forces two arguments to differ by one of those
six transformations.  The proof is the explicit factorization

```
 A(x)B(y)-A(y)B(x)
   = (x-y)(x+y-1)(xy-1)(xy-x+1)(xy-y+1)(xy-x-y),
```

where `A(x)=(1-x+x²)³` and `B(x)=x²(1-x)²`.

This is the finite-fiber algebra needed by a fundamental-domain or quotient
proof of global modular-lambda uniformization.
-/

namespace HGAS.Modular

open UpperHalfPlane hiding I
open Complex Real ModularGroup Filter Topology
open scoped MatrixGroups Topology

noncomputable section

/-- The absolute six-fold rational invariant of a lambda value. -/
def lambdaAbsoluteInvariant (x : ℂ) : ℂ :=
  (1 - x + x ^ 2) ^ 3 /
    (x ^ 2 * (1 - x) ^ 2)

/-- The factor of `J₀` which remains finite and nonzero at `x=0`. -/
def lambdaAbsoluteRegularFactor (x : ℂ) : ℂ :=
  (1 - x + x ^ 2) ^ 3 / (1 - x) ^ 2

/-- Separation of the double pole at zero from the regular factor. -/
theorem lambdaAbsoluteInvariant_eq_regular_mul_inv_sq
    (x : ℂ) :
    lambdaAbsoluteInvariant x =
      lambdaAbsoluteRegularFactor x * (x ^ 2)⁻¹ := by
  simp only [lambdaAbsoluteInvariant,
    lambdaAbsoluteRegularFactor, div_eq_mul_inv,
    mul_inv_rev]
  ring

/-- The absolute invariant is unchanged by `x ↦ 1-x`. -/
theorem lambdaAbsoluteInvariant_one_sub
    (x : ℂ) (hx0 : x ≠ 0) (hx1 : x ≠ 1) :
    lambdaAbsoluteInvariant (1 - x) =
      lambdaAbsoluteInvariant x := by
  unfold lambdaAbsoluteInvariant
  field_simp [hx0, sub_ne_zero.mpr hx1,
    sub_ne_zero.mpr hx1.symm]
  ring

/-- The absolute invariant is unchanged by `x ↦ x/(x-1)`. -/
theorem lambdaAbsoluteInvariant_div_sub_one
    (x : ℂ) (hx0 : x ≠ 0) (hx1 : x ≠ 1) :
    lambdaAbsoluteInvariant (x / (x - 1)) =
      lambdaAbsoluteInvariant x := by
  unfold lambdaAbsoluteInvariant
  field_simp [hx0, sub_ne_zero.mpr hx1,
    sub_ne_zero.mpr hx1.symm]
  ring

/-- Equality of absolute invariants has only the six expected solutions.

The order of the alternatives is

```
 y = x,  1-x,  1/x,  (x-1)/x,  1/(1-x),  x/(x-1).
```
-/
theorem eq_crossRatio_of_lambdaAbsoluteInvariant_eq
    {x y : ℂ}
    (hx0 : x ≠ 0) (hx1 : x ≠ 1)
    (hy0 : y ≠ 0) (hy1 : y ≠ 1)
    (h :
      lambdaAbsoluteInvariant x =
        lambdaAbsoluteInvariant y) :
    y = x ∨
    y = 1 - x ∨
    y = 1 / x ∨
    y = (x - 1) / x ∨
    y = 1 / (1 - x) ∨
    y = x / (x - 1) := by
  have hxden :
      x ^ 2 * (1 - x) ^ 2 ≠ 0 :=
    mul_ne_zero (pow_ne_zero 2 hx0)
      (pow_ne_zero 2
        (sub_ne_zero.mpr hx1.symm))
  have hyden :
      y ^ 2 * (1 - y) ^ 2 ≠ 0 :=
    mul_ne_zero (pow_ne_zero 2 hy0)
      (pow_ne_zero 2
        (sub_ne_zero.mpr hy1.symm))
  unfold lambdaAbsoluteInvariant at h
  rw [div_eq_div_iff hxden hyden] at h
  have hprod :
      (x - y) *
        (x + y - 1) *
        (x * y - 1) *
        (x * y - x + 1) *
        (x * y - y + 1) *
        (x * y - x - y) = 0 := by
    calc
      (x - y) *
          (x + y - 1) *
          (x * y - 1) *
          (x * y - x + 1) *
          (x * y - y + 1) *
          (x * y - x - y) =
        (1 - x + x ^ 2) ^ 3 *
            (y ^ 2 * (1 - y) ^ 2) -
          (1 - y + y ^ 2) ^ 3 *
            (x ^ 2 * (1 - x) ^ 2) := by
              ring
      _ = 0 := sub_eq_zero.mpr h
  rcases mul_eq_zero.mp hprod with hfive | hFrac
  · rcases mul_eq_zero.mp hfive with hfour | hOneSub
    · rcases mul_eq_zero.mp hfour with hthree | hXm1
      · rcases mul_eq_zero.mp hthree with htwo | hInv
        · rcases mul_eq_zero.mp htwo with hxy | hsum
          · exact Or.inl (sub_eq_zero.mp hxy).symm
          · right
            left
            linear_combination hsum
        · right
          right
          left
          apply (eq_div_iff hx0).mpr
          rw [mul_comm]
          linear_combination hInv
      · right
        right
        right
        left
        apply (eq_div_iff hx0).mpr
        linear_combination hXm1
    · right
      right
      right
      right
      left
      apply
        (eq_div_iff
          (sub_ne_zero.mpr hx1.symm)).mpr
      linear_combination -hOneSub
  · right
    right
    right
    right
    right
    apply
      (eq_div_iff
        (sub_ne_zero.mpr hx1)).mpr
    linear_combination hFrac

/-- The regular factor tends to one as canonical lambda approaches the
top cusp. -/
theorem lambdaAbsoluteRegularFactor_canonicalLambda_tendsto :
    Tendsto
      (fun z : ℍ ↦
        lambdaAbsoluteRegularFactor
          (canonicalLambda z))
      atImInfty (𝓝 1) := by
  have hbase :
      Tendsto
        (fun z : ℍ ↦
          1 - canonicalLambda z +
            canonicalLambda z ^ 2)
        atImInfty (𝓝 1) := by
    convert
      (tendsto_const_nhds.sub
        canonicalLambda_tendsto_atImInfty).add
          (canonicalLambda_tendsto_atImInfty.pow 2) using 1
    norm_num
  have hden :
      Tendsto
        (fun z : ℍ ↦
          (1 - canonicalLambda z) ^ 2)
        atImInfty (𝓝 1) := by
    convert
      (tendsto_const_nhds.sub
        canonicalLambda_tendsto_atImInfty).pow 2 using 1
    norm_num
  unfold lambdaAbsoluteRegularFactor
  simpa only [Pi.div_apply, one_pow, div_one] using
    (hbase.pow 3).div hden one_ne_zero

/-- The absolute invariant escapes to infinity at the top cusp. -/
theorem norm_lambdaAbsoluteInvariant_canonicalLambda_tendsto_atTop :
    Tendsto
      (fun z : ℍ ↦
        ‖lambdaAbsoluteInvariant
          (canonicalLambda z)‖)
      atImInfty atTop := by
  have hsquare :
      Tendsto
        (fun z : ℍ ↦ canonicalLambda z ^ 2)
        atImInfty (𝓝[≠] 0) := by
    rw [tendsto_nhdsWithin_iff]
    exact
      ⟨by
        simpa using
          canonicalLambda_tendsto_atImInfty.pow 2,
        Filter.Eventually.of_forall fun z ↦
          pow_ne_zero 2
            (canonicalLambda_ne_zero z)⟩
  have hpole :
      Tendsto
        (fun z : ℍ ↦
          ‖(canonicalLambda z ^ 2)⁻¹‖)
        atImInfty atTop :=
    tendsto_norm_inv_nhdsNE_zero_atTop.comp
      hsquare
  have hregular :
      Tendsto
        (fun z : ℍ ↦
          ‖lambdaAbsoluteRegularFactor
            (canonicalLambda z)‖)
        atImInfty (𝓝 1) := by
    simpa using
      lambdaAbsoluteRegularFactor_canonicalLambda_tendsto.norm
  have hproduct :=
    hpole.atTop_mul_pos zero_lt_one hregular
  convert hproduct using 1
  ext z
  rw [lambdaAbsoluteInvariant_eq_regular_mul_inv_sq,
    norm_mul, mul_comm]

/-- The absolute invariant evaluated on canonical lambda. -/
def canonicalLambdaAbsoluteInvariant (z : ℍ) : ℂ :=
  lambdaAbsoluteInvariant (canonicalLambda z)

/-- The canonical absolute invariant is unchanged by `S`. -/
theorem canonicalLambdaAbsoluteInvariant_modularSPoint
    (z : ℍ) :
    canonicalLambdaAbsoluteInvariant
        (modularSPoint z) =
      canonicalLambdaAbsoluteInvariant z := by
  rw [canonicalLambdaAbsoluteInvariant,
    canonicalLambda_modularSPoint]
  exact
    lambdaAbsoluteInvariant_one_sub
      (canonicalLambda z)
      (canonicalLambda_ne_zero z)
      (canonicalLambda_ne_one z)

/-- The canonical absolute invariant is unchanged by `T`. -/
theorem canonicalLambdaAbsoluteInvariant_vadd_one
    (z : ℍ) :
    canonicalLambdaAbsoluteInvariant
        ((1 : ℝ) +ᵥ z) =
      canonicalLambdaAbsoluteInvariant z := by
  rw [canonicalLambdaAbsoluteInvariant,
    canonicalLambda_vadd_one]
  exact
    lambdaAbsoluteInvariant_div_sub_one
      (canonicalLambda z)
      (canonicalLambda_ne_zero z)
      (canonicalLambda_ne_one z)

/-- Integral matrices preserving the canonical absolute invariant. -/
def canonicalLambdaAbsoluteInvariantSubgroup :
    Subgroup SL(2, ℤ) where
  carrier :=
    {g | ∀ z : ℍ,
      canonicalLambdaAbsoluteInvariant (g • z) =
        canonicalLambdaAbsoluteInvariant z}
  one_mem' := by
    intro z
    rw [one_smul]
  mul_mem' := by
    intro g h hg hh z
    rw [mul_smul, hg, hh]
  inv_mem' := by
    intro g hg z
    have h := hg (g⁻¹ • z)
    simpa only [smul_inv_smul] using h.symm

/-- The absolute invariant is invariant under every integral modular
transformation. -/
theorem canonicalLambdaAbsoluteInvariant_smul
    (g : SL(2, ℤ)) (z : ℍ) :
    canonicalLambdaAbsoluteInvariant (g • z) =
      canonicalLambdaAbsoluteInvariant z := by
  have hS :
      S ∈ canonicalLambdaAbsoluteInvariantSubgroup := by
    intro w
    simpa only [UpperHalfPlane.modular_S_smul] using
      canonicalLambdaAbsoluteInvariant_modularSPoint w
  have hT :
      T ∈ canonicalLambdaAbsoluteInvariantSubgroup := by
    intro w
    simpa only [UpperHalfPlane.modular_T_smul] using
      canonicalLambdaAbsoluteInvariant_vadd_one w
  have hle :
      Subgroup.closure ({S, T} : Set SL(2, ℤ)) ≤
        canonicalLambdaAbsoluteInvariantSubgroup := by
    apply
      (Subgroup.closure_le
        canonicalLambdaAbsoluteInvariantSubgroup).2
    intro a ha
    simp only [Set.mem_insert_iff,
      Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · exact hS
    · exact hT
  exact hle (by
    rw [SpecialLinearGroup.SL2Z_generators]
    exact Subgroup.mem_top g) z

end

end HGAS.Modular
