import HGAS.Modular.JacobiAlgebra
import HGAS.Modular.UnaryAlgebra
import Mathlib.Tactic

/-!
# Link ideal between the unary and Jacobi coefficient blocks

The unary modular block and the symmetric Jacobi coefficient block retain
separate copies of their coefficient variables.  Their intended
identification is imposed by polynomial residuals

```
 L₂ = p₂²-A,   L₃ = p₃²-Y⁴,   L₄ = p₄²-C,   L_H = 12H-E.
```

This duplication is important for the finite polynomial construction: no
division or hidden substitution is used.  To justify it dynamically one
must prove that the link ideal is invariant.

The four long identities in this file are exactly equation (7.24) of the
written proof.  They include every forcing term from the Jacobi residual

```
                         R_J = Y⁴-A-C.
```

Lean verifies them by polynomial normalization over an arbitrary
characteristic-zero field.  We also check the signed link `p₃=Y²`.
-/

namespace HGAS.Modular

noncomputable section

/-- The unary state and the Jacobi chart, kept as independent polynomial
coordinate blocks. -/
@[ext]
structure LinkedJacobiState (R : Type*) where
  unary : UnaryModularState R
  jacobi : JacobiState R

namespace LinkedJacobiState

variable {R : Type*} [Field R] [CharZero R]

/-- The modular derivation acts on both blocks; the elliptic derivation
fixes the unary block and the four coefficient coordinates. -/
def modularVectorField
    (z : LinkedJacobiState R) :
    LinkedJacobiState R where
  unary := UnaryModularState.vectorField z.unary
  jacobi := JacobiState.modularVectorField z.jacobi

/-- The elliptic derivation acts only on the Jacobi chart. -/
def ellipticVectorField
    (z : LinkedJacobiState R) :
    LinkedJacobiState R where
  unary := 0
  jacobi := JacobiState.ellipticVectorField z.jacobi

/-- A fixed complex linear combination of the elliptic and modular
derivations on the linked state. -/
def combinedVectorField
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    LinkedJacobiState R where
  unary :=
    { A := κPhi * (UnaryModularState.vectorField z.unary).A
      C := κPhi * (UnaryModularState.vectorField z.unary).C
      E := κPhi * (UnaryModularState.vectorField z.unary).E
      Y := κPhi * (UnaryModularState.vectorField z.unary).Y }
  jacobi :=
    JacobiState.combinedVectorField κZ κPhi z.jacobi

def link2 (z : LinkedJacobiState R) : R :=
  z.jacobi.p2 ^ 2 - z.unary.A

def link3 (z : LinkedJacobiState R) : R :=
  z.jacobi.p3 ^ 2 - z.unary.Y ^ 4

def link4 (z : LinkedJacobiState R) : R :=
  z.jacobi.p4 ^ 2 - z.unary.C

def linkH (z : LinkedJacobiState R) : R :=
  12 * z.jacobi.H - z.unary.E

def jacobiResidual (z : LinkedJacobiState R) : R :=
  z.unary.Y ^ 4 - z.unary.A - z.unary.C

/-- The signed link selecting `p₃=Y²`. -/
def signedLink3 (z : LinkedJacobiState R) : R :=
  z.jacobi.p3 - z.unary.Y ^ 2

omit [CharZero R] in
/-- The coefficient-curve residual is generated by the four links and the
unary Jacobi residual. -/
theorem residualR0_eq_links
    (z : LinkedJacobiState R) :
    JacobiState.residualR0 z.jacobi =
      link3 z - link2 z - link4 z +
        jacobiResidual z := by
  simp only [JacobiState.residualR0, link2, link3,
    link4, jacobiResidual]
  ring

/-! ## Directional differentials -/

def link2Differential
    (z w : LinkedJacobiState R) : R :=
  2 * z.jacobi.p2 * w.jacobi.p2 - w.unary.A

def link3Differential
    (z w : LinkedJacobiState R) : R :=
  2 * z.jacobi.p3 * w.jacobi.p3 -
    4 * z.unary.Y ^ 3 * w.unary.Y

def link4Differential
    (z w : LinkedJacobiState R) : R :=
  2 * z.jacobi.p4 * w.jacobi.p4 - w.unary.C

def linkHDifferential
    (_z w : LinkedJacobiState R) : R :=
  12 * w.jacobi.H - w.unary.E

def jacobiResidualDifferential
    (z w : LinkedJacobiState R) : R :=
  4 * z.unary.Y ^ 3 * w.unary.Y -
    w.unary.A - w.unary.C

def signedLink3Differential
    (z w : LinkedJacobiState R) : R :=
  w.jacobi.p3 -
    2 * z.unary.Y * w.unary.Y

/-! ## The printed modular link certificates -/

theorem modular_link2_certificate
    (z : LinkedJacobiState R) :
    link2Differential z (modularVectorField z) =
      (1 / 3 : R) *
          (z.unary.E + z.unary.A +
            2 * z.unary.C) * link2 z +
        (z.jacobi.p2 ^ 2 / 3) *
          (jacobiResidual z + linkH z +
            link3 z + link4 z) := by
  simp only [link2Differential, modularVectorField,
    JacobiState.modularVectorField,
    UnaryModularState.vectorField, link2, link3,
    link4, linkH, jacobiResidual]
  ring

theorem modular_link3_certificate
    (z : LinkedJacobiState R) :
    link3Differential z (modularVectorField z) =
      (1 / 3 : R) *
          (z.unary.E + z.unary.A -
            z.unary.C) * link3 z +
        (z.jacobi.p3 ^ 2 / 3) *
          (linkH z + link2 z - link4 z) := by
  simp only [link3Differential, modularVectorField,
    JacobiState.modularVectorField,
    UnaryModularState.vectorField, link2, link3,
    link4, linkH]
  ring

theorem modular_link4_certificate
    (z : LinkedJacobiState R) :
    link4Differential z (modularVectorField z) =
      (1 / 3 : R) *
          (z.unary.E - 2 * z.unary.A -
            z.unary.C) * link4 z +
        (z.jacobi.p4 ^ 2 / 3) *
          (linkH z - link2 z - link3 z -
            jacobiResidual z) := by
  simp only [link4Differential, modularVectorField,
    JacobiState.modularVectorField,
    UnaryModularState.vectorField, link2, link3,
    link4, linkH, jacobiResidual]
  ring

theorem modular_linkH_certificate
    (z : LinkedJacobiState R) :
    linkHDifferential z (modularVectorField z) =
      ((12 * z.jacobi.H + z.unary.E) / 6) *
          linkH z -
        ((z.jacobi.p2 ^ 2 + z.unary.A) *
              link2 z +
            (z.jacobi.p3 ^ 2 + z.unary.A +
                z.unary.C) *
              (link3 z + jacobiResidual z) +
            (z.jacobi.p4 ^ 2 + z.unary.C) *
              link4 z) / 12 := by
  simp only [linkHDifferential, modularVectorField,
    JacobiState.modularVectorField,
    UnaryModularState.vectorField, link2, link3,
    link4, linkH, jacobiResidual]
  ring

/-- The unary Jacobi residual remains a scalar cocycle after the two blocks
are combined. -/
theorem modular_jacobiResidual_certificate
    (z : LinkedJacobiState R) :
    jacobiResidualDifferential z
        (modularVectorField z) =
      (1 / 3 : R) *
          (z.unary.E + z.unary.A -
            z.unary.C) *
        jacobiResidual z := by
  simp only [jacobiResidualDifferential,
    modularVectorField, UnaryModularState.vectorField,
    jacobiResidual]
  ring

/-- Exact signed-link certificate, including its forcing by the three
unsigned coefficient links. -/
theorem modular_signedLink3_certificate
    (z : LinkedJacobiState R) :
    signedLink3Differential z
        (modularVectorField z) =
      (1 / 6 : R) *
          (12 * z.jacobi.H + z.jacobi.p2 ^ 2 -
            z.jacobi.p4 ^ 2) *
          signedLink3 z +
        (1 / 6 : R) *
          (linkH z + link2 z - link4 z) *
            z.unary.Y ^ 2 := by
  simp only [signedLink3Differential,
    modularVectorField, JacobiState.modularVectorField,
    UnaryModularState.vectorField, signedLink3,
    linkH, link2, link4]
  ring

/-! ## The elliptic derivation fixes every coefficient link -/

omit [CharZero R] in
theorem elliptic_links_differentials_eq_zero
    (z : LinkedJacobiState R) :
    link2Differential z (ellipticVectorField z) = 0 ∧
    link3Differential z (ellipticVectorField z) = 0 ∧
    link4Differential z (ellipticVectorField z) = 0 ∧
    linkHDifferential z (ellipticVectorField z) = 0 ∧
    jacobiResidualDifferential z
      (ellipticVectorField z) = 0 ∧
    signedLink3Differential z
      (ellipticVectorField z) = 0 := by
  simp [link2Differential, link3Differential,
    link4Differential, linkHDifferential,
    jacobiResidualDifferential, signedLink3Differential,
    ellipticVectorField, JacobiState.ellipticVectorField]

/-! ## Certificates for the combined physical derivation -/

theorem combined_link2_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    link2Differential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        ((1 / 3 : R) *
            (z.unary.E + z.unary.A +
              2 * z.unary.C) * link2 z +
          (z.jacobi.p2 ^ 2 / 3) *
            (jacobiResidual z + linkH z +
              link3 z + link4 z)) := by
  have h := modular_link2_certificate z
  simp only [link2Differential, combinedVectorField,
    JacobiState.combinedVectorField,
    JacobiState.ellipticVectorField,
    modularVectorField] at h ⊢
  linear_combination κPhi * h

theorem combined_link3_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    link3Differential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        ((1 / 3 : R) *
            (z.unary.E + z.unary.A -
              z.unary.C) * link3 z +
          (z.jacobi.p3 ^ 2 / 3) *
            (linkH z + link2 z - link4 z)) := by
  have h := modular_link3_certificate z
  simp only [link3Differential, combinedVectorField,
    JacobiState.combinedVectorField,
    JacobiState.ellipticVectorField,
    modularVectorField] at h ⊢
  linear_combination κPhi * h

theorem combined_link4_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    link4Differential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        ((1 / 3 : R) *
            (z.unary.E - 2 * z.unary.A -
              z.unary.C) * link4 z +
          (z.jacobi.p4 ^ 2 / 3) *
            (linkH z - link2 z - link3 z -
              jacobiResidual z)) := by
  have h := modular_link4_certificate z
  simp only [link4Differential, combinedVectorField,
    JacobiState.combinedVectorField,
    JacobiState.ellipticVectorField,
    modularVectorField] at h ⊢
  linear_combination κPhi * h

theorem combined_linkH_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    linkHDifferential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        (((12 * z.jacobi.H + z.unary.E) / 6) *
            linkH z -
          ((z.jacobi.p2 ^ 2 + z.unary.A) *
                link2 z +
              (z.jacobi.p3 ^ 2 + z.unary.A +
                  z.unary.C) *
                (link3 z + jacobiResidual z) +
              (z.jacobi.p4 ^ 2 + z.unary.C) *
                link4 z) / 12) := by
  have h := modular_linkH_certificate z
  simp only [linkHDifferential, combinedVectorField,
    JacobiState.combinedVectorField,
    JacobiState.ellipticVectorField,
    modularVectorField] at h ⊢
  linear_combination κPhi * h

theorem combined_jacobiResidual_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    jacobiResidualDifferential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        ((1 / 3 : R) *
          (z.unary.E + z.unary.A -
            z.unary.C) *
          jacobiResidual z) := by
  have h := modular_jacobiResidual_certificate z
  simp only [jacobiResidualDifferential,
    combinedVectorField, modularVectorField] at h ⊢
  linear_combination κPhi * h

theorem combined_signedLink3_certificate
    (κZ κPhi : R) (z : LinkedJacobiState R) :
    signedLink3Differential z
        (combinedVectorField κZ κPhi z) =
      κPhi *
        ((1 / 6 : R) *
            (12 * z.jacobi.H +
              z.jacobi.p2 ^ 2 -
              z.jacobi.p4 ^ 2) *
            signedLink3 z +
          (1 / 6 : R) *
            (linkH z + link2 z - link4 z) *
              z.unary.Y ^ 2) := by
  have h := modular_signedLink3_certificate z
  simp only [signedLink3Differential,
    combinedVectorField,
    JacobiState.combinedVectorField,
    JacobiState.ellipticVectorField,
    modularVectorField] at h ⊢
  linear_combination κPhi * h

end LinkedJacobiState

end

end HGAS.Modular
