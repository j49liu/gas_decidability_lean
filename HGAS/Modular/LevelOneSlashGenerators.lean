import Mathlib.NumberTheory.ModularForms.Identities
import Mathlib.NumberTheory.ModularForms.LevelOne.Basic
import Mathlib.Tactic

/-!
# Checking level-one slash invariance on `S` and `T`

The integral modular group is generated by the standard matrices `S` and
`T`.  This file packages that group-theoretic fact in the exact form used
when constructing modular forms from explicit theta formulas.

The argument is independent of theta functions and is useful for any
explicit level-one modular-form calculation.  It is adapted from the
auxiliary slash-action development in `Sphere-Packing-Lean`; the generator
theorem itself is Mathlib's `SpecialLinearGroup.SL2Z_generators`.
-/

namespace HGAS.Modular

open scoped MatrixGroups ModularForm
open Matrix UpperHalfPlane ModularGroup
open ModularForm

noncomputable section

/-- Explicit formula for the weight-`k` slash action of `S`. -/
theorem modularSlashS_apply
    (f : ℍ → ℂ) (k : ℤ) (z : ℍ) :
    (f ∣[k] S) z =
      f (UpperHalfPlane.mk (-z)⁻¹ z.im_inv_neg_coe_pos) *
        z ^ (-k) := by
  exact SlashInvariantForm.slash_S_apply f k z

/-- Explicit formula for the weight-`k` slash action of `T`. -/
theorem modularSlashT_apply
    (f : ℍ → ℂ) (k : ℤ) (z : ℍ) :
    (f ∣[k] T) z = f ((1 : ℝ) +ᵥ z) := by
  rw [SL_slash_apply, denom,
    UpperHalfPlane.modular_T_smul]
  simp [T]

/-- For even weight, the central matrix `-I` acts trivially. -/
theorem slashNegOne_of_even
    (f : ℍ → ℂ) {k : ℤ} (hk : Even k) :
    f ∣[k] (-1 : SL(2, ℤ)) = f := by
  simp [SL_slash_def, denom, hk.neg_one_zpow]

/-- A function fixed by `S` and `T` is fixed by every integral
determinant-one matrix. -/
theorem slashInvariant_of_S_T
    (f : ℍ → ℂ) (k : ℤ)
    (hS : f ∣[k] S = f)
    (hT : f ∣[k] T = f) :
    ∀ γ : SL(2, ℤ), f ∣[k] γ = f := by
  exact
    SlashInvariantForm.slash_action_generators_SL2Z
      hS hT

/-- The same generator criterion in the real-matrix subgroup used by
Mathlib's level-one modular-form structure. -/
theorem slashInvariantOnLevelOne_of_S_T
    (f : ℍ → ℂ) (k : ℤ)
    (hS : f ∣[k] S = f)
    (hT : f ∣[k] T = f) :
    ∀ γ ∈ 𝒮ℒ, f ∣[k] γ = f := by
  intro γ hγ
  obtain ⟨A, rfl⟩ := MonoidHom.mem_range.mp hγ
  change f ∣[k] A = f
  exact slashInvariant_of_S_T f k hS hT A

end

end HGAS.Modular
