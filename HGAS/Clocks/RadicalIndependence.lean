import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.NumberTheory.Padics.PadicVal.Basic
import Mathlib.NumberTheory.Real.Irrational
import Mathlib.Tactic

/-!
# Rational independence of prime square roots

This module contains the number-theoretic half of the radical-clock lemma.
For a finite family of distinct primes, their positive real square roots
are linearly independent over `ℚ`.  Multiplying the roots by arbitrary
signs therefore preserves independence, and no nonzero integer torus
character annihilates the resulting frequency vector.

The proof is internal.  In particular, it does not assume the existence of
independent sign-change automorphisms of a multiquadratic field.  Instead
it builds the needed quadratic-tower fact by induction.  At each step:

* a `p`-adic parity argument says that a new prime is not a rational square
  times a product of the old primes;
* every element after adjoining one square root is written explicitly as
  `x + y√p`;
* squaring this expression shows that a rational number which becomes a
  square acquires at most the new prime in its square class.

This square-class control prevents every newly adjoined root from lying in
the field generated by its predecessors and yields linear independence.
-/

noncomputable section

open scoped BigOperators
open Set

namespace HGAS.Clocks.RadicalIndependence

/-- Product of the primes in a finite set, regarded as a rational number. -/
def primeProduct (s : Finset ℕ) : ℚ :=
  ∏ p ∈ s, (p : ℚ)

/-- A rational number is supported, modulo rational squares, on `s`. -/
def SquareClassSupported (s : Finset ℕ) (q : ℚ) : Prop :=
  ∃ t : Finset ℕ, t ⊆ s ∧
    ∃ c : ℚ, q = c ^ 2 * primeProduct t

/-- The field generated over `ℚ` by the positive real square roots of the
members of `s`. -/
def radicalField (s : Finset ℕ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ
    ((fun p : ℕ ↦ Real.sqrt (p : ℝ)) '' (s : Set ℕ))

@[simp]
theorem radicalField_empty :
    radicalField ∅ = ⊥ := by
  simp [radicalField]

theorem sqrt_mem_radicalField {s : Finset ℕ} {p : ℕ}
    (hp : p ∈ s) :
    Real.sqrt (p : ℝ) ∈ radicalField s := by
  apply IntermediateField.mem_adjoin_of_mem ℚ
  exact ⟨p, hp, rfl⟩

/-- The `p`-adic valuation of a product of primes different from `p`
vanishes. -/
private theorem padicValRat_primeProduct_eq_zero
    {p : ℕ} (hp : p.Prime)
    {t : Finset ℕ}
    (htprime : ∀ q ∈ t, q.Prime)
    (hpt : p ∉ t) :
    padicValRat p (primeProduct t) = 0 := by
  letI : Fact p.Prime := ⟨hp⟩
  induction t using Finset.induction_on with
  | empty =>
      simp [primeProduct, padicValRat.one]
  | @insert q t hqt ih =>
      have hqp : q ≠ p := by
        intro h
        subst q
        exact hpt (Finset.mem_insert_self p t)
      have hp_not_dvd_q : ¬p ∣ q := by
        intro hdvd
        rcases
            (Nat.dvd_prime
              (htprime q (Finset.mem_insert_self q t))).mp hdvd with
          hpone | hpq
        · exact hp.ne_one hpone
        · exact hqp hpq.symm
      have hqne : (q : ℚ) ≠ 0 := by
        exact_mod_cast (htprime q (Finset.mem_insert_self q t)).ne_zero
      have hprodne : primeProduct t ≠ 0 := by
        unfold primeProduct
        apply Finset.prod_ne_zero_iff.mpr
        intro r hr
        exact_mod_cast
          (htprime r (Finset.mem_insert_of_mem hr)).ne_zero
      have hqval : padicValRat p (q : ℚ) = 0 := by
        rw [padicValRat.of_nat,
          padicValNat.eq_zero_of_not_dvd hp_not_dvd_q]
        simp
      have iht :
          padicValRat p (primeProduct t) = 0 := by
        apply ih
        · intro r hr
          exact htprime r (Finset.mem_insert_of_mem hr)
        · intro hpmem
          exact hpt (Finset.mem_insert_of_mem hpmem)
      rw [primeProduct, Finset.prod_insert hqt]
      change padicValRat p ((q : ℚ) * primeProduct t) = 0
      rw [padicValRat.mul hqne hprodne, hqval, iht, add_zero]

/-- A prime outside `s` cannot be a rational square times a product of
primes from `s`.  This is the parity obstruction used at every stage of
the quadratic tower. -/
theorem prime_not_squareClassSupported
    {s : Finset ℕ} {p : ℕ}
    (hp : p.Prime)
    (hsprime : ∀ q ∈ s, q.Prime)
    (hps : p ∉ s) :
    ¬SquareClassSupported s (p : ℚ) := by
  rintro ⟨t, hts, c, hc⟩
  have htprime : ∀ q ∈ t, q.Prime :=
    fun q hq ↦ hsprime q (hts hq)
  have hpt : p ∉ t := fun h ↦ hps (hts h)
  have hcne : c ≠ 0 := by
    intro hczero
    subst c
    simp [hp.ne_zero] at hc
  have hprodne : primeProduct t ≠ 0 := by
    unfold primeProduct
    apply Finset.prod_ne_zero_iff.mpr
    intro q hq
    exact_mod_cast (htprime q hq).ne_zero
  letI : Fact p.Prime := ⟨hp⟩
  have hval := congrArg (padicValRat p) hc
  rw [padicValRat.self hp.one_lt,
    padicValRat.mul (pow_ne_zero 2 hcne) hprodne,
    padicValRat.pow hcne,
    padicValRat_primeProduct_eq_zero hp htprime hpt] at hval
  omega

/-! ## One explicit quadratic adjunction step -/

/-- Every element obtained by adjoining one square root to an intermediate
field has the expected form `x + y r`.

The inverse calculation is included explicitly.  The assumption `r ∉ L`
ensures that the conjugate of a nonzero `x + yr` is nonzero, so the usual
quadratic denominator can be inverted inside `L`. -/
private theorem exists_quadratic_representation
    (L : IntermediateField ℚ ℝ)
    {r a : ℝ}
    (hrsq : r ^ 2 = a)
    (ha : a ∈ L)
    (hrnot : r ∉ L)
    (S : Set ℝ) (hS : S ⊆ L)
    {z : ℝ}
    (hz : z ∈ IntermediateField.adjoin ℚ (insert r S)) :
    ∃ x y : ℝ, x ∈ L ∧ y ∈ L ∧ z = x + y * r := by
  let P : (z : ℝ) →
      z ∈ IntermediateField.adjoin ℚ (insert r S) → Prop :=
    fun z _ ↦ ∃ x y : ℝ, x ∈ L ∧ y ∈ L ∧ z = x + y * r
  apply IntermediateField.adjoin_induction ℚ
    (s := insert r S) (p := P) at hz
  · exact hz
  · intro z hz
    rcases hz with rfl | hz
    · exact ⟨0, 1, L.zero_mem, L.one_mem, by ring⟩
    · exact ⟨z, 0, hS hz, L.zero_mem, by ring⟩
  · intro q
    exact ⟨algebraMap ℚ ℝ q, 0,
      L.algebraMap_mem q, L.zero_mem, by ring⟩
  · intro x y _ _ hx hy
    rcases hx with ⟨x₀, x₁, hx₀, hx₁, rfl⟩
    rcases hy with ⟨y₀, y₁, hy₀, hy₁, rfl⟩
    exact ⟨x₀ + y₀, x₁ + y₁, L.add_mem hx₀ hy₀,
      L.add_mem hx₁ hy₁, by ring⟩
  · intro z _ hzrep
    rcases hzrep with ⟨x, y, hx, hy, rfl⟩
    by_cases hzero : x + y * r = 0
    · exact ⟨0, 0, L.zero_mem, L.zero_mem, by simp [hzero]⟩
    · have hconj : x - y * r ≠ 0 := by
        intro hconjzero
        by_cases hyzero : y = 0
        · subst y
          simp only [zero_mul, sub_zero] at hconjzero
          subst x
          simp at hzero
        · apply hrnot
          have hrdiv : r = x / y := by
            apply (eq_div_iff hyzero).2
            nlinarith
          rw [hrdiv]
          exact L.div_mem hx hy
      let D : ℝ := x ^ 2 - y ^ 2 * a
      have hDmem : D ∈ L := by
        exact L.sub_mem (L.pow_mem hx 2)
          (L.mul_mem (L.pow_mem hy 2) ha)
      have hproduct :
          (x + y * r) * (x - y * r) = D := by
        dsimp only [D]
        rw [← hrsq]
        ring
      have hDne : D ≠ 0 := by
        rw [← hproduct]
        exact mul_ne_zero hzero hconj
      refine ⟨x / D, -y / D,
        L.div_mem hx hDmem,
        L.div_mem (L.neg_mem hy) hDmem, ?_⟩
      apply inv_eq_of_mul_eq_one_right
      field_simp [D, hDne]
      simpa only [sub_eq_add_neg, neg_mul] using hproduct
  · intro x y _ _ hx hy
    rcases hx with ⟨x₀, x₁, hx₀, hx₁, rfl⟩
    rcases hy with ⟨y₀, y₁, hy₀, hy₁, rfl⟩
    refine
      ⟨x₀ * y₀ + x₁ * y₁ * a,
        x₀ * y₁ + x₁ * y₀,
        L.add_mem (L.mul_mem hx₀ hy₀)
          (L.mul_mem (L.mul_mem hx₁ hy₁) ha),
        L.add_mem (L.mul_mem hx₀ hy₁) (L.mul_mem hx₁ hy₀), ?_⟩
    rw [← hrsq]
    ring

/-! ## Square classes in the finite radical tower -/

/-- If a rational number becomes a square in the field generated by
finitely many prime square roots, then its rational square class is a
product of a subset of those primes.

This is the quadratic-tower substitute for invoking sign-change
automorphisms. -/
theorem squareClassSupported_of_sq_mem_radicalField
    (s : Finset ℕ)
    (hsprime : ∀ p ∈ s, p.Prime)
    {q : ℚ} {z : ℝ}
    (hz : z ∈ radicalField s)
    (hzsq : z ^ 2 = (q : ℝ)) :
    SquareClassSupported s q := by
  induction s using Finset.induction_on generalizing q z with
  | empty =>
      rw [radicalField_empty, IntermediateField.mem_bot] at hz
      obtain ⟨c, hc⟩ := hz
      refine ⟨∅, Finset.empty_subset _, c, ?_⟩
      simp only [primeProduct, Finset.prod_empty, mul_one]
      apply Rat.cast_injective (α := ℝ)
      simpa only [Rat.cast_pow] using
        (hc.symm ▸ hzsq).symm
  | @insert p s hps ih =>
      have hp : p.Prime :=
        hsprime p (Finset.mem_insert_self p s)
      have hsprime' : ∀ r ∈ s, r.Prime :=
        fun r hr ↦ hsprime r (Finset.mem_insert_of_mem hr)
      let L : IntermediateField ℚ ℝ := radicalField s
      let r : ℝ := Real.sqrt (p : ℝ)
      have hrsq : r ^ 2 = (p : ℝ) := by
        exact Real.sq_sqrt (Nat.cast_nonneg p)
      have hpL : (p : ℝ) ∈ L := by
        change (p : ℝ) ∈ radicalField s
        exact (radicalField s).algebraMap_mem (p : ℚ)
      have hrnot : r ∉ L := by
        intro hrmem
        have hsupp :
            SquareClassSupported s (p : ℚ) :=
          ih hsprime' hrmem (by
            simpa only [Rat.cast_natCast] using hrsq)
        exact
          (prime_not_squareClassSupported hp hsprime' hps) hsupp
      let S : Set ℝ :=
        (fun n : ℕ ↦ Real.sqrt (n : ℝ)) '' (s : Set ℕ)
      have hSL : S ⊆ L := by
        intro x hx
        exact IntermediateField.mem_adjoin_of_mem ℚ hx
      have hz' :
          z ∈ IntermediateField.adjoin ℚ (insert r S) := by
        simpa only [radicalField, r, S,
          Finset.coe_insert, Set.image_insert_eq] using hz
      obtain ⟨x, y, hxL, hyL, hxy⟩ :=
        exists_quadratic_representation
          L hrsq hpL hrnot S hSL hz'
      have hconstant :
          (q : ℝ) - (x ^ 2 + y ^ 2 * (p : ℝ)) ∈ L := by
        apply L.sub_mem
        · exact L.algebraMap_mem q
        · exact L.add_mem (L.pow_mem hxL 2)
            (L.mul_mem (L.pow_mem hyL 2) hpL)
      have hcoefficient : (2 * x * y : ℝ) ∈ L := by
        exact L.mul_mem
          (L.mul_mem (L.algebraMap_mem (2 : ℚ)) hxL)
          hyL
      have hcross :
          (2 * x * y) * r =
            (q : ℝ) - (x ^ 2 + y ^ 2 * (p : ℝ)) := by
        rw [hxy] at hzsq
        rw [← hrsq]
        nlinarith
      have hxyzero : x * y = 0 := by
        by_contra hxyne
        apply hrnot
        have hcoeffne : (2 * x * y : ℝ) ≠ 0 := by
          intro h
          apply hxyne
          nlinarith
        have hrdiv :
            r =
              ((q : ℝ) - (x ^ 2 + y ^ 2 * (p : ℝ))) /
                (2 * x * y) := by
          apply (eq_div_iff hcoeffne).2
          simpa only [mul_comm, mul_left_comm, mul_assoc] using hcross
        rw [hrdiv]
        exact L.div_mem hconstant hcoefficient
      rcases mul_eq_zero.mp hxyzero with hxzero | hyzero
      · subst x
        have hysq :
            y ^ 2 = ((q / p : ℚ) : ℝ) := by
          rw [hxy] at hzsq
          simp only [zero_add] at hzsq
          rw [div_eq_mul_inv, Rat.cast_mul, Rat.cast_inv,
            Rat.cast_natCast, ← hzsq, mul_pow, hrsq]
          field_simp [hp.ne_zero]
        obtain ⟨t, hts, c, hc⟩ :=
          ih hsprime' hyL hysq
        have hpt : p ∉ t := fun hpt ↦ hps (hts hpt)
        refine ⟨insert p t, Finset.insert_subset_insert p hts,
          c, ?_⟩
        rw [primeProduct, Finset.prod_insert hpt]
        change q = c ^ 2 * ((p : ℚ) * primeProduct t)
        field_simp [hp.ne_zero] at hc ⊢
        nlinarith
      · subst y
        obtain ⟨t, hts, c, hc⟩ :=
          ih hsprime' hxL (by
            rw [hxy] at hzsq
            simpa using hzsq)
        exact ⟨t, hts.trans (Finset.subset_insert p s), c, hc⟩

/-- A new prime square root is not contained in the field generated by
any finite set of different prime square roots. -/
theorem sqrt_prime_not_mem_radicalField
    {s : Finset ℕ} {p : ℕ}
    (hp : p.Prime)
    (hsprime : ∀ q ∈ s, q.Prime)
    (hps : p ∉ s) :
    Real.sqrt (p : ℝ) ∉ radicalField s := by
  intro hmem
  have hsupp :
      SquareClassSupported s (p : ℚ) :=
    squareClassSupported_of_sq_mem_radicalField s hsprime hmem
      (by
        simpa only [Rat.cast_natCast] using
          Real.sq_sqrt (Nat.cast_nonneg p))
  exact (prime_not_squareClassSupported hp hsprime hps) hsupp

/-! ## Linear relations among the prime roots -/

/-- A rational linear relation among the roots indexed by a prime finset
has only zero coefficients. -/
theorem sum_rat_mul_sqrt_eq_zero
    (s : Finset ℕ)
    (hsprime : ∀ p ∈ s, p.Prime)
    (c : ℕ → ℚ)
    (hrelation :
      ∑ p ∈ s, (c p : ℝ) * Real.sqrt (p : ℝ) = 0) :
    ∀ p ∈ s, c p = 0 := by
  induction s using Finset.induction_on with
  | empty =>
      simp
  | @insert p s hps ih =>
      have hp : p.Prime :=
        hsprime p (Finset.mem_insert_self p s)
      have hsprime' : ∀ q ∈ s, q.Prime :=
        fun q hq ↦ hsprime q (Finset.mem_insert_of_mem hq)
      have hrelation' :
          (c p : ℝ) * Real.sqrt (p : ℝ) +
              ∑ q ∈ s, (c q : ℝ) * Real.sqrt (q : ℝ) = 0 := by
        simpa only [Finset.sum_insert hps] using hrelation
      have hcp : c p = 0 := by
        by_contra hcp
        have hcpreal : (c p : ℝ) ≠ 0 := by
          exact_mod_cast hcp
        let tail : ℝ :=
          ∑ q ∈ s, (c q : ℝ) * Real.sqrt (q : ℝ)
        have htail : tail ∈ radicalField s := by
          dsimp only [tail]
          apply (radicalField s).sum_mem
          intro q hq
          exact (radicalField s).mul_mem
            ((radicalField s).algebraMap_mem (c q))
            (sqrt_mem_radicalField hq)
        have hsqrt :
            Real.sqrt (p : ℝ) = -tail / (c p : ℝ) := by
          apply (eq_div_iff hcpreal).2
          dsimp only [tail]
          nlinarith
        apply
          sqrt_prime_not_mem_radicalField hp hsprime' hps
        rw [hsqrt]
        exact (radicalField s).div_mem
          ((radicalField s).neg_mem htail)
          ((radicalField s).algebraMap_mem (c p))
      intro q hq
      rcases Finset.mem_insert.mp hq with rfl | hqs
      · exact hcp
      · apply ih hsprime'
        · simpa only [hcp, Rat.cast_zero, zero_mul, zero_add] using
            hrelation'
        · exact hqs

/-- The positive square roots indexed by a finite set of primes are
linearly independent over `ℚ`. -/
theorem linearIndependent_sqrt_primes_finset
    (s : Finset ℕ)
    (hsprime : ∀ p ∈ s, p.Prime) :
    LinearIndependent ℚ
      (fun p : ↥s ↦ Real.sqrt (p : ℝ)) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg p
  let c : ℕ → ℚ :=
    fun n ↦ if hn : n ∈ s then g ⟨n, hn⟩ else 0
  have hsum :
      ∑ n ∈ s, (c n : ℝ) * Real.sqrt (n : ℝ) = 0 := by
    calc
      ∑ n ∈ s, (c n : ℝ) * Real.sqrt (n : ℝ) =
          ∑ n : ↥s, (g n : ℝ) * Real.sqrt (n : ℝ) := by
        symm
        calc
          ∑ n : ↥s, (g n : ℝ) * Real.sqrt (n : ℝ) =
              ∑ n : ↥s, (c n : ℝ) * Real.sqrt (n : ℝ) := by
            apply Finset.sum_congr rfl
            intro n _
            simp only [c, dif_pos n.property]
          _ = ∑ n ∈ s, (c n : ℝ) * Real.sqrt (n : ℝ) :=
            Finset.sum_coe_sort s
              (fun n : ℕ ↦
                (c n : ℝ) * Real.sqrt (n : ℝ))
      _ = 0 := by
        simpa only [smul_eq_mul] using hg
  have hc :=
    sum_rat_mul_sqrt_eq_zero s hsprime c hsum
  simpa only [c, dif_pos p.property] using
    hc p p.property

/-- Finite injective families of primes have rationally independent
positive real square roots. -/
theorem linearIndependent_sqrt_primes
    {ι : Type*} [Finite ι]
    (p : ι → ℕ)
    (hp : ∀ i : ι, (p i).Prime)
    (hinjective : Function.Injective p) :
    LinearIndependent ℚ
      (fun i : ι ↦ Real.sqrt (p i : ℝ)) := by
  classical
  letI := Fintype.ofFinite ι
  let s : Finset ℕ := Finset.univ.image p
  have hsprime : ∀ q ∈ s, q.Prime := by
    intro q hq
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hq
    exact hp i
  have hs :=
    linearIndependent_sqrt_primes_finset s hsprime
  let e : ι → ↥s :=
    fun i ↦ ⟨p i, Finset.mem_image.mpr
      ⟨i, Finset.mem_univ i, rfl⟩⟩
  have he : Function.Injective e := by
    intro i j hij
    apply hinjective
    exact congrArg Subtype.val hij
  simpa only [Function.comp_apply, e] using
    hs.comp e he

/-- Multiplying each prime root by an arbitrary nonzero rational scalar
preserves rational linear independence. -/
theorem linearIndependent_rat_mul_sqrt_primes
    {ι : Type*} [Finite ι]
    (p : ι → ℕ)
    (hp : ∀ i : ι, (p i).Prime)
    (hinjective : Function.Injective p)
    (u : ι → ℚ) (hu : ∀ i, u i ≠ 0) :
    LinearIndependent ℚ
      (fun i : ι ↦ (u i : ℝ) * Real.sqrt (p i : ℝ)) := by
  letI := Fintype.ofFinite ι
  have hbase :=
    linearIndependent_sqrt_primes p hp hinjective
  rw [Fintype.linearIndependent_iff] at hbase ⊢
  intro g hg i
  have hscaled :
      ∑ j : ι, (g j * u j) •
          Real.sqrt (p j : ℝ) = 0 := by
    change
      (∑ j : ι,
        (((g j * u j : ℚ) : ℝ) *
          Real.sqrt (p j : ℝ))) = 0
    change
      (∑ j : ι,
        (g j : ℝ) *
          ((u j : ℝ) * Real.sqrt (p j : ℝ))) = 0 at hg
    simpa only [Rat.cast_mul, mul_assoc] using hg
  have hzero := hbase (fun j ↦ g j * u j) hscaled i
  exact (mul_eq_zero.mp hzero).resolve_right (hu i)

/-- Signed radical frequency vector.  The sign is stored as an integer so
that it matches torus-character conventions downstream. -/
def signedPrimeSqrtFrequency
    {ι : Type*} (p : ι → ℕ) (sign : ι → ℤ) : ι → ℝ :=
  fun i ↦ (sign i : ℝ) * Real.sqrt (p i : ℝ)

/-- Arbitrary choices of signs `±1` preserve rational independence of a
finite injective prime-root family. -/
theorem linearIndependent_signedPrimeSqrtFrequency
    {ι : Type*} [Finite ι]
    (p : ι → ℕ)
    (hp : ∀ i : ι, (p i).Prime)
    (hinjective : Function.Injective p)
    (sign : ι → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1) :
    LinearIndependent ℚ
      (signedPrimeSqrtFrequency p sign) := by
  letI := Fintype.ofFinite ι
  have hnonzero : ∀ i, (sign i : ℚ) ≠ 0 := by
    intro i
    rcases hsign i with hi | hi <;> simp [hi]
  simpa only [signedPrimeSqrtFrequency, Rat.cast_intCast] using
    linearIndependent_rat_mul_sqrt_primes
      p hp hinjective (fun i ↦ (sign i : ℚ)) hnonzero

/-- A frequency vector has no nonzero annihilating integer character when
the only integer coefficient vector with zero dot product is zero. -/
def HasNoNontrivialIntegerCharacter
    {ι : Type*} [Fintype ι] (ω : ι → ℝ) : Prop :=
  ∀ k : ι → ℤ,
    (∑ i : ι, (k i : ℝ) * ω i) = 0 → k = 0

/-- No nonzero integer torus character annihilates a signed vector of
square roots of distinct primes. -/
theorem signedPrimeSqrtFrequency_hasNoNontrivialIntegerCharacter
    {ι : Type*} [Fintype ι]
    (p : ι → ℕ)
    (hp : ∀ i : ι, (p i).Prime)
    (hinjective : Function.Injective p)
    (sign : ι → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1) :
    HasNoNontrivialIntegerCharacter
      (signedPrimeSqrtFrequency p sign) := by
  intro k hk
  have hLI :=
    linearIndependent_signedPrimeSqrtFrequency
      p hp hinjective sign hsign
  have hrat :
      ∑ i : ι, (k i : ℚ) •
          signedPrimeSqrtFrequency p sign i = 0 := by
    simpa only [smul_eq_mul, Rat.cast_intCast] using hk
  have hkzero :=
    (Fintype.linearIndependent_iff.mp hLI)
      (fun i ↦ (k i : ℚ)) hrat
  funext i
  change k i = 0
  have hi : (k i : ℚ) = 0 := by
    simpa using hkzero i
  exact_mod_cast hi

end HGAS.Clocks.RadicalIndependence
