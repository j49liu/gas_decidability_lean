import HGAS.Analysis.MvPolynomialCalculus
import HGAS.Clocks.ControllerPhaseProductSphereFlow
import HGAS.Dynamics.C1CompactlySupportedFlow
import HGAS.Dynamics.InvariantFullMeasureRestriction
import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension
import Mathlib.Analysis.ODE.Gronwall
import Mathlib.Tactic

/-!
# A `C¹` ambient ODE flow for the finite clock product

The literal controller--phase compiler emits a polynomial vector field on
`ℝ^(4q)`.  Its canonical analytic realization lives on the compact
algebraic subspace `ClockProductSphere q`, but the generator criterion for
invariant measures is formulated for a complete `C¹` ODE flow on the whole
finite-dimensional vector space.

This file constructs that ambient target.  We multiply the polynomial
field by a smooth compactly supported bump which is one on the closed unit
ball.  Every point of `ClockProductSphere q` has sup norm at most one, so
the cutoff does not change the field there.  The general compact-support
theorem then gives a complete `C1ODEFlow`.

Finally, global ODE uniqueness identifies the ambient cutoff orbit starting
at a clock-sphere point with the already constructed canonical clock-sphere
orbit.  Thus the subtype inclusion is an exact equal-time semiconjugacy,
not merely an infinitesimal correspondence.
-/

noncomputable section

open Function MeasureTheory Metric Set
open scoped NNReal Topology

namespace HGAS.Clocks.ControllerPhaseProductC1CutoffFlow

open HGAS
open HGAS.Dynamics
open HGAS.Clocks.ControllerPhaseProductSphereFlow

variable {q : ℕ}

local instance : MeasurableSpace Circle :=
  borel Circle

local instance : BorelSpace Circle :=
  ⟨rfl⟩

/-- The ambient finite-dimensional real clock-coordinate space. -/
abbrev ClockAmbient (q : ℕ) :=
  Fin (ControllerPhaseProductPolynomialCode.dimension q) → ℝ

/-- The raw finite-product polynomial clock field. -/
def rawClockField
    (pCode : Fin q → RationalCode) :
    ClockAmbient q → ClockAmbient q :=
  PolynomialFieldCode.realize
    (ControllerPhaseProductPolynomialCode.fieldCode pCode)

/-- The raw clock field is smooth on the whole ambient coordinate space. -/
theorem contDiff_rawClockField
    (pCode : Fin q → RationalCode) :
    ContDiff ℝ ⊤ (rawClockField pCode) := by
  rw [contDiff_pi]
  intro i
  have hfun :
      (fun x ↦ rawClockField pCode x i) =
        ratMvPolynomialEval
          (PolynomialCode.decode
            (ControllerPhaseProductPolynomialCode.fieldCode pCode i)) := by
    funext x
    simp only [rawClockField, PolynomialFieldCode.realize_apply]
    simp [ratMvPolynomialEval, MvPolynomial.eval_map]
  rw [hfun]
  exact contDiff_ratMvPolynomialEval _

/-- A smooth bump equal to one on the closed unit ball and zero outside a
slightly larger ball. -/
noncomputable def clockProductBump :
    ContDiffBump (0 : ClockAmbient q) where
  rIn := 1
  rOut := 2
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

/-- Compactly supported replacement of the raw product clock field. -/
def cutoffClockField
    (pCode : Fin q → RationalCode) :
    ClockAmbient q → ClockAmbient q :=
  fun x ↦ clockProductBump (q := q) x • rawClockField pCode x

theorem contDiff_cutoffClockField
    (pCode : Fin q → RationalCode) :
    ContDiff ℝ 2 (cutoffClockField pCode) := by
  exact (clockProductBump (q := q)).contDiff.smul
    ((contDiff_rawClockField pCode).of_le le_top)

theorem hasCompactSupport_cutoffClockField
    (pCode : Fin q → RationalCode) :
    HasCompactSupport (cutoffClockField pCode) := by
  exact
    (clockProductBump (q := q)).hasCompactSupport.smul_right

/-- The complete jointly `C¹` ambient ODE flow generated by the cutoff
clock field. -/
def ambientClockC1ODEFlow
    (pCode : Fin q → RationalCode) :
    C1ODEFlow (ClockAmbient q) :=
  c1ODEFlowOfCompactSupportC2
    (cutoffClockField pCode)
    (contDiff_cutoffClockField pCode)
    (hasCompactSupport_cutoffClockField pCode)

@[simp]
theorem ambientClockC1ODEFlow_generator
    (pCode : Fin q → RationalCode) :
    (ambientClockC1ODEFlow pCode).generator =
      cutoffClockField pCode :=
  rfl

/-! ## The cutoff is invisible on the clock sphere -/

private theorem abs_le_one_of_mul_self_add_mul_self_eq_one
    {u v : ℝ} (h : u * u + v * v = 1) :
    |u| ≤ 1 := by
  rw [abs_le]
  constructor <;>
    nlinarith [sq_nonneg u, sq_nonneg v]

/-- Every literal clock-sphere point lies in the closed unit ball for the
ambient sup norm. -/
theorem norm_clockSphere_coe_le_one
    (x : ClockProductSphere q) :
    ‖(x.1 : ClockAmbient q)‖ ≤ 1 := by
  rw [Pi.norm_def]
  norm_cast
  apply Finset.sup_le
  intro k hk
  norm_cast
  obtain ⟨⟨a, i⟩, rfl⟩ :=
    finProdFinEquiv.surjective k
  have hcontroller := (x.2 a).1
  have hphase := (x.2 a).2
  fin_cases i
  · change
      |x.1
          (ControllerPhaseProductPolynomialCode.blockEmbedding
            a ControllerPolynomialCode.rIndex)| ≤ 1
    apply abs_le_one_of_mul_self_add_mul_self_eq_one
        (v :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.sIndex))
    simpa [Controller.controllerRadiusSq, pow_two,
      ControllerPhaseProductPolynomialCode.state,
      ControllerPolynomialCode.state,
      PolynomialFiniteProductCode.unflattenPoint] using
      hcontroller
  · change
      |x.1
          (ControllerPhaseProductPolynomialCode.blockEmbedding
            a ControllerPolynomialCode.sIndex)| ≤ 1
    apply abs_le_one_of_mul_self_add_mul_self_eq_one
        (u :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.sIndex))
        (v :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.rIndex))
    simpa [Controller.controllerRadiusSq, pow_two,
      ControllerPhaseProductPolynomialCode.state,
      ControllerPolynomialCode.state,
      PolynomialFiniteProductCode.unflattenPoint, add_comm] using
      hcontroller
  · change
      |x.1
          (ControllerPhaseProductPolynomialCode.blockEmbedding
            a ControllerPolynomialCode.cIndex)| ≤ 1
    apply abs_le_one_of_mul_self_add_mul_self_eq_one
        (v :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.dIndex))
    simpa [Controller.phaseRadiusSq, pow_two,
      ControllerPhaseProductPolynomialCode.state,
      ControllerPolynomialCode.state,
      PolynomialFiniteProductCode.unflattenPoint] using
      hphase
  · change
      |x.1
          (ControllerPhaseProductPolynomialCode.blockEmbedding
            a ControllerPolynomialCode.dIndex)| ≤ 1
    apply abs_le_one_of_mul_self_add_mul_self_eq_one
        (u :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.dIndex))
        (v :=
          x.1
            (ControllerPhaseProductPolynomialCode.blockEmbedding
              a ControllerPolynomialCode.cIndex))
    simpa [Controller.phaseRadiusSq, pow_two,
      ControllerPhaseProductPolynomialCode.state,
      ControllerPolynomialCode.state,
      PolynomialFiniteProductCode.unflattenPoint, add_comm] using
      hphase

/-- The clock cutoff equals one at every literal clock-sphere point. -/
theorem clockProductBump_eq_one_on_sphere
    (x : ClockProductSphere q) :
    clockProductBump (q := q) x.1 = 1 := by
  apply (clockProductBump (q := q)).one_of_mem_closedBall
  simpa [Metric.mem_closedBall, dist_zero_right] using
    norm_clockSphere_coe_le_one x

/-- The ambient cutoff generator agrees exactly with the raw compiler field
on the literal clock sphere. -/
theorem cutoffClockField_eq_raw_on_sphere
    (pCode : Fin q → RationalCode)
    (x : ClockProductSphere q) :
    cutoffClockField pCode x.1 =
      rawClockField pCode x.1 := by
  simp [cutoffClockField,
    clockProductBump_eq_one_on_sphere x]

/-- Generator form of exact agreement on the literal clock sphere. -/
theorem ambientClockC1ODEFlow_generator_eq_raw_on_sphere
    (pCode : Fin q → RationalCode)
    (x : ClockProductSphere q) :
    (ambientClockC1ODEFlow pCode).generator x.1 =
      PolynomialFieldCode.realize
        (ControllerPhaseProductPolynomialCode.fieldCode pCode)
        x.1 := by
  rw [ambientClockC1ODEFlow_generator,
    cutoffClockField_eq_raw_on_sphere]
  rfl

/-! ## Identification of the ambient and compact clock orbits -/

/-- An ambient cutoff orbit starting on the literal clock sphere is exactly
the ambient-coordinate curve of the canonical compact clock flow. -/
theorem ambientClockFlow_eq_clockSphereFlow_coe
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ))
    (x : ClockProductSphere q) (t : ℝ) :
    (ambientClockC1ODEFlow pCode).flow t x.1 =
      (clockSphereFlow
        (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
        hp t x).1 := by
  let p : Fin q → ℝ :=
    fun a ↦ (RationalCode.decode (pCode a) : ℝ)
  let γambient : ℝ → ClockAmbient q :=
    fun s ↦ (ambientClockC1ODEFlow pCode).flow s x.1
  let γsphere : ℝ → ClockAmbient q :=
    fun s ↦ (clockSphereFlow p hp s x).1
  have hambient :
      IsIntegralCurve γambient
        (fun _ ↦ cutoffClockField pCode) := by
    intro s
    simpa only [γambient, ambientClockC1ODEFlow_generator] using
      (ambientClockC1ODEFlow pCode).generatorODE x.1 s
  have hsphereRaw :
      IsIntegralCurve γsphere
        (fun _ ↦ rawClockField pCode) := by
    simpa only [γsphere, p, rawClockField] using
      clockSphereFlow_isIntegralCurve pCode hp x
  have hsphere :
      IsIntegralCurve γsphere
        (fun _ ↦ cutoffClockField pCode) := by
    intro s
    have hfield :=
      cutoffClockField_eq_raw_on_sphere
        pCode (clockSphereFlow p hp s x)
    simpa only [γsphere, hfield] using hsphereRaw s
  obtain ⟨K, hK⟩ :=
    ContDiff.lipschitzWith_of_hasCompactSupport
      (hasCompactSupport_cutoffClockField pCode)
      (contDiff_cutoffClockField pCode)
      (by norm_num)
  have hcurves : γambient = γsphere := by
    apply ODE_solution_unique_univ
        (v := fun _ : ℝ ↦ cutoffClockField pCode)
        (s := fun _ : ℝ ↦ Set.univ)
        (K := K) (t₀ := 0)
    · intro _
      exact hK.lipschitzOnWith
    · intro s
      exact ⟨hambient s, Set.mem_univ _⟩
    · intro s
      exact ⟨hsphere s, Set.mem_univ _⟩
    · simp [γambient, γsphere]
  exact congrFun hcurves t

/-- The inclusion of the literal clock sphere into ambient coordinates is
an exact equal-time semiconjugacy into the cutoff `C¹` ODE flow. -/
theorem subtypeVal_semiconj_ambientClockFlow
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ))
    (t : ℝ) :
    Function.Semiconj
      ((↑) : ClockProductSphere q → ClockAmbient q)
      (clockSphereFlow
        (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
        hp t)
      ((ambientClockC1ODEFlow pCode).flow t) := by
  intro x
  exact
    (ambientClockFlow_eq_clockSphereFlow_coe
      pCode hp x t).symm

/-! ## The sphere as an invariant measurable ambient set -/

/-- The literal clock variety as a subset of the ambient coordinate
space. -/
def clockSphereSet (q : ℕ) : Set (ClockAmbient q) :=
  {x | OnClockCircles x}

/-- The literal clock variety is closed in ambient coordinates. -/
theorem isClosed_clockSphereSet :
    IsClosed (clockSphereSet q) := by
  have hrange :
      Set.range
          ((↑) : ClockProductSphere q → ClockAmbient q) =
        clockSphereSet q := by
    ext x
    simp [clockSphereSet]
  rw [← hrange]
  exact (isCompact_range continuous_subtype_val).isClosed

theorem measurableSet_clockSphereSet :
    MeasurableSet (clockSphereSet q) :=
  isClosed_clockSphereSet.measurableSet

/-- The ambient cutoff flow preserves the literal clock variety. -/
theorem isInvariant_clockSphereSet
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ)) :
    IsInvariant
      (ambientClockC1ODEFlow pCode).flow
      (clockSphereSet q) := by
  intro t y hy
  let x : ClockProductSphere q :=
    ⟨y, hy⟩
  change OnClockCircles
    ((ambientClockC1ODEFlow pCode).flow t y)
  rw [ambientClockFlow_eq_clockSphereFlow_coe
    pCode hp x t]
  exact
    (clockSphereFlow
      (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
      hp t x).2

/-! ## Transfer of invariant probabilities

The preceding orbit identity identifies the restriction of the ambient
flow to the literal variety with the canonical compact clock flow.  This
lets us pass invariant probabilities in either direction.  In the reverse
direction we must explicitly assume that the ambient probability gives
the variety full mass; no hidden support assertion is used.
-/

/-- Restricting the ambient cutoff flow to the literal clock variety gives
exactly the canonical compact clock flow. -/
theorem restrict_ambientClockFlow_eq_clockSphereFlow
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ)) :
    (ambientClockC1ODEFlow pCode).flow.restrict
        (isInvariant_clockSphereSet pCode hp) =
      clockSphereFlow
        (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
        hp := by
  apply Flow.ext
  intro t x
  apply Subtype.ext
  exact ambientClockFlow_eq_clockSphereFlow_coe
    pCode hp x t

/-- Embed an invariant probability of the canonical compact clock flow into
the ambient cutoff ODE by the subtype inclusion. -/
def ambientInvariantOfClockSphere
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ))
    (μ :
      InvariantProbabilityMeasure
        (clockSphereFlow
          (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
          hp)) :
    InvariantProbabilityMeasure
      (ambientClockC1ODEFlow pCode).flow :=
  μ.mapEquivariant
    ((↑) : ClockProductSphere q → ClockAmbient q)
    continuous_subtype_val
    (subtypeVal_semiconj_ambientClockFlow pCode hp)

/-- Restrict an ambient invariant probability of full mass on the clock
variety to the canonical compact clock flow. -/
def clockSphereInvariantOfAmbient
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ))
    (μ :
      InvariantProbabilityMeasure
        (ambientClockC1ODEFlow pCode).flow)
    (hfull :
      (μ.measure : Measure (ClockAmbient q))
          (clockSphereSet q) = 1) :
    InvariantProbabilityMeasure
      (clockSphereFlow
        (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
        hp) := by
  rw [← restrict_ambientClockFlow_eq_clockSphereFlow pCode hp]
  exact
    μ.restrictToFullMeasureInvariant
      measurableSet_clockSphereSet hfull
      (isInvariant_clockSphereSet pCode hp)

/-- Send an ambient invariant probability supported on the literal clock
variety to the original analytic controller--phase flow.  This is the
formal bridge that makes analytic classification theorems applicable to
the compactly supported ambient ODE target. -/
def analyticInvariantOfAmbient
    (pCode : Fin q → RationalCode)
    (hp : ∀ a, (1 : ℝ) <
      (RationalCode.decode (pCode a) : ℝ))
    (μ :
      InvariantProbabilityMeasure
        (ambientClockC1ODEFlow pCode).flow)
    (hfull :
      (μ.measure : Measure (ClockAmbient q))
          (clockSphereSet q) = 1) :
    InvariantProbabilityMeasure
      (ControllerPhaseFlow.controllerPhaseFlow
        (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
        hp) :=
  (clockSphereInvariantOfAmbient pCode hp μ hfull).mapEquivariant
    (ControllerPhaseProductFlowPolynomial.analyticHomeomorph.symm ∘
      clockSphereHomeomorph)
    continuous_toAnalytic
    (toAnalytic_semiconj
      (fun a ↦ (RationalCode.decode (pCode a) : ℝ))
      hp)

end HGAS.Clocks.ControllerPhaseProductC1CutoffFlow
