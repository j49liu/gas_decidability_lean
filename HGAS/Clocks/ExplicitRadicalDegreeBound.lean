import HGAS.Clocks.RadicalSmallDivisor
import Mathlib.Tactic

/-!
# An effective degree bound for finite radical fields

The small-divisor theorem is naturally stated with the exact field degree
`radicalDegree p`.  That degree is a classical `Module.finrank`, so it is
not itself suitable as input to a computable compiler.  This file replaces
it by the elementary explicit bound

```text
                         radicalDegree p ≤ 2^d
```

for a family indexed by a finite type of cardinality `d`.

The proof adjoins the square roots one at a time.  Each simple extension
has degree at most two because `sqrt(q)` satisfies `X²-q`; the degree of a
compositum is at most the product of the two degrees.
-/

noncomputable section

namespace HGAS.Clocks.RadicalSmallDivisor

open HGAS.Clocks.RadicalIndependence

/-- A single real square root generates an extension of degree at most
two over `ℚ`. -/
theorem finrank_adjoin_sqrt_le_two (q : ℕ) :
    Module.finrank ℚ
        (IntermediateField.adjoin ℚ
          ({Real.sqrt (q : ℝ)} : Set ℝ)) ≤ 2 := by
  rw [IntermediateField.adjoin.finrank
    (sqrt_nat_isIntegral_rat q)]
  let f : Polynomial ℚ :=
    Polynomial.X ^ 2 - Polynomial.C (q : ℚ)
  have heval :
      Polynomial.aeval (Real.sqrt (q : ℝ)) f = 0 := by
    simp [f, Real.sq_sqrt (Nat.cast_nonneg q)]
  have hdvd :
      minpoly ℚ (Real.sqrt (q : ℝ)) ∣ f :=
    minpoly.dvd ℚ _ heval
  have hfdegree : f.natDegree = 2 := by
    exact Polynomial.natDegree_X_pow_sub_C
  have hfne : f ≠ 0 := by
    intro h
    rw [h] at hfdegree
    simp at hfdegree
  have hdegree :=
    Polynomial.natDegree_le_of_dvd hdvd hfne
  exact hdegree.trans_eq hfdegree

/-- Adjoining one further square root is the compositum of the old
radical field and the corresponding simple extension. -/
theorem radicalField_insert
    (q : ℕ) (s : Finset ℕ) :
    radicalField (insert q s) =
      radicalField s ⊔
        IntermediateField.adjoin ℚ
          ({Real.sqrt (q : ℝ)} : Set ℝ) := by
  unfold radicalField
  rw [show
      ((fun p : ℕ ↦ Real.sqrt (p : ℝ)) ''
          ((insert q s : Finset ℕ) : Set ℕ)) =
        ((fun p : ℕ ↦ Real.sqrt (p : ℝ)) '' (s : Set ℕ)) ∪
          {Real.sqrt (q : ℝ)} by
    ext x
    simp [eq_comm]]
  rw [IntermediateField.adjoin_union]

/-- A field generated by `r` real square roots has degree at most `2^r`. -/
theorem finrank_radicalField_le_two_pow_card
    (s : Finset ℕ) :
    Module.finrank ℚ (radicalField s) ≤ 2 ^ s.card := by
  induction s using Finset.induction_on with
  | empty =>
      rw [radicalField_empty, IntermediateField.finrank_bot]
      simp
  | @insert q s hqs ih =>
      rw [radicalField_insert]
      calc
        Module.finrank ℚ
            ↥(radicalField s ⊔
              IntermediateField.adjoin ℚ
                ({Real.sqrt (q : ℝ)} : Set ℝ)) ≤
          Module.finrank ℚ (radicalField s) *
            Module.finrank ℚ
              (IntermediateField.adjoin ℚ
                ({Real.sqrt (q : ℝ)} : Set ℝ)) :=
          IntermediateField.finrank_sup_le _ _
        _ ≤ 2 ^ s.card * 2 :=
          Nat.mul_le_mul ih (finrank_adjoin_sqrt_le_two q)
        _ = 2 ^ (insert q s).card := by
          rw [Finset.card_insert_of_notMem hqs]
          simp [pow_succ]

/-- Computable cardinal bound for the exact radical degree. -/
theorem radicalDegree_le_two_pow_card
    {d : Type*} [Fintype d]
    (p : d → ℕ) :
    radicalDegree p ≤ 2 ^ Fintype.card d := by
  unfold radicalDegree IndexedRadicalField
  calc
    Module.finrank ℚ
        (radicalField (indexedPrimeSet p)) ≤
      2 ^ (indexedPrimeSet p).card :=
        finrank_radicalField_le_two_pow_card
          (indexedPrimeSet p)
    _ ≤ 2 ^ Fintype.card d := by
      apply Nat.pow_le_pow_right (by norm_num)
      unfold indexedPrimeSet
      simpa using
        (Finset.card_image_le :
          (Finset.univ.image p).card ≤
            (Finset.univ : Finset d).card)

end HGAS.Clocks.RadicalSmallDivisor
