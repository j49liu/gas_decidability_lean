import HGAS.Clocks.RadicalClock
import Mathlib.NumberTheory.NumberField.House
import Mathlib.NumberTheory.NumberField.Norm
import Mathlib.Tactic

/-!
# Quantitative small divisors for prime-square-root clocks

The qualitative radical-independence theorem says that

```text
  ∑ i, kᵢ √pᵢ
```

is nonzero whenever the `pᵢ` are distinct primes and the integer vector
`k` is nonzero.  Fourier primitives need a quantitative version: the
reciprocal of this linear form may grow only polynomially in the size of
`k`.

The proof here is the standard conjugate-product argument, expressed
through Mathlib's number-field norm.  The linear form is an algebraic
integer in the multiquadratic field generated by the roots.  Its norm is
the product of all field conjugates and is therefore a nonzero integer, so
its absolute value is at least one.  Every conjugate is bounded by the
same weighted `ℓ¹` height.  Removing the distinguished real embedding from
the conjugate product gives the desired lower bound.

The exponent is the degree of the fixed multiquadratic field minus one.
For a fixed finite prime family this is a fixed natural number, which is
the precise polynomial small-divisor statement needed downstream.
-/

noncomputable section

open scoped BigOperators NumberField

namespace HGAS.Clocks.RadicalSmallDivisor

open HGAS.Clocks.RadicalIndependence

/-! ## The finite multiquadratic number field -/

/-- Every square root of a natural number is integral over `ℤ`. -/
theorem sqrt_nat_isIntegral_int (n : ℕ) :
    IsIntegral ℤ (Real.sqrt (n : ℝ)) := by
  refine
    ⟨Polynomial.X ^ 2 - Polynomial.C (n : ℤ),
      Polynomial.monic_X_pow_sub_C (n : ℤ) (by norm_num), ?_⟩
  simp [Real.sq_sqrt (Nat.cast_nonneg n)]

/-- Every square root of a natural number is algebraic over `ℚ`. -/
theorem sqrt_nat_isIntegral_rat (n : ℕ) :
    IsIntegral ℚ (Real.sqrt (n : ℝ)) := by
  refine
    ⟨Polynomial.X ^ 2 - Polynomial.C (n : ℚ),
      Polynomial.monic_X_pow_sub_C (n : ℚ) (by norm_num), ?_⟩
  simp [Real.sq_sqrt (Nat.cast_nonneg n)]

/-- The field generated by finitely many natural square roots is finite
dimensional over `ℚ`. -/
noncomputable instance radicalField_finiteDimensional
    (s : Finset ℕ) :
    FiniteDimensional ℚ (radicalField s) := by
  unfold radicalField
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  rcases hx with ⟨n, _, rfl⟩
  exact sqrt_nat_isIntegral_rat n

/-- A finite radical field is a number field. -/
noncomputable instance radicalField_numberField
    (s : Finset ℕ) :
    NumberField (radicalField s) where
  to_charZero := inferInstance
  to_finiteDimensional := inferInstance

variable {d : Type*} [Fintype d]

/-- The finite set of radicands in an indexed prime family. -/
def indexedPrimeSet (p : d → ℕ) : Finset ℕ :=
  Finset.univ.image p

/-- The number field generated by an indexed family of square roots. -/
abbrev IndexedRadicalField (p : d → ℕ) :=
  radicalField (indexedPrimeSet p)

/-- The `i`-th positive square root as an element of the indexed radical
field. -/
def indexedRadicalRoot (p : d → ℕ) (i : d) :
    IndexedRadicalField p :=
  ⟨Real.sqrt (p i : ℝ), by
    apply sqrt_mem_radicalField
    exact Finset.mem_image.mpr
      ⟨i, Finset.mem_univ i, rfl⟩⟩

@[simp]
theorem indexedRadicalRoot_coe
    (p : d → ℕ) (i : d) :
    (indexedRadicalRoot p i : ℝ) =
      Real.sqrt (p i : ℝ) :=
  rfl

/-- The square of the distinguished radical root is its radicand. -/
theorem indexedRadicalRoot_sq
    (p : d → ℕ) (i : d) :
    indexedRadicalRoot p i ^ 2 = (p i : IndexedRadicalField p) := by
  apply Subtype.ext
  simp [indexedRadicalRoot, Real.sq_sqrt (Nat.cast_nonneg (p i))]

/-- Each distinguished radical root is an algebraic integer in the
multiquadratic field. -/
theorem indexedRadicalRoot_isIntegral
    (p : d → ℕ) (i : d) :
    IsIntegral ℤ (indexedRadicalRoot p i) := by
  refine
    ⟨Polynomial.X ^ 2 - Polynomial.C (p i : ℤ),
      Polynomial.monic_X_pow_sub_C (p i : ℤ) (by norm_num), ?_⟩
  simp [indexedRadicalRoot_sq]

/-- The integer linear form in the fixed radical field. -/
def radicalLinearCombination
    (p : d → ℕ) (k : d → ℤ) :
    IndexedRadicalField p :=
  ∑ i : d, k i • indexedRadicalRoot p i

/-- Evaluation of the field-valued linear form at the distinguished real
embedding is the expected real radical sum. -/
theorem radicalLinearCombination_coe
    (p : d → ℕ) (k : d → ℤ) :
    (radicalLinearCombination p k : ℝ) =
      ∑ i : d, (k i : ℝ) * Real.sqrt (p i : ℝ) := by
  simp [radicalLinearCombination, zsmul_eq_mul]

/-- The radical linear form is an algebraic integer. -/
theorem radicalLinearCombination_isIntegral
    (p : d → ℕ) (k : d → ℤ) :
    IsIntegral ℤ (radicalLinearCombination p k) := by
  unfold radicalLinearCombination
  exact IsIntegral.sum _
    (fun i _ ↦ (indexedRadicalRoot_isIntegral p i).zsmul (k i))

/-- Distinct prime roots give a nonzero field element for every nonzero
integer coefficient vector. -/
theorem radicalLinearCombination_ne_zero
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (k : d → ℤ) (hk : k ≠ 0) :
    radicalLinearCombination p k ≠ 0 := by
  intro hzero
  have hrelation :
      ∑ i : d, (k i : ℚ) • Real.sqrt (p i : ℝ) = 0 := by
    have hreal :=
      congrArg
        (fun x : IndexedRadicalField p ↦ (x : ℝ))
        hzero
    change
      (radicalLinearCombination p k : ℝ) = 0 at hreal
    rw [radicalLinearCombination_coe] at hreal
    simpa only [smul_eq_mul, Rat.cast_intCast] using hreal
  have hLI :=
    linearIndependent_sqrt_primes p hp hinjective
  have hkzero :
      ∀ i, (k i : ℚ) = 0 :=
    (Fintype.linearIndependent_iff.mp hLI)
      (fun i ↦ (k i : ℚ)) hrelation
  apply hk
  funext i
  exact_mod_cast hkzero i

/-! ## Conjugate heights -/

/-- The distinguished embedding of the radical field into `ℂ`, obtained
from its defining inclusion in `ℝ`. -/
def realComplexEmbedding (p : d → ℕ) :
    IndexedRadicalField p →+* ℂ :=
  Complex.ofRealHom.comp
    (radicalField (indexedPrimeSet p)).val.toRingHom

@[simp]
theorem realComplexEmbedding_apply
    (p : d → ℕ) (x : IndexedRadicalField p) :
    realComplexEmbedding p x = (x : ℝ) :=
  rfl

/-- The fixed degree of the indexed multiquadratic field. -/
def radicalDegree (p : d → ℕ) : ℕ :=
  Module.finrank ℚ (IndexedRadicalField p)

/-- A weighted `ℓ¹` height which bounds every conjugate of the radical
linear form. -/
def radicalConjugateHeight
    (p : d → ℕ) (k : d → ℤ) : ℝ :=
  ∑ i : d, |(k i : ℝ)| * Real.sqrt (p i : ℝ)

theorem radicalConjugateHeight_nonneg
    (p : d → ℕ) (k : d → ℤ) :
    0 ≤ radicalConjugateHeight p k := by
  unfold radicalConjugateHeight
  exact Finset.sum_nonneg fun i _ ↦
    mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)

theorem radicalConjugateHeight_pos
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (k : d → ℤ) (hk : k ≠ 0) :
    0 < radicalConjugateHeight p k := by
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hk
  unfold radicalConjugateHeight
  apply Finset.sum_pos'
  · intro j _
    exact mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)
  · refine ⟨i, Finset.mem_univ i, mul_pos (abs_pos.mpr ?_) ?_⟩
    · exact_mod_cast hi
    · exact Real.sqrt_pos.2 (by
        exact_mod_cast (hp i).pos)

/-- Every complex embedding sends a distinguished square root to a complex
square root of the same positive integer, and hence preserves its norm. -/
theorem norm_embedding_indexedRadicalRoot
    (p : d → ℕ) (i : d)
    (σ : IndexedRadicalField p →+* ℂ) :
    ‖σ (indexedRadicalRoot p i)‖ =
      Real.sqrt (p i : ℝ) := by
  have hsquare :
      (σ (indexedRadicalRoot p i)) ^ 2 = (p i : ℂ) := by
    calc
      (σ (indexedRadicalRoot p i)) ^ 2 =
          σ (indexedRadicalRoot p i ^ 2) := by
            rw [map_pow]
      _ = (p i : ℂ) := by
        rw [indexedRadicalRoot_sq]
        simp
  have hnormSquare :
      ‖σ (indexedRadicalRoot p i)‖ ^ 2 = (p i : ℝ) := by
    calc
      ‖σ (indexedRadicalRoot p i)‖ ^ 2 =
          ‖(σ (indexedRadicalRoot p i)) ^ 2‖ := by
            rw [norm_pow]
      _ = ‖(p i : ℂ)‖ := by rw [hsquare]
      _ = (p i : ℝ) := by simp
  calc
    ‖σ (indexedRadicalRoot p i)‖ =
        Real.sqrt (‖σ (indexedRadicalRoot p i)‖ ^ 2) :=
      (Real.sqrt_sq (norm_nonneg _)).symm
    _ = Real.sqrt (p i : ℝ) := by rw [hnormSquare]

/-- The house of a distinguished radical is its positive real value. -/
theorem house_indexedRadicalRoot
    (p : d → ℕ) (i : d) :
    NumberField.house (indexedRadicalRoot p i) =
      Real.sqrt (p i : ℝ) := by
  rw [NumberField.house_eq_sup']
  have hconstant :
      (fun σ : IndexedRadicalField p →+* ℂ ↦
          ‖σ (indexedRadicalRoot p i)‖₊) =
        fun _ ↦
          Real.toNNReal (Real.sqrt (p i : ℝ)) := by
    funext σ
    apply NNReal.eq
    simp [norm_embedding_indexedRadicalRoot]
  rw [hconstant]
  simp

/-! The following theorem is the analytic content of “every sign
conjugate has size at most the weighted height.” -/
theorem house_radicalLinearCombination_le
    (p : d → ℕ) (k : d → ℤ) :
    NumberField.house (radicalLinearCombination p k) ≤
      radicalConjugateHeight p k := by
  calc
    NumberField.house (radicalLinearCombination p k) =
        NumberField.house
          (∑ i : d, k i • indexedRadicalRoot p i) := rfl
    _ ≤ ∑ i : d,
          NumberField.house
            (k i • indexedRadicalRoot p i) := by
      simpa only [Finset.sum_attach] using
        NumberField.house_sum_le_sum_house
          (Finset.univ : Finset d)
          (fun i ↦ k i • indexedRadicalRoot p i)
    _ ≤ radicalConjugateHeight p k := by
      unfold radicalConjugateHeight
      apply Finset.sum_le_sum
      intro i _
      rw [zsmul_eq_mul]
      calc
        NumberField.house
            ((k i : IndexedRadicalField p) *
              indexedRadicalRoot p i) ≤
            NumberField.house
                (k i : IndexedRadicalField p) *
              NumberField.house
                (indexedRadicalRoot p i) :=
          NumberField.house_mul_le _ _
        _ = |(k i : ℝ)| * Real.sqrt (p i : ℝ) := by
          rw [NumberField.house_intCast,
            house_indexedRadicalRoot]
          exact_mod_cast rfl

/-! ## The quantitative lower bound -/

/-- The number-field norm of a nonzero radical linear form is the image of
a nonzero integer.  Equivalently, its absolute value is at least one.

Mathematically this norm is the product over all sign conjugates of the
multiquadratic field. -/
theorem one_le_norm_algebraNorm_radicalLinearCombination
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (k : d → ℤ) (hk : k ≠ 0) :
    1 ≤
      ‖Algebra.norm ℚ (radicalLinearCombination p k)‖ := by
  let α : IndexedRadicalField p :=
    radicalLinearCombination p k
  have hαIntegral : IsIntegral ℤ α :=
    radicalLinearCombination_isIntegral p k
  let αint : 𝓞 (IndexedRadicalField p) :=
    ⟨α, hαIntegral⟩
  have hαne : α ≠ 0 :=
    radicalLinearCombination_ne_zero p hp hinjective k hk
  have hαintne : αint ≠ 0 := by
    intro hzero
    apply hαne
    exact Subtype.ext_iff.mp hzero
  have hnormInt :
      Algebra.norm ℤ αint ≠ 0 :=
    Algebra.norm_ne_zero_iff.mpr hαintne
  have honeInt :
      (1 : ℤ) ≤ |Algebra.norm ℤ αint| :=
    Int.one_le_abs hnormInt
  change 1 ≤ ‖Algebra.norm ℚ α‖
  have hcoe :
      (αint : IndexedRadicalField p) = α :=
    rfl
  rw [← hcoe, ← Algebra.coe_norm_int]
  rw [← Rat.norm_cast_real, Rat.cast_intCast,
    Real.norm_eq_abs]
  exact_mod_cast honeInt

/-- Conjugate-product inequality before division: the distinguished real
linear form times the product-bound for all other conjugates is at least
one. -/
theorem one_le_abs_radicalSum_mul_height_pow
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (k : d → ℤ) (hk : k ≠ 0) :
    1 ≤
      |∑ i : d, (k i : ℝ) * Real.sqrt (p i : ℝ)| *
        radicalConjugateHeight p k ^
          (radicalDegree p - 1) := by
  let α : IndexedRadicalField p :=
    radicalLinearCombination p k
  let σ : IndexedRadicalField p →+* ℂ :=
    realComplexEmbedding p
  have hnormLower :
      1 ≤ ‖Algebra.norm ℚ α‖ :=
    one_le_norm_algebraNorm_radicalLinearCombination
      p hp hinjective k hk
  have hnormUpper :
      ‖Algebra.norm ℚ α‖ ≤
        ‖σ α‖ *
          NumberField.house α ^
            (Module.finrank ℚ (IndexedRadicalField p) - 1) :=
    NumberField.norm_norm_le_norm_mul_house_pow α σ
  calc
    1 ≤ ‖Algebra.norm ℚ α‖ := hnormLower
    _ ≤ ‖σ α‖ *
          NumberField.house α ^
            (Module.finrank ℚ (IndexedRadicalField p) - 1) :=
      hnormUpper
    _ ≤
        |∑ i : d, (k i : ℝ) * Real.sqrt (p i : ℝ)| *
          radicalConjugateHeight p k ^
            (radicalDegree p - 1) := by
      have hσ :
          ‖σ α‖ =
            |∑ i : d,
              (k i : ℝ) * Real.sqrt (p i : ℝ)| := by
        have hσvalue :
            σ α =
              ((∑ i : d,
                (k i : ℝ) * Real.sqrt (p i : ℝ) : ℝ) : ℂ) := by
          change
            ((radicalLinearCombination p k : ℝ) : ℂ) =
              ((∑ i : d,
                (k i : ℝ) * Real.sqrt (p i : ℝ) : ℝ) : ℂ)
          rw [radicalLinearCombination_coe]
        rw [hσvalue, Complex.norm_real, Real.norm_eq_abs]
      rw [hσ]
      unfold radicalDegree
      gcongr
      · exact NumberField.house_nonneg α
      · exact house_radicalLinearCombination_le p k

/-- **Polynomial radical small-divisor bound.**

For a fixed family of distinct primes, the exponent
`radicalDegree p - 1` and the radical weights are fixed.  Thus the
reciprocal of every nonzero integer linear form grows at most
polynomially in the weighted `ℓ¹` height of its coefficient vector. -/
theorem one_div_height_pow_le_abs_radicalSum
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (k : d → ℤ) (hk : k ≠ 0) :
    1 /
        radicalConjugateHeight p k ^
          (radicalDegree p - 1) ≤
      |∑ i : d, (k i : ℝ) * Real.sqrt (p i : ℝ)| := by
  apply
    (div_le_iff₀
      (pow_pos
        (radicalConjugateHeight_pos p hp k hk)
        (radicalDegree p - 1))).2
  exact one_le_abs_radicalSum_mul_height_pow
    p hp hinjective k hk

/-! ## Signed and commonly scaled clock frequencies -/

/-- Absorbing the clock signs into an integer character. -/
def signedCharacter
    (sign : d → ℤ) (k : d → ℤ) : d → ℤ :=
  fun i ↦ k i * sign i

omit [Fintype d] in
theorem signedCharacter_ne_zero
    (sign : d → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1)
    (k : d → ℤ) (hk : k ≠ 0) :
    signedCharacter sign k ≠ 0 := by
  intro hzero
  apply hk
  funext i
  have hi :
      k i * sign i = 0 := by
    exact congrFun hzero i
  rcases mul_eq_zero.mp hi with hki | hsi
  · exact hki
  · rcases hsign i with hs | hs <;> simp [hs] at hsi

/-- Signs do not change the weighted conjugate height. -/
theorem radicalConjugateHeight_signedCharacter
    (p : d → ℕ)
    (sign : d → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1)
    (k : d → ℤ) :
    radicalConjugateHeight p (signedCharacter sign k) =
      radicalConjugateHeight p k := by
  unfold radicalConjugateHeight signedCharacter
  apply Finset.sum_congr rfl
  intro i _
  have habsSign : |(sign i : ℝ)| = 1 := by
    rcases hsign i with hs | hs <;> simp [hs]
  push_cast
  rw [abs_mul, habsSign, mul_one]

/-- The signed prime-root clock pairing is the radical sum with signs
absorbed into the integer character. -/
theorem frequencyPairing_signedPrimeSqrtFrequency
    (p : d → ℕ) (sign : d → ℤ) (k : d → ℤ) :
    HGAS.Clocks.RadicalClock.frequencyPairing k
        (signedPrimeSqrtFrequency p sign) =
      ∑ i : d,
        (signedCharacter sign k i : ℝ) *
          Real.sqrt (p i : ℝ) := by
  unfold HGAS.Clocks.RadicalClock.frequencyPairing
    signedPrimeSqrtFrequency signedCharacter
  apply Finset.sum_congr rfl
  intro i _
  push_cast
  ring

/-- Polynomial small-divisor bound for signed radical clock frequencies. -/
theorem one_div_height_pow_le_abs_frequencyPairing_signed
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (sign : d → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1)
    (k : d → ℤ) (hk : k ≠ 0) :
    1 /
        radicalConjugateHeight p k ^
          (radicalDegree p - 1) ≤
      |HGAS.Clocks.RadicalClock.frequencyPairing k
        (signedPrimeSqrtFrequency p sign)| := by
  let k' := signedCharacter sign k
  have hk' : k' ≠ 0 :=
    signedCharacter_ne_zero sign hsign k hk
  have h :=
    one_div_height_pow_le_abs_radicalSum
      p hp hinjective k' hk'
  rw [radicalConjugateHeight_signedCharacter
    p sign hsign k] at h
  simpa only [k', frequencyPairing_signedPrimeSqrtFrequency]
    using h

/-- A common nonzero scale multiplies the lower bound by its absolute
value.  This includes the conversion from angular radians to torus turns. -/
theorem abs_scale_div_height_pow_le_abs_frequencyPairing_scaled
    (scale : ℝ)
    (p : d → ℕ)
    (hp : ∀ i : d, (p i).Prime)
    (hinjective : Function.Injective p)
    (sign : d → ℤ)
    (hsign : ∀ i, sign i = 1 ∨ sign i = -1)
    (k : d → ℤ) (hk : k ≠ 0) :
    |scale| /
        radicalConjugateHeight p k ^
          (radicalDegree p - 1) ≤
      |HGAS.Clocks.RadicalClock.frequencyPairing k
        (fun i ↦ scale *
          signedPrimeSqrtFrequency p sign i)| := by
  have h :=
    one_div_height_pow_le_abs_frequencyPairing_signed
      p hp hinjective sign hsign k hk
  have hpair :
      HGAS.Clocks.RadicalClock.frequencyPairing k
          (fun i ↦ scale *
            signedPrimeSqrtFrequency p sign i) =
        scale *
          HGAS.Clocks.RadicalClock.frequencyPairing k
            (signedPrimeSqrtFrequency p sign) := by
    unfold HGAS.Clocks.RadicalClock.frequencyPairing
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hpair, abs_mul]
  simpa only [div_eq_mul_inv, one_mul] using
    mul_le_mul_of_nonneg_left h (abs_nonneg scale)

end HGAS.Clocks.RadicalSmallDivisor
